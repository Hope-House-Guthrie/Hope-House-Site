---
const scenes = ["sunny", "rainy", "hot", "cold", "windy", "night"];
---

<div data-events-weather data-weather="sunny">
  <section class="weather-banner">
    <div class="weather-scene" aria-hidden="true">
      {scenes.map((scene) => <div class={`weather-photo photo-${scene}`} />)}
      <div class="weather-shade"></div>
    </div>
    <div class="weather-heading">
      <p class="mb-4 text-xs font-bold uppercase tracking-widest text-sky-100">Come Together in Guthrie</p>
      <h1 class="text-3xl font-bold text-white sm:text-4xl">Gather, Connect &amp; Find Hope</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-sky-50">Explore events at Hope House Guthrie and opportunities to connect with the community around us.</p>
    </div>
  </section>
  <section class="bg-sky-50 px-4 py-6 sm:px-6" aria-label="Guthrie seven-day forecast">
    <div class="hope-frame hope-frame-accent mx-auto w-full max-w-7xl bg-white p-4 sm:p-5">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-bold text-sky-700">Guthrie · Your Week Ahead</h2>
        <p data-forecast-status role="status" class="text-xs text-slate-600">Loading forecast…</p>
      </div>
      <div class="mt-3 overflow-x-auto pb-1" tabindex="0" aria-label="Scroll through the seven-day forecast">
        <ul data-live-forecast class="grid min-w-[700px] grid-cols-7 gap-2" aria-label="Daily weather forecast"></ul>
      </div>
      <div class="mt-3 flex flex-wrap justify-between gap-2 text-xs text-slate-500">
        <span>Temperatures in °F · High / Low · Chance of precipitation</span>
        <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Weather data by Open-Meteo</a>
      </div>
      <p class="mt-2 text-xs text-slate-500 sm:hidden">Swipe to see all seven days →</p>
      <noscript><p class="mt-3 text-sm text-slate-600">Enable JavaScript to view the forecast.</p></noscript>
    </div>
  </section>
</div>

<style>
  .weather-banner { position: relative; isolation: isolate; overflow: hidden; display: grid; align-items: center; min-height: 430px; padding: 5rem 1.25rem; text-align: center; background: #0c4a6e; }
  .weather-heading { position: relative; z-index: 1; max-width: 48rem; margin: 0 auto; text-shadow: 0 2px 14px rgb(0 0 0 / 65%); }
  .weather-scene { position: absolute; inset: 0; pointer-events: none; }
  .weather-photo { position: absolute; inset: 0; background-size: cover; background-position: center 65%; opacity: 0; }
  .photo-sunny { background-image: url('/weather/sunny.png'); }
  .photo-rainy { background-image: url('/weather/rainy.png'); }
  .photo-hot { background-image: url('/weather/hot.png'); }
  .photo-cold { background-image: url('/weather/cold.png'); }
  .photo-windy { background-image: url('/weather/windy.png'); }
  .photo-night { background-image: url('/weather/night.png'); }
  [data-weather="sunny"] .photo-sunny,
  [data-weather="rainy"] .photo-rainy,
  [data-weather="hot"] .photo-hot,
  [data-weather="cold"] .photo-cold,
  [data-weather="windy"] .photo-windy,
  [data-weather="night"] .photo-night { opacity: 1; }
  .weather-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(2 6 23 / 24%), rgb(2 6 23 / 62%) 35%, rgb(2 6 23 / 62%) 65%, rgb(2 6 23 / 24%)); }
  @media (min-width: 1024px) { .weather-banner { min-height: 480px; padding-block: 7rem; } }
  @media (max-width: 639px) { .weather-photo { background-position: center; } .weather-shade { background: rgb(2 6 23 / 50%); } }
</style>

<script>
  type WeatherData = {
    current?: { temperature_2m: number | null; weather_code: number | null; wind_speed_10m: number | null; is_day: number | null };
    daily?: { time: string[]; weather_code: (number | null)[]; temperature_2m_max: (number | null)[]; temperature_2m_min: (number | null)[]; precipitation_probability_max: (number | null)[] };
  };

  function describeWeather(code: number | null | undefined): [string, string] {
    if (code === 0) return ['☀️', 'Clear'];
    if (code === 1) return ['🌤️', 'Mostly clear'];
    if (code === 2) return ['⛅', 'Partly cloudy'];
    if (code === 3) return ['☁️', 'Overcast'];
    if ([45, 48].includes(code ?? -1)) return ['🌫️', 'Fog'];
    if ([51, 53, 55].includes(code ?? -1)) return ['🌦️', 'Drizzle'];
    if ([56, 57, 66, 67].includes(code ?? -1)) return ['🌧️', 'Freezing rain'];
    if ([61, 63, 65, 80, 81, 82].includes(code ?? -1)) return ['🌧️', 'Rain'];
    if ([71, 73, 75, 77, 85, 86].includes(code ?? -1)) return ['🌨️', 'Snow'];
    if ([95, 96, 99].includes(code ?? -1)) return ['⛈️', 'Thunderstorms'];
    return ['🌡️', 'Unavailable'];
  }

  function temperature(value: number | null | undefined) {
    return typeof value === 'number' && Number.isFinite(value) ? `${Math.round(value)}°` : '—';
  }

  function setupEventsWeather() {
    document.querySelectorAll<HTMLElement>('[data-events-weather]').forEach((root) => {
      if (root.dataset.weatherInitialized) return;
      root.dataset.weatherInitialized = 'true';
      const list = root.querySelector<HTMLElement>('[data-live-forecast]');
      const status = root.querySelector<HTMLElement>('[data-forecast-status]');
      if (!list || !status) return;
      let disposed = false;
      document.addEventListener('astro:before-swap', () => { disposed = true; }, { once: true });

      async function loadWeather() {
        try {
          const params = new URLSearchParams({
            latitude: '35.8789', longitude: '-97.4253',
            current: 'temperature_2m,weather_code,wind_speed_10m,is_day',
            daily: 'weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max',
            temperature_unit: 'fahrenheit', wind_speed_unit: 'mph', timezone: 'America/Chicago', forecast_days: '7',
          });
          const response = await fetch(`https://api.open-meteo.com/v1/forecast?${params}`, { signal: AbortSignal.timeout(15000) });
          if (!response.ok) throw new Error(`Weather request failed: ${response.status}`);
          const data: WeatherData = await response.json();
          if (disposed) return;
          if (data.current) {
            const current = data.current;
            const code = current.weather_code ?? -1;
            const snowy = [71, 73, 75, 77, 85, 86].includes(code);
            const wet = [51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82, 95, 96, 99].includes(code);
            // Rain and snow take priority; thresholds use Fahrenheit and mph.
            root.dataset.weather = snowy ? 'cold' : wet ? 'rainy'
              : current.is_day === 0 ? 'night'
              : typeof current.wind_speed_10m === 'number' && current.wind_speed_10m >= 20 ? 'windy'
              : typeof current.temperature_2m === 'number' && current.temperature_2m >= 90 ? 'hot'
              : typeof current.temperature_2m === 'number' && current.temperature_2m <= 40 ? 'cold' : 'sunny';
          }
          const daily = data.daily;
          if (!daily || daily.time?.length !== 7 || ![daily.weather_code, daily.temperature_2m_max, daily.temperature_2m_min, daily.precipitation_probability_max].every((values) => Array.isArray(values) && values.length === 7)) throw new Error('Incomplete forecast');
          const cards = daily.time.map((date, index) => {
            const [icon, description] = describeWeather(daily.weather_code[index]);
            const day = new Date(`${date}T12:00:00Z`);
            const weekday = index === 0 ? 'Today' : day.toLocaleDateString('en-US', { weekday: 'short', timeZone: 'UTC' });
            const dateLabel = day.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
            const chance = daily.precipitation_probability_max[index];
            const precipitation = typeof chance === 'number' && Number.isFinite(chance) ? `${Math.round(chance)}%` : '—';
            const card = document.createElement('li');
            card.className = 'min-w-0 rounded-xl border border-sky-100 bg-sky-50 px-2 py-3 text-center';
            card.innerHTML = `
              <p class="text-sm font-bold text-sky-800">${weekday}</p>
              <p class="mt-1 text-xs text-slate-500">${dateLabel}</p>
              <span class="my-2 block text-3xl" aria-hidden="true">${icon}</span>
              <p class="min-h-8 text-xs leading-4 text-slate-600">${description}</p>
              <p class="mt-2 text-sm"><span class="font-bold text-slate-800">${temperature(daily.temperature_2m_max[index])}</span><span class="text-slate-500"> / ${temperature(daily.temperature_2m_min[index])}</span></p>
              <p class="mt-2 text-xs font-semibold text-sky-700"><span aria-hidden="true">💧</span><span class="sr-only">Chance of precipitation:</span> ${precipitation}</p>`;
            return card;
          });
          list!.replaceChildren(...cards);
          status!.textContent = `Loaded ${new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago', timeZoneName: 'short' })}`;
        } catch (error) {
          if (disposed) return;
          status!.textContent = 'Forecast unavailable. Please refresh to try again.';
          console.error('Unable to load Guthrie weather:', error);
        }
      }
      void loadWeather();
    });
  }
  setupEventsWeather();
  document.addEventListener('astro:page-load', setupEventsWeather);
</script>
