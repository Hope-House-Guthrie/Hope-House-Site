---
import TextInput from "./lib/TextInput.astro";
import PhoneInput from "./lib/PhoneInput.astro";
import SelectInput from "./lib/SelectInput.astro";

interface Opportunity {
  title: string;
}

interface Props {
  opportunities?: Opportunity[];
}

const { opportunities = [] } = Astro.props;
---
<section
  id="volunteer-interest"
  class="scroll-mt-56 lg:scroll-mt-28 bg-sky-50 py-12 sm:py-16"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-sky-700">Volunteer Interest Form</h2>
    <p class="mt-3 mb-8 text-slate-700 leading-relaxed">
      Tell us a little about yourself and how you would like to help.
    </p>

    <form
      class="rounded-xl border border-sky-200 bg-white p-5 sm:p-8 shadow-sm"
      action="/_form/volunteer-inquiry"
      method="POST"
    >
      <input type="hidden" name="success_url" value="/success/volunteer-inquiry" />

      <p class="hope-help-text mb-6">
        Fields marked with * are required.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <TextInput
          id="volunteer-first-name"
          name="firstName"
          label="First Name"
          autocomplete="given-name"
          required={true}
          maxlength={100}
        />

        <TextInput
          id="volunteer-last-name"
          name="lastName"
          label="Last Name"
          autocomplete="family-name"
          required={true}
          maxlength={100}
        />

        <TextInput
          id="volunteer-email"
          name="email"
          label="Email Address"
          type="email"
          autocomplete="email"
          required={true}
        />

        <PhoneInput
          id="volunteer-phone"
          name="phone"
          label="Phone Number"
        />

        <div class="sm:col-span-2">
          <SelectInput
            id="volunteer-type"
            name="volunteerType"
            label="Volunteering As"
            required={true}
            options={[
              { value: "individual", label: "Individual" },
              { value: "group", label: "Group or organization" },
            ]}
          />
        </div>

        <div class="sm:col-span-2">
          <TextInput
            id="volunteer-group"
            name="organization"
            label="Group or Organization Name"
            autocomplete="organization"
            maxlength={150}
          />
        </div>
      </div>

      <fieldset class="mt-7">
        <legend class="font-semibold text-slate-900">
          Areas of Interest
        </legend>
        <p class="hope-help-text mt-1 mb-3">Check all that apply.</p>
        <div class="space-y-2">
          {
            opportunities.map((opportunity) => (
              <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 px-3 py-3 hover:bg-sky-50/50 transition-colors">
                <input
                  type="checkbox"
                  name="interests"
                  value={opportunity.title}
                  class="mt-0.5 h-5 w-5 shrink-0 accent-sky-700 checkbox checkbox-primary"
                />
                <span class="text-base text-slate-700">
                  {opportunity.title}
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="mt-6">
        <label for="volunteer-availability" class="hope-label">
          Availability
        </label>
        <textarea
          id="volunteer-availability"
          name="availability"
          rows="3"
          maxlength="1000"
          placeholder="Days, times, or how often you would like to help"
          class="hope-input"
        ></textarea>
      </div>

      <div class="mt-6">
        <label for="volunteer-message" class="hope-label">
          Skills, Group Size, or Questions
        </label>
        <textarea
          id="volunteer-message"
          name="message"
          rows="4"
          maxlength="2000"
          class="hope-input"
        ></textarea>
      </div>

      <button
        type="submit"
        class="mt-6 w-full rounded-lg bg-emerald-600 px-5 py-3.5 font-bold text-white hover:bg-emerald-700 transition-colors"
      >
        Submit Volunteer Interest
      </button>
    </form>
  </div>
</section>