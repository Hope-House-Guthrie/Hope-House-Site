---
// src/components/forms/lib/SelectInput.astro
interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name: string;
  label: string;
  options: Option[];
  value?: string;
  required?: boolean;
  class?: string;
}

const {
  id,
  name,
  label,
  options = [],
  value = "",
  required = false,
  class: className = "",
} = Astro.props;
---

<div class={className}>
  <label for={id} class="hope-label">
    {label} {required && "*"}
  </label>
  <select
    id={id}
    name={name}
    required={required}
    class="hope-input select select-bordered w-full"
  >
    <option value="">Select an option</option>
    {options.map((opt) => (
      <option value={opt.value} selected={opt.value === value}>
        {opt.label}
      </option>
    ))}
  </select>
</div>