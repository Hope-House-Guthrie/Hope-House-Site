---
import TextInput from "./lib/TextInput.astro";
import PhoneInput from "./lib/PhoneInput.astro";
---
<section class="bg-white pb-8 pt-4 sm:pb-10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="hope-frame hope-frame-accent bg-sky-50 p-6 sm:p-8 rounded-xl border border-sky-200">
      <div class="text-center">
        <h2
          id="partner-inquiry-title"
          class="text-2xl font-bold text-sky-700"
        >
          Help Us Keep Hope Moving Forward
        </h2>

        <p class="mx-auto mt-3 max-w-2xl leading-relaxed text-slate-700">
          Interested in partnering with or supporting Hope House Guthrie? Tell
          us a little about yourself and how you would like to help.
        </p>
      </div>

      <form
        id="partner-inquiry-form"
        action="/_form/partner-inquiry"
        method="POST"
        aria-labelledby="partner-inquiry-title"
        class="mx-auto mt-8 max-w-3xl space-y-6 text-left"
      >
        <input type="hidden" name="success_url" value="/success/partner-inquiry" />

        <div class="grid gap-5 sm:grid-cols-2">
          <TextInput
            id="partner-name"
            name="contact_name"
            label="Contact name"
            autocomplete="name"
            required={true}
            class="min-h-11"
          />

          <TextInput
            id="partner-organization"
            name="organization"
            label="Business or organization"
            autocomplete="organization"
            class="min-h-11"
          />

          <TextInput
            id="partner-email"
            name="email"
            label="Email"
            type="email"
            autocomplete="email"
            required={true}
            class="min-h-11"
          />

          <PhoneInput
            id="partner-phone"
            name="phone"
            label="Phone"
            required={true}
            class="min-h-11"
          />
        </div>

        <fieldset>
          <legend class="font-semibold text-slate-900 mb-2">
            How would you like to help?
          </legend>
          <p class="hope-help-text mt-1 text-sm">Select all that apply.</p>

          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {
              [
                "Financial support",
                "Goods or supplies",
                "Services or discounts",
                "Community partnership",
                "Other / I’d like to discuss ideas",
              ].map((option) => (
                <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-lg border border-sky-200 bg-white px-4 py-3 text-slate-700 hover:bg-sky-50/50 transition-colors">
                  <input
                    type="checkbox"
                    name="support_interests"
                    value={option}
                    class="h-5 w-5 shrink-0 accent-sky-700 checkbox checkbox-primary"
                  />
                  <span>{option}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div>
          <label for="partner-message" class="hope-label">
            Tell us about your idea
            <span class="ml-1 text-sky-700 font-normal">(required)</span>
          </label>
          <textarea
            id="partner-message"
            name="message"
            rows="5"
            required
            placeholder="What would you like to offer, or explore with our team?"
            class="hope-input mt-2"
          ></textarea>
        </div>

        <div class="text-center">
          <button
            type="submit"
            class="hope-action inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-sky-700 px-6 py-3 font-semibold text-white sm:w-auto hover:bg-sky-800 transition-colors"
          >
            Send Inquiry
          </button>
        </div>
      </form>
    </div>
  </div>
</section>