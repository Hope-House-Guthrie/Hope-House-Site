---
import TextInput from "./lib/TextInput.astro";
import PhoneInput from "./lib/PhoneInput.astro";
import SelectInput from "./lib/SelectInput.astro";
---
<section
  id="new-client-inquiry"
  class="scroll-mt-64 bg-sky-50 py-16 md:scroll-mt-40"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8">
      <h2 class="text-3xl font-bold text-sky-700">New Client Inquiry</h2>

      <div
        class="w-full h-1 bg-sky-700 rounded-full mt-4 mb-5"
        aria-hidden="true"
      ></div>

      <p class="text-slate-700 leading-relaxed">
        Interested in staying at Hope House Guthrie? Complete this inquiry so
        our team can contact you about bed availability and next steps.
      </p>

      <p class="mt-3 text-sm text-slate-600">
        Submitting an inquiry does not reserve a bed or guarantee placement.
      </p>
    </div>

    <form
      class="hope-frame hope-frame-accent bg-white p-6 sm:p-8 shadow-sm rounded-xl border border-sky-200"
      action="/_form/client-inquiry"
      method="POST"
    >
      <input type="hidden" name="success_url" value="/success/client-inquiry" />
      
      <div
        class="mb-6 rounded-lg border border-sky-200 bg-white p-4 sm:p-5 text-sm sm:text-base leading-relaxed text-slate-700"
      >
        <p>
          <strong class="text-slate-900">Please note: </strong>
          Hope House Guthrie provides shelter and community support. We are not
          a medical facility and do not provide on-site medical or nursing care.
          If you need assistance that requires medical personnel, please discuss
          those needs with our intake team so we can determine whether our services
          can meet your needs.
        </p>
      </div>

      <p class="hope-help-text mb-6">
        Fields marked with * are required.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="sm:col-span-2">
          <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1fr_140px] gap-4"
          >
            <TextInput
              id="inquiry-first-name"
              name="firstName"
              label="First Name"
              autocomplete="given-name"
              maxlength={100}
              required={true}
            />

            <TextInput
              id="inquiry-middle-name"
              name="middleName"
              label="Middle Name"
              autocomplete="additional-name"
              maxlength={100}
            />

            <TextInput
              id="inquiry-last-name"
              name="lastName"
              label="Last Name"
              autocomplete="family-name"
              maxlength={100}
              required={true}
            />

            <SelectInput
              id="inquiry-suffix"
              name="suffix"
              label="Suffix"
              options={[
                { value: "Jr.", label: "Jr." },
                { value: "Sr.", label: "Sr." },
                { value: "I", label: "I" },
                { value: "II", label: "II" },
                { value: "III", label: "III" },
                { value: "IV", label: "IV" },
                { value: "V", label: "V" },
                { value: "VI", label: "VI" },
              ]}
            />
          </div>
        </div>

        <div class="sm:col-span-2">
          <TextInput
            id="inquiry-dob"
            name="dateOfBirth"
            label="Date of Birth"
            type="date"
            autocomplete="bday"
            required={true}
          />
        </div>

        <PhoneInput
          id="inquiry-phone"
          name="phone"
          label="Phone Number"
        />

        <TextInput
          id="inquiry-email"
          name="email"
          label="Email Address"
          type="email"
          autocomplete="email"
        />

        <div class="sm:col-span-2">
          <p class="hope-help-text">
            Please provide a phone number or email address where we can reach
            you.
          </p>
        </div>

        <SelectInput
          id="inquiry-contact"
          name="contactMethod"
          label="Preferred Contact Method"
          required={true}
          options={[
            { value: "call", label: "Phone call" },
            { value: "text", label: "Text message" },
            { value: "email", label: "Email" },
          ]}
        />

        <SelectInput
          id="inquiry-household"
          name="householdType"
          label="Who Needs Shelter?"
          required={true}
          options={[
            { value: "individual", label: "An individual" },
            { value: "family", label: "A family" },
          ]}
        />

        <div class="sm:col-span-2">
          <p class="hope-help-text mb-2">
            Each adult seeking shelter must complete a separate inquiry. Include
            any children accompanying you in your inquiry.
          </p>
        </div>

        <TextInput
          id="inquiry-children"
          name="children"
          label="Number of Children"
          type="number"
          min={0}
          step={1}
          value="0"
          required={true}
        />

        <div class="sm:col-span-2">
          <SelectInput
            id="inquiry-timing"
            name="shelterTiming"
            label="When Do You Need Shelter?"
            required={true}
            options={[
              { value: "today", label: "Today" },
              { value: "this-week", label: "Within the next week" },
              { value: "later", label: "Later" },
              { value: "unsure", label: "Not sure yet" },
            ]}
          />
        </div>

        <div class="sm:col-span-2">
          <SelectInput
            id="inquiry-vaccinations"
            name="vaccinationWillingness"
            label="Are you willing to receive COVID-19 and flu vaccinations?"
            required={true}
            options={[
              { value: "yes", label: "Yes" },
              { value: "no", label: "No" },
              { value: "discuss", label: "Would like to discuss with staff" },
            ]}
          />
        </div>

        <div class="sm:col-span-2">
          <label for="inquiry-message" class="hope-label">
            Anything Else You Would Like Us to Know?
          </label>
          <textarea
            id="inquiry-message"
            name="message"
            rows="4"
            maxlength="2000"
            aria-describedby="inquiry-message-help"
            class="hope-input"
          ></textarea>
          <p id="inquiry-message-help" class="mt-2 text-sm text-slate-500">
            Please do not include Social Security numbers or detailed medical
            information.
          </p>
        </div>
      </div>

      <button
        type="submit"
        class="mt-6 w-full rounded-lg bg-emerald-600 px-6 py-3.5 font-bold text-white opacity-50 cursor-not-allowed hover:bg-emerald-700 transition-colors"
      >
        Submit Inquiry
      </button>
    </form>

    <dialog
      id="inquiry-confirmation"
      aria-labelledby="inquiry-confirmation-title"
      aria-describedby="inquiry-confirmation-message"
      class="hope-frame hope-frame-accent m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-lg overflow-y-auto bg-white p-6 text-slate-700 backdrop:bg-slate-900/60 sm:p-8 rounded-xl shadow-xl"
    >
      <h2
        id="inquiry-confirmation-title"
        class="mb-4 text-2xl font-bold text-sky-700"
      >
        Thank You for Your Inquiry
      </h2>

      <div
        id="inquiry-confirmation-message"
        class="space-y-4 text-base leading-relaxed"
      >
        <p>
          Your inquiry has been received, and our administration team will be
          notified.
        </p>
        <p>
          If a bed is available and you meet our placement requirements,
          including background checks, someone from our team will contact you.
        </p>
        <p>
          Submitting an inquiry does not guarantee placement. If you have not
          heard from us, a bed may not be available. Please check back later
          by submitting another inquiry or calling:
        </p>
        <a
          href="tel:4058569058"
          class="block text-center text-lg font-bold text-sky-700 hover:underline"
        >
          (405) 856-9058
        </a>
      </div>

      <form method="dialog" class="mt-6">
        <button
          type="submit"
          autofocus
          class="w-full rounded-lg bg-sky-700 px-6 py-3 font-bold text-white transition-colors hover:bg-sky-800"
        >
          Got It
        </button>
      </form>
    </dialog>
  </div>
</section>