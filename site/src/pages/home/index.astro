---
import Layout from "@/layouts/main/index.astro";
import { getImage } from "astro:assets";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import aerialImage from "@/assets/new-aerial.jpeg";

import Card from "./lib/Card.astro";
import CardsList from "./lib/CardsList.astro";
import PageSection from "./lib/PageSection.astro";

import Hero from "./lib/Hero.astro";

const optimizedAerialImage = await getImage({
  src: aerialImage,
  format: "webp",
  quality: 60,
});

const partners = await getCollection("partners");
const spotlights = (await getCollection("spotlights")).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
---

<Layout title="Home">
  <Hero optimizedAerialImage={optimizedAerialImage} />

  <PageSection
    title="Serving Hope & Moving Forward"
    subtitle="We advocate for every person who comes through our doors, offering short-term shelter, long-term stabilization, and community care."
  >
    <CardsList variant="columns-3">
      <Card>
        <figure class="bg-sky-100" aria-hidden="true">🍲</figure>

        <h3>Community Lunch &amp; Walk-In Services</h3>

        <p>
          Serving daily hot lunches from 11:00 AM – 1:00 PM. Walk-in services
          include showers, clothing, and hygiene toiletries until 5:00 PM.
        </p>

        <a href="/programs#soup-kitchen"> Learn More &rarr; </a>
      </Card>
      <Card>
        <figure class="bg-amber-100" aria-hidden="true">🏠</figure>

        <h3>Transitional Housing</h3>

        <p>
          Transitional housing with structured support to help individuals work
          toward stability, independence, and their next step forward.
        </p>

        <a href="/programs#housing"> Learn More &rarr; </a>
      </Card>
      <Card>
        <figure class="bg-emerald-100" aria-hidden="true">🌱</figure>

        <h3>Recovery &amp; Support</h3>

        <p>
          Narcotics Anonymous (NA) meetings, recovery support, job transition,
          budgeting, and connections to community resources.
        </p>

        <a href="/programs#recovery"> Learn More &rarr; </a>
      </Card>
    </CardsList>
  </PageSection>

  <PageSection
    title="Our Impact"
    subtitle="Meals, essential resources, and hope for our community."
  >
    <CardsList variant="columns-2">
      <Card>
        <figure class="bg-sky-100" aria-hidden="true">🍲</figure>

        <h3>Meals Served</h3>

        <p>Community meal totals coming soon</p>
      </Card>
      <Card>
        <figure class="bg-amber-100" aria-hidden="true">📦</figure>

        <h3>Food Boxes Distributed</h3>

        <p>Food distribution totals coming soon</p>
      </Card>
    </CardsList>
  </PageSection>

  <PageSection
    title="Community Partners & Supporters"
    subtitle="Working together to connect our community with food, resources, recovery support, and opportunities."
  >
    <CardsList variant="columns-3">
      {
        partners.map(({ data: item }) => (
          <Card>
            <a
              class="flex items-center justify-center w-full h-44"
              href={item.url}
              target="_blank"
              aria-label={`${item.name} website (opens in a new tab)`}
            >
              <Image
                class="max-h-full max-w-full w-auto h-auto object-contain"
                src={item.logo}
                alt={item.name}
                width={320}
                loading="lazy"
              />
            </a>
          </Card>
        ))
      }
    </CardsList>
  </PageSection>

  <PageSection
    title="Hope House Spotlight"
    subtitle="Celebrating our community, our partners, and hope in action."
  >
    <CardsList variant="columns-3">
      {
        spotlights.map(({ id, data }) => (
          <div class="flex flex-col gap-3">
            <h3 class="font-semibold text-lg text-center text-sky-700">
              {data.url ? (
                <a
                  href={data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-sky-600 transition-colors"
                  aria-label={`${data.title} (opens in a new tab)`}
                >
                  {data.title}
                </a>
              ) : (
                data.title
              )}
            </h3>

            <Card>
              <a
                href={data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full group focus:outline-none"
                aria-label={`${data.title} (opens in a new tab)`}
              >
                <div class="overflow-hidden rounded-md">
                  <Image
                    class="w-full h-48 object-cover object-top"
                    src={data.image}
                    alt={data.title}
                    width={600}
                    format="webp"
                    loading="lazy"
                  />
                </div>
              </a>
            </Card>

            <button
              type="button"
              class="flex items-center text-center gap-1.5 text-sm text-gray-600 hover:text-sky-700 cursor-pointer self-center focus:outline-none"
              onclick={`document.getElementById('dialog-${id}').showModal()`}
              aria-label={`Enlarge image: ${data.title}`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"
                />
              </svg>
              <span>Click to enlarge</span>
            </button>

            <dialog
              id={`dialog-${id}`}
              class="m-auto p-0 rounded-lg backdrop:bg-black/60 max-w-4xl w-[90%] shadow-2xl bg-white border-0"
            >
              <div class="relative p-6">
                <form method="dialog">
                  <button
                    type="submit"
                    class="absolute top-4 right-4 z-10 w-9 h-9 flex items-center justify-center rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 text-xl font-bold cursor-pointer"
                    aria-label="Close dialog"
                  >
                    &times;
                  </button>
                </form>

                <div class="flex flex-col items-center">
                  <h3 class="my-4 font-semibold text-lg text-center text-sky-700">
                    {data.title}
                  </h3>
                  <Image
                    class="w-full h-auto max-h-[75vh] object-contain rounded"
                    src={data.image}
                    alt={data.title}
                    width={1200}
                    format="webp"
                  />
                </div>
              </div>
            </dialog>
          </div>
        ))
      }
    </CardsList>
  </PageSection>
</Layout>
