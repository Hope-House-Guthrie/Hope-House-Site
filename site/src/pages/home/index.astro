---
import Layout from "@/layouts/main/index.astro";
import { getImage } from "astro:assets";
import aerialImage from "@/assets/new-aerial.jpeg";

import Hero from "./lib/Hero.astro";
import Services from "./lib/Services.astro";
import Spotlight from "./lib/Spotlight.astro";
import Impact from "./lib/Impact.astro";
import Partners from "./lib/Partners.astro";

const optimizedAerialImage = await getImage({
  src: aerialImage,
  format: "webp",
  quality: 60,
});
---

<Layout title="Home">
  <Hero optimizedAerialImage={optimizedAerialImage} />
  <Services />
  <Spotlight />
  <Impact />
  <Partners />
</Layout>