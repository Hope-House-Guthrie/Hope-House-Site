---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const spotlights = await getCollection("spotlights");
---

<section
  class="py-12 sm:py-16"
  aria-labelledby="spotlight-title"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 text-center">
      <h2 id="spotlight-title" class="text-3xl font-bold text-sky-700">
        Hope House Spotlight
      </h2>

      <div
        class="mx-auto mt-4 h-1 w-full rounded-full bg-sky-700"
        aria-hidden="true"
      >
      </div>

      <p class="mx-auto mt-4 max-w-2xl text-slate-600">
        Celebrating our community, our partners, and hope in action.
      </p>
    </div>

    <div
      id="hope-spotlight1"
      class1="mx-auto max-w-3xl overflow-hidden rounded-2xl border border-sky-200 border-t-4 border-t-sky-500 bg-white shadow-xl shadow-sky-900/10"
      role="region"
      aria-roledescription="carousel"
      aria-label="Hope House community spotlights"
    >
      <div data-slides class="p-3 sm:p-6">
        {
          spotlights.map(({ data: item }, index) => (
            <article
              data-slide
              hidden={index !== 0}
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${spotlights.length}: ${item.title}`}
            >
              <Image
                  src={item.image}
                  alt={item.title}
                  width={1000}
                  format="webp"
                  quality={85}
                  loading="lazy"
                  class="mx-auto w-full object-contain"
                />

              <h3 class="mt-5 text-center text-lg font-bold text-slate-900">
                {item.title}
              </h3>

              <p class="mt-1 text-center text-sm text-slate-500">
                Tap or click the flyer to enlarge
              </p>
            </article>
          ))
        }
      </div>

      <div
        class="flex flex-col items-center gap-2 border-t border-sky-100 bg-sky-50 px-4 py-4"
      >
        <span
          data-counter
          class="text-center text-xs font-semibold tracking-wider text-slate-500"
        >
          1 / {spotlights.length}
        </span>

        <div class="flex items-center justify-center gap-3">
          <button
            type="button"
            data-previous
            aria-label="Previous spotlight"
            class="flex h-11 w-11 items-center justify-center rounded-full bg-sky-700 text-white shadow-md transition hover:bg-sky-800 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-sky-700"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 12H5m7 7-7-7 7-7"></path>
            </svg>
          </button>

          <button
            type="button"
            data-play
            aria-label="Pause spotlight rotation"
            class="flex h-11 w-11 items-center justify-center rounded-full text-sky-700 transition hover:bg-sky-100 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-sky-700"
          >
            <svg
              data-pause-icon
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M6 5h4v14H6zm8 0h4v14h-4z"></path>
            </svg>

            <svg
              data-play-icon
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="m8 5 11 7-11 7z"></path>
            </svg>
          </button>

          <button
            type="button"
            data-next
            aria-label="Next spotlight"
            class="flex h-11 w-11 items-center justify-center rounded-full bg-sky-700 text-white shadow-md transition hover:bg-sky-800 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-sky-700"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14m-7-7 7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </div>

      <p data-announcement class="sr-only" aria-live="polite"></p>
    </div>
  </div>

  <dialog
    id="spotlight-enlarged"
    aria-label="Enlarged spotlight flyer"
    class="m-auto max-h-[92dvh] w-[92vw] max-w-4xl overflow-y-auto rounded-xl bg-white p-3 shadow-xl backdrop:bg-slate-900/70 sm:p-5"
  >
    <form method="dialog" class="mb-3 flex justify-end">
      <button
        type="submit"
        autofocus
        class="min-h-11 rounded-lg bg-sky-700 px-5 py-2 font-semibold text-white hover:bg-sky-800"
      >
        Close ✕
      </button>
    </form>

    <img data-full-image alt="" class="h-auto w-full" />
  </dialog>
</section>

<style>
  [data-slide][hidden],
  [data-pause-icon][hidden],
  [data-play-icon][hidden] {
    display: none !important;
  }

  /* Raised outer frame */
  #hope-spotlight {
    border: 1px solid #bae6fd;
    border-top: 4px solid #0369a1;
    background: #ffffff;
    box-shadow:
      0 2px 0 #7dd3fc,
      0 8px 0 -3px #d0e8f5,
      0 22px 40px -12px rgb(12 74 110 / 30%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
  }

  /* Soft lighting behind the flyer */
  #hope-spotlight [data-slides] {
    background: radial-gradient(
      ellipse at top,
      #ffffff 20%,
      #f0f9ff 75%,
      #e0f2fe 100%
    );
  }

  /* Shadow follows the flyer's actual edges */
  #hope-spotlight [data-enlarge] img {
    filter: drop-shadow(0 10px 12px rgb(15 23 42 / 20%));
    transition:
      transform 220ms ease,
      filter 220ms ease;
  }

  /* Slight lift when using a mouse */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    #hope-spotlight [data-enlarge]:hover img {
      transform: translateY(-3px);
      filter: drop-shadow(0 15px 16px rgb(15 23 42 / 25%));
    }
  }

  /* Raised arrow buttons */
  #hope-spotlight [data-previous],
  #hope-spotlight [data-next] {
    background: linear-gradient(to bottom, #0284c7, #0369a1);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 30%),
      0 3px 0 #075985,
      0 5px 8px rgb(12 74 110 / 20%);
  }

  #hope-spotlight [data-previous]:active,
  #hope-spotlight [data-next]:active {
    transform: translateY(2px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 20%),
      0 1px 0 #075985;
  }
</style>

<script>
  import { initSpotlight } from "./index";

  initSpotlight();
</script>