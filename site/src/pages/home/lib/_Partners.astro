---
import Card from "@/lib/Card.astro";
import CardsList from "@/lib/CardsList.astro";
import PageSection from "@/lib/PageSection.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const partners = await getCollection("partners");
---

<PageSection
  title="Community Partners & Supporters"
  subtitle="Working together to connect our community with food, resources, recovery support, and opportunities."
  variant="alternate"
>
  <CardsList variant="columns-3">
    {
      partners.map(({ data: item }) => (
        <Card>
          <a
            class="flex items-center justify-center w-full h-44"
            href={item.url}
            target="_blank"
            aria-label={`${item.name} website (opens in a new tab)`}
          >
            <Image
              class="max-h-full max-w-full w-auto h-auto object-contain"
              src={item.logo}
              alt={item.name}
              width={320}
              loading="lazy"
            />
          </a>
        </Card>
      ))
    }
  </CardsList>

  <div class="w-full mt-20 text-center">
    <h2 class="text-2xl font-bold text-sky-700">
      Hope Grows Through Community
    </h2>
    <div class="mx-auto mt-3 max-w-2xl leading-relaxed text-slate-700">
      <p>
        Thank you to the partners and supporters who help us serve hope and move
        forward.
      </p>
      <p>Interested in becoming a Hope House partner or sponsor?</p>
    </div>
    <a
      href="/partners"
      class="hope-action mt-5 inline-flex min-h-11 items-center justify-center rounded-lg bg-sky-700 px-6 py-3 font-semibold text-white hover:bg-sky-800 focus-visible:outline focus-visible:outline-offset-4 focus-visible:outline-sky-700"
    >
      Contact Us
    </a>
  </div>
</PageSection>
