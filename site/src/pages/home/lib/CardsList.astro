---
export type Variant = "columns-1" | "columns-2" | "columns-3";

export interface Props {
    variant: Variant;
}
---
<ul class=`${Astro.props.variant} grid gap-8` role="list">
    <slot />
</ul>

<style>
    @reference "../../../styles/main.css";
    
    ul {
        @apply grid-cols-1;

        &.columns-2 {
            @apply md:grid-cols-2;
        }

        &.columns-3 {
            @apply md:grid-cols-3;
        }
    }
</style>