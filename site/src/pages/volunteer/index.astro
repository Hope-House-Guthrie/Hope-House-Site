---
import { getCollection } from "astro:content";
import Layout from "@/layouts/main/index.astro";
import PageHeader from "@/lib/PageHeader.astro";
import VolunteerInquiryForm from "@/forms/VolunteerInquiryForm.astro";
import VolunteerOpportunitiesList from "./lib/VolunteerOpportunitiesList.astro";
import VolunteerSidebar from "./lib/VolunteerSidebar.astro";

const volunteerOpportunities = await getCollection("volunteerOpportunities");
---

<Layout title="Volunteer">
  <PageHeader
    title="Volunteer at Hope House Guthrie"
    description="Help us serve hope and move forward. Your time, care, and skills can support people working toward stability and independence."
  />

  <section class="bg-white py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-1 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-8 lg:gap-10"
      >
        <VolunteerOpportunitiesList opportunities={volunteerOpportunities} />
        <VolunteerSidebar />
      </div>
    </div>
  </section>

  <VolunteerInquiryForm opportunities={volunteerOpportunities.map(x => x.data)} />
</Layout>