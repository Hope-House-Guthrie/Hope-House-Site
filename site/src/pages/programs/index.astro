---
import { getCollection } from "astro:content";

import Layout from "@/layouts/main/index.astro";
import PageHeader from "@/lib/PageHeader.astro";
import Lunch from "./lib/Lunch.astro";
import WalkInServices from "./lib/WalkInServices.astro";
import ResidentialPrograms from "./lib/ResidentialPrograms.astro";
import RecoverySupport from "./lib/RecoverySupport.astro";

import "./index.css";

const walkInServices = await getCollection("walkInServices");
const residentialPrograms = await getCollection("residentialPrograms");
---

<Layout title="Programs & Services">
  <PageHeader
    title="Programs & Services"
    description="Providing direct relief and long-term support to break cycles of crisis and addiction."
  />

  <Lunch />
  <WalkInServices services={walkInServices} />
  <ResidentialPrograms programs={residentialPrograms} />
  <RecoverySupport />
</Layout>