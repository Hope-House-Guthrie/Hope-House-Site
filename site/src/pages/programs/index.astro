---
import { getCollection } from "astro:content";

import Layout from "@/layouts/main/index.astro";
import PageHeader from "@/lib/PageHeader.astro";
import SectionHeading from "@/lib/SectionHeading.astro";

import "./index.css";

const walkInServices = await getCollection("walkInServices");
const residentialPrograms = await getCollection("residentialPrograms");
---

<Layout title="Programs & Services">
  <PageHeader
    title="Programs & Services"
    description="Providing direct relief and long-term support to break cycles of crisis and addiction."
  />

  <!-- Community Lunch -->
  <section
    id="soup-kitchen"
    class="scroll-mt-64 bg-white py-12 sm:py-16 md:scroll-mt-40"
    aria-labelledby="lunch-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-start gap-6 md:grid-cols-3 md:gap-12">
        <SectionHeading
          tag="Direct Food Relief"
          title="Lou’s — Lunch on Us"
          id="lunch-title"
          titleClass="text-2xl font-bold text-slate-900"
          centered={false}
          class="mb-0"
        />

        <div class="space-y-4 leading-relaxed text-slate-600 md:col-span-2">
          <p>
            Hope House serves lunch{" "}
            <strong class="text-slate-900">
              seven days a week from 11:00 AM–1:00 PM
            </strong>{" "}
            at our facility at 1916 E. Perkins Ave. Community members in need are
            welcome.
          </p>

          <p>
            Our food program is supported through community partnerships and
            regular food pickups, including God's Food Bank, the Regional Food
            Bank, and Reasor's, helping us provide meals and food assistance to
            people in our community.
          </p>

          <div class="hope-frame hope-frame-accent bg-sky-50 p-6 sm:p-8">
            <div
              class="flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-7"
            >
              <div
                class="flex h-28 w-28 shrink-0 items-center justify-center self-center rounded-full bg-sky-100"
                aria-hidden="true"
              >
                <svg viewBox="0 0 120 120" class="h-24 w-24" fill="none">
                  <path
                    class="lunch-steam"
                    d="M43 43C33 33 51 28 43 17"
                    stroke="#0284c7"
                    stroke-width="4"
                    stroke-linecap="round"></path>

                  <path
                    class="lunch-steam lunch-steam-two"
                    d="M60 40C50 30 68 25 60 14"
                    stroke="#0284c7"
                    stroke-width="4"
                    stroke-linecap="round"></path>

                  <path
                    class="lunch-steam lunch-steam-three"
                    d="M77 43C67 33 85 28 77 17"
                    stroke="#0284c7"
                    stroke-width="4"
                    stroke-linecap="round"></path>

                  <ellipse cx="60" cy="98" rx="38" ry="5" fill="#bae6fd"
                  ></ellipse>

                  <path
                    d="M24 59H96C93 81 80 94 60 94S27 81 24 59Z"
                    fill="#0369a1"></path>

                  <path
                    d="M32 67C35 78 41 84 49 87"
                    stroke="#38bdf8"
                    stroke-width="4"
                    stroke-linecap="round"></path>

                  <ellipse cx="60" cy="59" rx="37" ry="10" fill="#7dd3fc"
                  ></ellipse>

                  <ellipse cx="60" cy="58" rx="30" ry="6" fill="#fbbf24"
                  ></ellipse>

                  <path
                    d="M44 57L49 59M62 55L67 57M74 59L78 57"
                    stroke="#d97706"
                    stroke-width="3"
                    stroke-linecap="round"></path>
                </svg>
              </div>

              <div class="min-w-0 flex-1">
                <p
                  class="text-xs font-bold uppercase tracking-wider text-sky-700"
                >
                  Join Us for Lunch
                </p>

                <h3
                  class="mt-2 text-2xl font-bold leading-tight text-slate-900"
                >
                  There’s a Seat at Our Table.
                </h3>

                <p class="mt-3 text-slate-700">
                  Join us for a hot lunch, friendly faces, and community. We’d
                  love to welcome you.
                </p>

                <div class="mt-5 space-y-2 text-sm text-slate-700">
                  <p>
                    <span class="font-bold text-sky-700">Every day</span>
                    · 11:00 AM–1:00 PM
                  </p>
                  <p>1916 E. Perkins Ave., Guthrie, OK</p>
                </div>

                <a
                  href="https://www.google.com/maps/search/?api=1&query=1916+E+Perkins+Ave+Guthrie+OK"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hope-action mt-5 inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-sky-700 px-5 py-3 text-center text-sm font-bold text-white transition-colors hover:bg-sky-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700 sm:w-auto"
                >
                  Get Directions →
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Walk-In Services -->
  <section
    id="walk-in-services"
    class="scroll-mt-64 bg-sky-50 py-12 sm:py-16 md:scroll-mt-40"
    aria-labelledby="walk-in-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        tag="Everyday Support"
        title="Walk-In Services"
        id="walk-in-title"
        titleClass="text-3xl font-bold text-slate-900"
        subtitle="Support for everyday needs, with a welcoming team ready to help. Walk-in services are available seven days a week until 5:00 PM."
        centered={false}
        class="mb-8"
        subtitleClass="mt-5 max-w-2xl leading-relaxed text-slate-700"
      />

      <div class="hope-frame hope-frame-accent mb-8 bg-white p-6 sm:p-8">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
          <span
            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-sky-100 text-3xl"
            aria-hidden="true"
          >
            📋
          </span>

          <div>
            <h3 class="text-xl font-bold text-sky-700">Your First Visit</h3>

            <p class="mt-2 max-w-3xl leading-relaxed text-slate-700">
              Stop at the front desk to complete an application and receive your
              barcode key tag. Bring your key tag with you for future visits.
            </p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          walkInServices.map(({ data: service }) => (
            <article class="service-card hope-frame hope-frame-accent bg-white p-6">
              <span
                class="service-icon mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-sky-100 text-3xl"
                aria-hidden="true"
              >
                {service.icon}
              </span>

              <h3 class="text-xl font-bold text-slate-900">{service.title}</h3>

              <p class="mt-3 text-sm leading-relaxed text-slate-600">
                {service.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Shelter & Residential Programs -->
  <section
    id="housing"
    class="scroll-mt-64 bg-white py-12 sm:py-16 md:scroll-mt-40"
    aria-labelledby="housing-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        tag="A Place to Begin Again"
        title="Emergency & Transitional Shelter Programs"
        id="housing-title"
        titleClass="text-3xl font-bold text-slate-900"
        subtitle="From a short-term place to stay to a longer journey toward stability, our programs offer shelter, support, and opportunities to move forward."
        centered={false}
        class="mb-8"
        subtitleClass="mt-5 max-w-3xl leading-relaxed text-slate-700"
      />

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        {
          residentialPrograms.map(({ data: program }) => (
            <article class="service-card hope-frame hope-frame-accent flex flex-col bg-sky-50 p-6">
              <span
                class="service-icon mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-sky-100 text-3xl"
                aria-hidden="true"
              >
                {program.icon}
              </span>

              <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
                {program.label}
              </p>

              <h3 class="mt-2 text-2xl font-bold text-slate-900">
                {program.title}
              </h3>

              <p class="mt-3 text-sm leading-relaxed text-slate-700">
                {program.description}
              </p>

              <div class="mt-5 border-t border-sky-200 pt-5">
                <h4 class="font-bold text-sky-700">What to Expect</h4>

                <ul class="mt-3 list-disc space-y-3 pl-5 text-sm leading-relaxed text-slate-700">
                  {program.expectations.map((expectation) => (
                    <li>{expectation}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Housing Inquiry -->
      <div class="hope-frame hope-frame-accent mt-8 bg-sky-50 p-6 sm:p-8">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-7">
          <div
            class="flex h-28 w-28 shrink-0 items-center justify-center self-center rounded-full bg-sky-100"
            aria-hidden="true"
          >
            <svg viewBox="0 0 120 120" class="h-24 w-24" fill="none">
              <ellipse cx="60" cy="101" rx="37" ry="5" fill="#bae6fd"></ellipse>

              <path
                d="M31 52H89V94C89 97 87 99 84 99H36C33 99 31 97 31 94V52Z"
                fill="#7dd3fc"></path>

              <path d="M79 36V24H88V44" fill="#0369a1"></path>

              <path
                d="M22 54L60 22L98 54"
                stroke="#0369a1"
                stroke-width="9"
                stroke-linecap="round"
                stroke-linejoin="round"></path>

              <rect x="49" y="68" width="23" height="31" rx="3" fill="#0369a1"
              ></rect>

              <circle cx="66" cy="84" r="2" fill="#fbbf24"></circle>

              <rect x="36" y="60" width="10" height="13" rx="2" fill="#ffffff"
              ></rect>

              <rect x="77" y="60" width="10" height="13" rx="2" fill="#ffffff"
              ></rect>

              <path
                class="housing-heart"
                d="M60 58L51 49C45 43 53 35 60 42C67 35 75 43 69 49L60 58Z"
                fill="#f59e0b"></path>
            </svg>
          </div>

          <div class="min-w-0 flex-1">
            <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
              Interested in a Bed?
            </p>

            <h3 class="mt-2 text-2xl font-bold text-slate-900">
              Your Next Step Starts Here.
            </h3>

            <p class="mt-3 max-w-3xl leading-relaxed text-slate-700">
              Call, complete our website inquiry form, or visit the front desk
              to ask about availability. Our intake team can discuss your needs
              and help you understand the next steps.
            </p>

            <a
              href="/contact#new-client-inquiry"
              class="hope-action mt-5 inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-sky-700 px-5 py-3 text-center text-sm font-bold text-white transition-colors hover:bg-sky-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700 sm:w-auto"
            >
              Ask About a Bed →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recovery & Peer Support -->
  <section
    id="recovery"
    class="scroll-mt-64 bg-sky-50 py-12 sm:py-16 md:scroll-mt-40"
    aria-labelledby="recovery-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        tag="Connection & Encouragement"
        title="Recovery & Peer Support"
        id="recovery-title"
        titleClass="text-3xl font-bold text-slate-900"
        subtitle="Moving forward takes support. Our meetings and groups provide opportunities to connect, share experiences, and build skills for recovery and everyday life."
        centered={false}
        class="mb-8"
        subtitleClass="mt-5 max-w-3xl leading-relaxed text-slate-700"
      />

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <!-- NA Meetings -->
        <article class="service-card hope-frame hope-frame-accent bg-white p-6">
          <span
            class="service-icon mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-sky-100 text-3xl"
            aria-hidden="true"
          >
            🤝
          </span>

          <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
            Recovery &amp; Fellowship
          </p>

          <h3 class="mt-2 text-2xl font-bold text-slate-900">
            Narcotics Anonymous
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-slate-700">
            Hope House hosts Blessed in Recovery, a Narcotics Anonymous group
            offering connection, shared experience, and support in recovery.
          </p>

          <div class="mt-5 border-t border-sky-200 pt-5">
            <h4 class="font-bold text-sky-700">Learn More</h4>

            <p class="mt-3 text-sm leading-relaxed text-slate-700">
              Contact our team for meeting times and details about attending.
            </p>

            <a
              href="/contact#meeting-inquiries"
              class="hope-action mt-5 inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-sky-700 px-5 py-3 text-center text-sm font-bold text-white transition-colors hover:bg-sky-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700 sm:w-auto"
            >
              Ask About Meetings →
            </a>
          </div>
        </article>

        <!-- Support Groups -->
        <article class="service-card hope-frame hope-frame-accent bg-white p-6">
          <span
            class="service-icon mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-sky-100 text-3xl"
            aria-hidden="true"
          >
            💬
          </span>

          <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
            Wellness &amp; Personal Growth
          </p>

          <h3 class="mt-2 text-2xl font-bold text-slate-900">
            Support Groups &amp; Life Skills
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-slate-700">
            Hope House participants build connections and practical skills
            through support groups, wellness activities, and learning
            opportunities.
          </p>

          <div class="mt-5 border-t border-sky-200 pt-5">
            <h4 class="font-bold text-sky-700">Program Activities</h4>

            <ul
              class="mt-3 list-disc space-y-4 pl-5 text-sm leading-relaxed text-slate-700"
            >
              <li>
                <strong class="mr-1 text-sky-700"
                  >DBSA Support &amp; Wellness Groups:</strong
                >
                Peer connection and conversations about emotional wellness and everyday
                coping skills.
              </li>

              <li>
                <strong class="mr-1 text-sky-700">I Matter Journaling:</strong>
                Guided journaling that encourages self-reflection, personal growth,
                and recognizing your own worth.
              </li>

              <li>
                <strong class="mr-1 text-sky-700">Tech Quest:</strong>
                Practical technology lessons that build confidence using computers
                and digital tools.
              </li>

              <li>
                <strong class="mr-1 text-sky-700"
                  >Serving Health, Serving Hope:</strong
                >
                Learning opportunities focused on healthy habits and everyday wellness.
              </li>

              <li>
                <strong class="mr-1 text-sky-700">
                  Peace at Home, Peace in Community:
                </strong>
                Conversations about respectful communication, managing conflict, and
                building healthier relationships.
              </li>

              <li>
                <strong class="mr-1 text-sky-700">
                  Hope House Guthrie Smiles:
                </strong>
                A class exploring dental hygiene and addiction recovery, helping clients
                build healthy habits that support a successful sober life. Clients
                who cannot afford needed dental care can also apply for assistance
                with dentures, dental surgery, and other dental needs.
              </li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layout>