---
import Layout from "../layouts/main.astro";
import PageHeader from "../components/PageHeader.astro";
import { Image } from "astro:assets";
import paypalLogo from "../assets/paypal-logo.jpg";
---

<Layout title="Donate & Support">
  <PageHeader
    title="Support Hope House Guthrie"
    description="We are a 501(c)(3) non-profit organization. Your contributions are tax-deductible and directly fund shelter, food, and recovery services in Logan County."
  />

  <section class="py-16 bg-white">
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-8"
    >
      <!-- 300 Club -->
      <div
        class="border-2 border-sky-700 rounded-2xl p-8 bg-sky-50 flex flex-col justify-between"
      >
        <div>
          <span
            class="bg-sky-700 text-white text-xs font-bold px-3 py-1 rounded-full uppercase"
            >Sustaining Giving</span
          >
          <h2 class="text-2xl font-bold text-slate-900 mt-4 mb-2">
            The 300 Club
          </h2>
          <p class="text-slate-600 mb-6">
            Join our core group of supporters giving at least <strong
              >$10 per month</strong
            > to sustain our day-to-day operational needs and hot lunch programs.
          </p>
        </div>
        <a
          href="/300-club"
          class="hope-action bg-sky-700 hover:bg-sky-800 text-white text-center font-bold py-3 rounded-lg block transition-colors"
        >
          Join the 300 Club
        </a>
      </div>

      <!-- Adopt A Room -->
      <div
        id="adopt-a-room"
        class="border-2 border-emerald-600 rounded-2xl p-8 bg-emerald-50/30 flex flex-col justify-between"
      >
        <div>
          <span
            class="bg-emerald-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase"
            >Direct Sponsorship</span
          >
          <h2 class="text-2xl font-bold text-slate-900 mt-4 mb-2">
            Adopt-a-Room Program
          </h2>
          <p class="text-slate-600 mb-6">
            Become a monthly supporter through Adopt-a-Room, with giving levels
            starting at <strong>$20 per month</strong>. Your gift helps sustain
            safe shelter and support for people working toward recovery,
            stability, and independence.
          </p>
        </div>
        <a
          href="/adopt-a-room"
          class="hope-action block rounded-lg bg-emerald-600 py-3 text-center font-bold text-white transition-colors hover:bg-emerald-700"
        >
          Adopt a Room →
        </a>
      </div>
    </div>

    <!-- How to Give -->
    <div
      id="donate-options"
      class="max-w-3xl mx-auto mt-16 p-8 bg-slate-50 border border-slate-200 rounded-xl"
    >
      <h3 class="text-xl font-bold text-slate-900 mb-6 text-center">
        Ways to Send Your Donation
      </h3>

      <div class="grid sm:grid-cols-2 gap-6">
        <!-- Online donation -->
        <div class="bg-white p-5 rounded-lg border border-slate-200">
          <h4 class="font-bold text-slate-900 mb-2">Donate Online</h4>

          <p class="text-sm text-slate-600 mb-4">
            Give securely through PayPal to support Neighborhood Hope Dealers,
            Inc. / Hope House Guthrie.
          </p>

          <a
            href="https://www.paypal.com/cgi-bin/webscr?cmd=_donations&business=hopehouseguthrie@yahoo.com&item_name=Hope%20House%20Guthrie&currency_code=USD"
            class="hope-action block w-full rounded-lg bg-emerald-600 py-2.5 text-center text-sm font-bold text-white transition-colors hover:bg-emerald-700"
          >
            Proceed to Online Payment →
          </a>

          <div class="mt-4 flex items-center justify-center gap-3">
            <span class="text-xs text-slate-500">
              Secure payment through PayPal
            </span>

            <Image
              src={paypalLogo}
              alt="PayPal"
              width={80}
              loading="lazy"
              class="h-auto w-16 shrink-0 object-contain"
            />
          </div>
        </div>

        <!-- Check donation -->
        <div class="bg-white p-5 rounded-lg border border-slate-200">
          <h4 class="font-bold text-slate-900 mb-2">Donate by Check</h4>

          <p class="text-sm text-slate-600">Please make checks payable to:</p>

          <p class="text-sm font-semibold text-slate-800 my-2">
            NHD - HOPE HOUSE GUTHRIE
          </p>

          <p class="text-xs text-slate-500">
            Mail to:<br />
            PO Box 491, Guthrie, OK 73044
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
