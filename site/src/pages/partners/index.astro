---
import Layout from "@/layouts/main/index.astro";
import PageHeader from "@/lib/PageHeader.astro";
import OrganizationGrid from "./lib/OrganizationGrid.astro";
import PartnerInquiryForm from "@/forms/PartnerInquiryForm.astro";
import { getCollection } from "astro:content";

const partners = await getCollection("partners");
const supporters = await getCollection("supporters");

const recognitionGroups = [
  {
    id: "partners-title",
    title: "Community Partners",
    description:
      "Working together to connect our community with food, resources, recovery support, and opportunities.",
    organizations: partners,
    background: "bg-sky-50",
  },
  {
    id: "supporters-title",
    title: "Community Supporters",
    description:
      "Thank you to the organizations and businesses whose generosity helps us meet everyday needs and keep hope moving forward.",
    organizations: supporters,
    background: "bg-white",
  },
];
---

<Layout title="Partners & Supporters">
  <PageHeader
    title="Partners & Supporters"
    description="Thank you to the organizations and businesses that help us serve hope and move forward."
  />

  {
    recognitionGroups.map((group) => (
      <OrganizationGrid
        id={group.id}
        title={group.title}
        description={group.description}
        organizations={group.organizations}
        background={group.background}
      />
    ))
  }

  <PartnerInquiryForm />
</Layout>