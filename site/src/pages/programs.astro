---
import Layout from '../layouts/main.astro';
---

<Layout title="Programs & Services">
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold mb-4">Programs & Services</h1>
      <p class="text-slate-300 max-w-2xl text-lg">
        Providing direct relief and long-term support to break cycles of crisis and addiction.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white space-y-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Soup Kitchen -->
    <div id="soup-kitchen" class="grid md:grid-cols-3 gap-8 items-start scroll-mt-24">
      <div class="md:col-span-1">
        <span class="text-xs font-bold text-amber-600 uppercase tracking-wide">Direct Food Relief</span>
        <h2 class="text-2xl font-bold text-slate-900 mt-1">Daily Soup Kitchen</h2>
      </div>
      <div class="md:col-span-2 text-slate-600 space-y-4">
        <p>
          We serve hot, nutritious lunches Monday through Friday from <strong>12:00 PM – 1:00 PM</strong> inside our facility at 1916 E Perkins. All community members in need are welcome. Inside seating follows recommended safety guidelines.
        </p>
        <p>
          We also partner directly with God's Food Bank and USDA to ensure proper food security for unhoused and low-income individuals in Logan County.
        </p>
      </div>
    </div>

    <hr class="border-slate-200" />

    <!-- Housing & Basic Needs -->
    <div id="housing" class="grid md:grid-cols-3 gap-8 items-start scroll-mt-24">
      <div class="md:col-span-1">
        <span class="text-xs font-bold text-sky-600 uppercase tracking-wide">Transitional Shelter</span>
        <h2 class="text-2xl font-bold text-slate-900 mt-1">Housing & Walk-in Services</h2>
      </div>
      <div class="md:col-span-2 text-slate-600 space-y-4">
        <p>
          Our 35-room facility offers safe, structured housing for up to 60+ residents participating in our Life Transformation Program.
        </p>
        <p>
          <strong>Walk-in Support:</strong> For unsheltered community members not residing on-site, we provide access to warm showers, clean clothing, and essential toiletries.
        </p>
      </div>
    </div>

    <hr class="border-slate-200" />

    <!-- Recovery Meetings -->
    <div id="recovery" class="grid md:grid-cols-3 gap-8 items-start scroll-mt-24">
      <div class="md:col-span-1">
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-wide">Blessed in Recovery</span>
        <h2 class="text-2xl font-bold text-slate-900 mt-1">Narcotics Anonymous (NA)</h2>
      </div>
      <div class="md:col-span-2 text-slate-600 space-y-4">
        <p>
          Hope House Guthrie is home to the <strong>only official registered NA meeting site in Logan County</strong> ("Blessed in Recovery").
        </p>
        <p>
          We partner with Logan County Drug Court for participant referrals, providing recovery meetings, job placement assistance, counseling, and transportation support for medical or court appointments.
        </p>
      </div>
    </div>
  </section>
</Layout>