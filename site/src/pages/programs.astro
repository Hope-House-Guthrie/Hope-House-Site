---
import Layout from "../layouts/main.astro";
---

<Layout title="Programs & Services">
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold mb-4">Programs & Services</h1>
      <p class="text-slate-300 max-w-2xl text-lg">
        Providing direct relief and long-term support to break cycles of crisis
        and addiction.
      </p>
    </div>
  </section>

  <section
    class="py-16 bg-white space-y-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
  >
    <!-- Soup Kitchen -->
    <div
      id="soup-kitchen"
      class="grid md:grid-cols-3 gap-8 items-start scroll-mt-24"
    >
      <div class="md:col-span-1">
        <span class="text-xs font-bold text-amber-600 uppercase tracking-wide"
          >Direct Food Relief</span
        >
        <h2 class="text-2xl font-bold text-slate-900 mt-1">
          Daily Community Lunch
        </h2>
      </div>
      <div class="md:col-span-2 text-slate-600 space-y-4">
        <p>
          Hope House serves lunch <strong
            >seven days a week from 11:00 AM–1:00 PM</strong
          >
          at our facility at 1916 E. Perkins Ave. Community members in need are welcome.
        </p>
        <p>
          Our food program is supported through community partnerships and
          regular food pickups, including God's Food Bank, the Regional Food
          Bank, and Reasor's, helping us provide meals and food assistance to
          people in our community.
        </p>
      </div>
    </div>

    <hr class="border-slate-200" />

    <!-- Housing & Basic Needs -->
    <div
      id="housing"
      class="grid md:grid-cols-3 gap-8 items-start scroll-mt-24"
    >
      <div class="md:col-span-1">
        <span class="text-xs font-bold text-sky-600 uppercase tracking-wide"
          >Transitional Shelter</span
        >
        <h2 class="text-2xl font-bold text-slate-900 mt-1">
          Housing & Walk-in Services
        </h2>
      </div>
      <div class="md:col-span-2 text-slate-600 space-y-4">
        <p>
          Hope House provides safe, structured transitional housing for
          individuals working toward greater stability and independence.
        </p>
        <p>
          <strong>Walk-In Support:</strong> Community members who are not residing
          at Hope House Guthrie can access services including showers, clothing, and
          essential hygiene items <strong
            >seven days a week until 5:00 PM</strong
          >.
        </p>
      </div>
    </div>

    <hr class="border-slate-200" />

    <!-- Recovery Meetings -->
    <div
      id="recovery"
      class="grid md:grid-cols-3 gap-8 items-start scroll-mt-24"
    >
      <div class="md:col-span-1">
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-wide"
          >Recovery & Peer Support</span
        >
        <h2 class="text-2xl font-bold text-slate-900 mt-1">
          Narcotics Anonymous (NA)
        </h2>
      </div>
      <div class="md:col-span-2 text-slate-600 space-y-4">
        <p>
          Hope House Guthrie is home to <strong>The Living Room</strong>, a
          Narcotics Anonymous (NA) group providing a welcoming place for
          recovery, fellowship, and peer support.
        </p>
        <p>
          Hope House also works with individuals participating in Logan County
          Drug Court, including providing housing and access to a supportive
          recovery-focused environment.
        </p>
      </div>
    </div>
  </section>
</Layout>
