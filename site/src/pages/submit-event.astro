---
import Layout from "../layouts/main.astro";
import PageHeader from "../components/PageHeader.astro";

const inputClass =
  "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-700/20";
---

<Layout title="Submit a Community Event">
  <PageHeader
    title="Submit a Community Event"
    description="Share an upcoming event in Guthrie or a surrounding community for consideration on our events page and community calendar."
  />

  <section class="bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <a
        href="/events"
        class="font-semibold text-sky-700 underline underline-offset-4 hover:text-sky-800"
      >
        ← Back to Events
      </a>

      <div class="hope-frame hope-frame-accent mt-6 bg-sky-50 p-6 sm:p-8">
        <h2 class="text-2xl font-bold text-sky-700">
          Tell Us About Your Event
        </h2>

        <p class="mt-3 leading-relaxed text-slate-700">
          Submissions are reviewed by Hope House Guthrie before being added.
          Submitting an event does not guarantee publication.
        </p>

        <p class="mt-3 text-sm text-slate-600">
          Fields marked with an asterisk (*) are required. Your contact
          information is for our team and will not be included in the listing.
        </p>

        <!-- TJ: Connect submission handling and flyer uploads before enabling. -->
        <form
          class="mt-8 space-y-8"
          onsubmit="event.preventDefault()"
        >
          <fieldset>
            <legend class="text-lg font-bold text-sky-700">
              Your Contact Information
            </legend>

            <div class="mt-4 grid gap-5 sm:grid-cols-2">
              <div>
                <label for="contact-name" class="font-semibold text-slate-800">
                  Your Name *
                </label>
                <input
                  id="contact-name"
                  name="contact_name"
                  type="text"
                  autocomplete="name"
                  required
                  maxlength="150"
                  class={inputClass}
                />
              </div>

              <div>
                <label for="contact-email" class="font-semibold text-slate-800">
                  Email Address *
                </label>
                <input
                  id="contact-email"
                  name="contact_email"
                  type="email"
                  autocomplete="email"
                  required
                  maxlength="254"
                  class={inputClass}
                />
              </div>

              <div>
                <label for="contact-phone" class="font-semibold text-slate-800">
                  Phone Number
                </label>
                <input
                  id="contact-phone"
                  name="contact_phone"
                  type="tel"
                  autocomplete="tel"
                  class={inputClass}
                />
              </div>

              <div>
                <label for="organization" class="font-semibold text-slate-800">
                  Organization or Event Host *
                </label>
                <input
                  id="organization"
                  name="organization"
                  type="text"
                  required
                  maxlength="200"
                  class={inputClass}
                />
              </div>
            </div>
          </fieldset>

          <fieldset class="border-t border-sky-200 pt-6">
            <legend class="px-1 text-lg font-bold text-sky-700">
              Event Details
            </legend>

            <div class="mt-4 space-y-5">
              <div>
                <label for="event-name" class="font-semibold text-slate-800">
                  Event Name *
                </label>
                <input
                  id="event-name"
                  name="event_name"
                  type="text"
                  required
                  maxlength="200"
                  class={inputClass}
                />
              </div>

              <div>
                <label
                  for="event-description"
                  class="font-semibold text-slate-800"
                >
                  Event Description *
                </label>
                <textarea
                  id="event-description"
                  name="event_description"
                  rows="5"
                  required
                  maxlength="5000"
                  placeholder="Tell us what’s happening, who it’s for, and what attendees should know."
                  class={inputClass}
                ></textarea>
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="start-date" class="font-semibold text-slate-800">
                    Start Date *
                  </label>
                  <input
                    id="start-date"
                    name="start_date"
                    type="date"
                    required
                    class={inputClass}
                  />
                </div>

                <div>
                  <label for="end-date" class="font-semibold text-slate-800">
                    End Date *
                  </label>
                  <input
                    id="end-date"
                    name="end_date"
                    type="date"
                    required
                    aria-describedby="end-date-help"
                    class={inputClass}
                  />
                  <p id="end-date-help" class="mt-2 text-sm text-slate-600">
                    For a one-day event, use the same date.
                  </p>
                </div>

                <div>
                  <label for="start-time" class="font-semibold text-slate-800">
                    Start Time
                  </label>
                  <input
                    id="start-time"
                    name="start_time"
                    type="time"
                    class={inputClass}
                  />
                </div>

                <div>
                  <label for="end-time" class="font-semibold text-slate-800">
                    End Time
                  </label>
                  <input
                    id="end-time"
                    name="end_time"
                    type="time"
                    class={inputClass}
                  />
                </div>
              </div>

              <label class="flex items-center gap-3 text-slate-800">
                <input
                  name="all_day"
                  type="checkbox"
                  value="yes"
                  class="h-5 w-5 accent-sky-700"
                />
                This is an all-day event
              </label>

              <p class="text-sm text-slate-600">
                Please provide times in local Central Time.
              </p>

              <div>
                <label for="venue" class="font-semibold text-slate-800">
                  Venue or Location Name *
                </label>
                <input
                  id="venue"
                  name="venue"
                  type="text"
                  required
                  maxlength="250"
                  class={inputClass}
                />
              </div>

              <div>
                <label for="event-address" class="font-semibold text-slate-800">
                  Event Address or Online Location *
                </label>
                <textarea
                  id="event-address"
                  name="event_address"
                  rows="2"
                  required
                  maxlength="1000"
                  placeholder="Include the street address and city, or public online event details."
                  class={inputClass}
                ></textarea>
              </div>

              <div>
                <label for="event-cost" class="font-semibold text-slate-800">
                  Admission or Cost *
                </label>
                <input
                  id="event-cost"
                  name="event_cost"
                  type="text"
                  required
                  maxlength="250"
                  placeholder="For example: Free, $5 per person, or donation appreciated"
                  class={inputClass}
                />
              </div>

              <div>
                <label for="event-url" class="font-semibold text-slate-800">
                  Event Website or Registration Link
                </label>
                <input
                  id="event-url"
                  name="event_url"
                  type="url"
                  placeholder="https://"
                  class={inputClass}
                />
              </div>

              <div>
                <label for="event-flyer" class="font-semibold text-slate-800">
                  Event Flyer
                </label>
                <input
                  id="event-flyer"
                  name="event_flyer"
                  type="file"
                  accept=".jpg,.jpeg,.png,.webp,.pdf"
                  aria-describedby="flyer-help"
                  class={inputClass}
                />
                <p id="flyer-help" class="mt-2 text-sm text-slate-600">
                  Optional: JPG, PNG, WebP, or PDF.
                </p>
              </div>

              <div>
                <label for="notes" class="font-semibold text-slate-800">
                  Additional Notes for Our Team
                </label>
                <textarea
                  id="notes"
                  name="notes"
                  rows="3"
                  maxlength="2000"
                  class={inputClass}
                ></textarea>
              </div>
            </div>
          </fieldset>

          <div class="border-t border-sky-200 pt-6">
            <label class="flex items-start gap-3 text-sm leading-relaxed text-slate-700">
              <input
                name="permission"
                type="checkbox"
                value="yes"
                required
                class="mt-1 h-5 w-5 shrink-0 accent-sky-700"
              />
              <span>
                I confirm that I have permission to share these event details
                and any uploaded flyer for public use. I understand that
                Hope House Guthrie reviews submissions and does not guarantee
                publication. *
              </span>
            </label>

            <p id="submission-status" class="mt-6 text-sm text-slate-600">
              Online event submissions are coming soon. This form is not
              accepting submissions yet.
            </p>

            <button
              type="submit"
              disabled
              aria-describedby="submission-status"
              class="mt-4 inline-flex min-h-11 cursor-not-allowed items-center justify-center rounded-lg bg-slate-200 px-6 py-3 font-bold text-slate-600"
            >
              Submissions Coming Soon
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>