---
import Layout from "../layouts/main.astro";
---

<Layout title="Contact Us">
  <section class="bg-sky-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold mb-4">Contact Hope House Guthrie</h1>
      <p class="text-sky-100 max-w-2xl text-lg">
        Whether you need assistance, have questions about our programs, or want
        to support our work, we're here to help connect you with the right
        information.
      </p>
    </div>
  </section>
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12">
        <!-- Contact Information -->
        <div>
          <span class="text-xs font-bold text-sky-700 uppercase tracking-wide">
            Get in Touch
          </span>

          <h2 class="text-2xl font-bold text-slate-900 mt-1 mb-6">
            Hope House Guthrie
          </h2>

          <div class="space-y-5 text-slate-600">
            <div>
              <strong class="text-slate-900">Visit Us</strong>
              <p>1916 E. Perkins Ave.<br />Guthrie, OK 73044</p>
            </div>

            <div>
              <strong class="text-slate-900">Phone</strong>
              <p>
                <a href="tel:4058569058" class="text-sky-700 hover:underline">
                  (405) 856-9058
                </a>
              </p>
            </div>
          </div>
        </div>

        <!-- Services & Hours -->
        <div class="hope-frame hope-frame-accent bg-sky-50 p-8">
          <span class="text-xs font-bold text-sky-700 uppercase tracking-wide">
            Need Help?
          </span>

          <h2 class="text-2xl font-bold text-slate-900 mt-1 mb-6">
            Services Available Daily
          </h2>

          <div class="space-y-6 text-slate-600">
            <div>
              <h3 class="font-bold text-slate-900">Community Lunch</h3>
              <p>Seven days a week</p>
              <p class="font-semibold text-slate-800">11:00 AM - 1:00 PM</p>
            </div>

            <div>
              <h3 class="font-bold text-slate-900">Walk-In Services</h3>
              <p>Showers, clothing, and essential hygiene items</p>
              <p class="font-semibold text-slate-800">
                7 days a week until 5:00 PM
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Meeting Questions -->
  <section
    id="meeting-inquiries"
    class="scroll-mt-64 bg-white pb-16 md:scroll-mt-40"
    aria-labelledby="meeting-inquiries-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="hope-frame hope-frame-accent bg-sky-50 p-6 sm:p-8">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
          <span
            class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-sky-100 text-3xl"
            aria-hidden="true"
          >
            🤝
          </span>

          <div class="min-w-0 flex-1">
            <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
              Recovery &amp; Connection
            </p>

            <h2
              id="meeting-inquiries-title"
              class="mt-2 text-2xl font-bold text-slate-900"
            >
              Meeting &amp; Support Group Questions
            </h2>

            <p class="mt-3 max-w-3xl leading-relaxed text-slate-700">
              Interested in attending a Narcotics Anonymous meeting or learning
              about our support groups? Contact our team for meeting times,
              attendance details, and information about which groups are
              available to you.
            </p>

            <div
              class="mt-5 flex flex-col items-start gap-4 sm:flex-row sm:items-center"
            >
              <a
                href="tel:4058569058"
                class="hope-action inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-sky-700 px-5 py-3 text-center text-sm font-bold text-white transition-colors hover:bg-sky-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700 sm:w-auto"
              >
                Call (405) 856-9058
              </a>

              <a
                href="mailto:intake@hopehouseguthrie.org?subject=Meeting%20and%20Support%20Group%20Question"
                class="inline-flex min-h-11 items-center rounded-lg px-2 font-semibold text-sky-700 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
              >
                Email About Meetings →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- New Client Inquiry -->
  <section
    id="new-client-inquiry"
    class="scroll-mt-64 bg-sky-50 py-16 md:scroll-mt-40"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-sky-700">New Client Inquiry</h2>

        <div
          class="w-full h-1 bg-sky-500 rounded-full mt-4 mb-5"
          aria-hidden="true"
        >
        </div>

        <p class="text-slate-700 leading-relaxed">
          Interested in staying at Hope House Guthrie? Complete this inquiry so
          our team can contact you about bed availability and next steps.
        </p>

        <p class="mt-3 text-sm text-slate-600">
          Submitting an inquiry does not reserve a bed or guarantee placement.
        </p>
      </div>

      <!--
      TJ: Connect this form to a submission handler.
      Deliver inquiries to intake@hopehouseguthrie.org.
      Enable submission after delivery and error handling are tested.
       -->
      <form
        class="hope-frame hope-frame-accent bg-white p-6 sm:p-8"
        onsubmit="event.preventDefault()"
      >
        <div
          class="mb-6 rounded-lg border border-sky-200 bg-white p-4 sm:p-5 text-sm sm:text-base leading-relaxed text-slate-700"
        >
          <p>
            <strong class="text-slate-900">Please note: </strong>
            Hope House Guthrie provides shelter and community support. We are not
            a medical facility and do not provide on-site medical or nursing care.
            If you need assistance that requires medical personnel, please discuss
            those needs with our intake team so we can determine whether our services
            can meet your needs.
          </p>
        </div>

        <p class="text-sm text-slate-600 mb-6">
          Fields marked with * are required.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="sm:col-span-2">
            <div
              class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1fr_140px] gap-4"
            >
              <div>
                <label
                  for="inquiry-first-name"
                  class="block font-semibold text-slate-900 mb-2"
                >
                  First Name *
                </label>
                <input
                  type="text"
                  id="inquiry-first-name"
                  name="firstName"
                  autocomplete="given-name"
                  maxlength="100"
                  required
                  class="block w-full min-w-0 rounded-lg border border-slate-300 bg-white px-4 py-3 text-base text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
                />
              </div>

              <div>
                <label
                  for="inquiry-middle-name"
                  class="block font-semibold text-slate-900 mb-2"
                >
                  Middle Name
                </label>
                <input
                  type="text"
                  id="inquiry-middle-name"
                  name="middleName"
                  autocomplete="additional-name"
                  maxlength="100"
                  class="block w-full min-w-0 rounded-lg border border-slate-300 bg-white px-4 py-3 text-base text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
                />
              </div>

              <div>
                <label
                  for="inquiry-last-name"
                  class="block font-semibold text-slate-900 mb-2"
                >
                  Last Name *
                </label>
                <input
                  type="text"
                  id="inquiry-last-name"
                  name="lastName"
                  autocomplete="family-name"
                  maxlength="100"
                  required
                  class="block w-full min-w-0 rounded-lg border border-slate-300 bg-white px-4 py-3 text-base text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
                />
              </div>

              <div>
                <label
                  for="inquiry-suffix"
                  class="block font-semibold text-slate-900 mb-2"
                >
                  Suffix
                </label>

                <select
                  id="inquiry-suffix"
                  name="suffix"
                  autocomplete="honorific-suffix"
                  class="block w-full min-w-0 rounded-lg border border-slate-300 bg-white px-4 py-3 text-base text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
                >
                  <option value="">None</option>
                  <option value="Jr.">Jr.</option>
                  <option value="Sr.">Sr.</option>
                  <option value="I">I</option>
                  <option value="II">II</option>
                  <option value="III">III</option>
                  <option value="IV">IV</option>
                  <option value="V">V</option>
                  <option value="VI">VI</option>
                </select>
              </div>
            </div>
          </div>

          <div class="sm:col-span-2">
            <label
              for="inquiry-dob"
              class="block font-semibold text-slate-900 mb-2"
            >
              Date of Birth *
            </label>

            <input
              type="date"
              id="inquiry-dob"
              name="dateOfBirth"
              autocomplete="bday"
              required
              class="block w-full min-w-0 rounded-lg border border-slate-300 bg-white px-4 py-3 text-base text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
            />
          </div>

          <div>
            <label
              for="inquiry-phone"
              class="block font-semibold text-slate-900 mb-2"
            >
              Phone Number
            </label>
            <input
              id="inquiry-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              inputmode="tel"
              placeholder="(555) 555-5555"
              maxlength="14"
              class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
            />
          </div>
          <script>
            const phoneInput =
              document.querySelector<HTMLInputElement>("#inquiry-phone");

            phoneInput?.addEventListener("input", () => {
              let digits = phoneInput.value.replace(/\D/g, "");

              // Accept pasted US numbers beginning with country code 1.
              if (digits.length === 11 && digits.startsWith("1")) {
                digits = digits.slice(1);
              }

              digits = digits.slice(0, 10);

              if (digits.length > 6) {
                phoneInput.value = `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
              } else if (digits.length > 3) {
                phoneInput.value = `(${digits.slice(0, 3)}) ${digits.slice(3)}`;
              } else {
                phoneInput.value = digits;
              }
            });
          </script>

          <div>
            <label
              for="inquiry-email"
              class="block font-semibold text-slate-900 mb-2"
            >
              Email Address
            </label>
            <input
              id="inquiry-email"
              name="email"
              type="email"
              autocomplete="email"
              class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
            />
          </div>

          <div class="sm:col-span-2">
            <p class="text-sm text-slate-600">
              Please provide a phone number or email address where we can reach
              you.
            </p>
          </div>

          <div>
            <label
              for="inquiry-contact"
              class="block font-semibold text-slate-900 mb-2"
            >
              Preferred Contact Method *
            </label>
            <select
              id="inquiry-contact"
              name="contactMethod"
              required
              class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
            >
              <option value="">Select an option</option>
              <option value="call">Phone call</option>
              <option value="text">Text message</option>
              <option value="email">Email</option>
            </select>
          </div>

          <div>
            <label
              for="inquiry-household"
              class="block font-semibold text-slate-900 mb-2"
            >
              Who Needs Shelter? *
            </label>
            <select
              id="inquiry-household"
              name="householdType"
              required
              class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
            >
              <option value="">Select an option</option>
              <option value="individual">An individual</option>
              <option value="family">A family</option>
            </select>
          </div>

          <p class="text-sm text-slate-600 mb-6">
            Each adult seeking shelter must complete a separate inquiry. Include
            any children accompanying you in your inquiry.
          </p>

          <div>
            <label
              for="inquiry-children"
              class="block font-semibold text-slate-900 mb-2"
            >
              Number of Children *
            </label>
            <input
              id="inquiry-children"
              name="children"
              type="number"
              min="0"
              step="1"
              value="0"
              required
              class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
            />
          </div>

          <div class="sm:col-span-2">
            <label
              for="inquiry-timing"
              class="block font-semibold text-slate-900 mb-2"
            >
              When Do You Need Shelter? *
            </label>
            <select
              id="inquiry-timing"
              name="shelterTiming"
              required
              class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
            >
              <option value="">Select an option</option>
              <option value="today">Today</option>
              <option value="this-week">Within the next week</option>
              <option value="later">Later</option>
              <option value="unsure">Not sure yet</option>
            </select>
          </div>

          <div class="sm:col-span-2">
            <label
              for="inquiry-vaccinations"
              class="block font-semibold text-slate-900 mb-2"
            >
              Are you willing to receive COVID-19 and flu vaccinations? *
            </label>

            <select
              id="inquiry-vaccinations"
              name="vaccinationWillingness"
              required
              class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
            >
              <option value="">Select an option</option>
              <option value="yes">Yes</option>
              <option value="no">No</option>
              <option value="discuss">Would like to discuss with staff</option>
            </select>
          </div>

          <div class="sm:col-span-2">
            <label
              for="inquiry-message"
              class="block font-semibold text-slate-900 mb-2"
            >
              Anything Else You Would Like Us to Know?
            </label>
            <textarea
              id="inquiry-message"
              name="message"
              rows="4"
              maxlength="2000"
              aria-describedby="inquiry-message-help"
              class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
            ></textarea>
            <p id="inquiry-message-help" class="mt-2 text-sm text-slate-500">
              Please do not include Social Security numbers or detailed medical
              information.
            </p>
          </div>
        </div>

        <div
          id="inquiry-status"
          class="mt-6 rounded-lg border border-sky-200 bg-sky-50 p-5 text-base leading-relaxed text-slate-700"
        >
          <p>Online inquiries are coming soon. For now, contact our team:</p>

          <a
            href="tel:4058569058"
            class="block mt-3 font-semibold text-sky-700 hover:underline"
          >
            (405) 856-9058
          </a>

          <a
            href="mailto:intake@hopehouseguthrie.org"
            class="block mt-2 break-words font-semibold text-sky-700 hover:underline"
          >
            intake@hopehouseguthrie.org
          </a>
        </div>

        <button
          type="submit"
          disabled
          aria-describedby="inquiry-status"
          class="mt-6 w-full rounded-lg bg-emerald-600 px-6 py-3.5 font-bold text-white opacity-50 cursor-not-allowed"
        >
          Submit Inquiry — Coming Soon
        </button>
      </form>

      <dialog
        id="inquiry-confirmation"
        aria-labelledby="inquiry-confirmation-title"
        aria-describedby="inquiry-confirmation-message"
        class="hope-frame hope-frame-accent m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-lg overflow-y-auto bg-white p-6 text-slate-700 backdrop:bg-slate-900/60 sm:p-8"
      >
        <h2
          id="inquiry-confirmation-title"
          class="mb-4 text-2xl font-bold text-sky-700"
        >
          Thank You for Your Inquiry
        </h2>

        <div
          id="inquiry-confirmation-message"
          class="space-y-4 text-base leading-relaxed"
        >
          <p>
            Your inquiry has been received, and our administration team will be
            notified.
          </p>

          <p>
            If a bed is available and you meet our placement requirements,
            including background checks, someone from our team will contact you.
          </p>

          <p>
            Submitting an inquiry does not guarantee placement. If you have not
            heard from us, a bed may not be available. Please check back later
            by submitting another inquiry or calling:
          </p>

          <a
            href="tel:4058569058"
            class="block text-center text-lg font-bold text-sky-700 hover:underline"
          >
            (405) 856-9058
          </a>
        </div>

        <form method="dialog" class="mt-6">
          <button
            type="submit"
            autofocus
            class="w-full rounded-lg bg-sky-700 px-6 py-3 font-bold text-white transition-colors hover:bg-sky-800"
          >
            Got It
          </button>
        </form>
      </dialog>
    </div>
  </section>
</Layout>
