---
import Layout from "@/layouts/main/index.astro";
import PageHeader from "@/lib/PageHeader.astro";
import TestimonialCard from "@/pages/impact/lib/TestimonialCard.astro";
import { getCollection } from "astro:content";

const stories = (await getCollection("testimonials"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data);
---

<Layout title="Stories of Hope">
  <PageHeader
    title="Stories of Hope"
    description="Real stories from people who have found shelter, support, and a new beginning at Hope House Guthrie."
  />

  <section class="bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="space-y-8">
        {
          stories.map((story, index) => (
            <TestimonialCard story={story} index={index} />
          ))
        }
      </div>
    </div>
  </section>

  <script>
    import { initLiquidPhotos } from "./lib/liquid-photo";

    initLiquidPhotos();
    document.addEventListener("astro:after-swap", () => initLiquidPhotos());
  </script>
</Layout>
