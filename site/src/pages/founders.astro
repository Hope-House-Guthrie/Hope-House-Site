---
import Layout from "../layouts/main.astro";
import PageHeader from "../components/PageHeader.astro";
import { Image } from "astro:assets";

import hopeHouseLogo from "../assets/logo.svg";
import suePhoto from "../assets/board/sue-ducharme.png";

const founders = [
  {
    name: "OJ Myers",
    image: hopeHouseLogo,
    isPortrait: false,
    bio: "",
  },
  {
    name: "Mary Myers",
    image: hopeHouseLogo,
    isPortrait: false,
    bio: "",
  },
  {
    name: "Sue Ducharme",
    image: suePhoto,
    isPortrait: true,
    bio: "",
  },
];
---

<Layout title="Our Founders">
  <PageHeader
    title="Our Founders"
    description="Meet the people who helped bring Hope House Guthrie to life."
  />

  <!-- Founder Cards -->
  <section class="bg-sky-50 py-10 sm:py-12" aria-labelledby="founders-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 text-center">
        <h2
          id="founders-title"
          class="text-3xl font-bold tracking-tight text-sky-700 sm:text-4xl"
        >
          The People Behind the Beginning
        </h2>

        <div
          class="mx-auto mt-4 h-1 w-full rounded-full bg-sky-700"
          aria-hidden="true"
        >
        </div>

        <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-slate-700">
          Recognizing OJ Myers, Mary Myers, and Sue Ducharme and their part in
          starting
          <span class="block">Hope House Guthrie.</span>
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          founders.map((founder) => (
            <article class="hope-frame hope-frame-accent overflow-hidden bg-white">
              <div class="flex aspect-square items-center justify-center bg-sky-100">
                {founder.isPortrait ? (
                  <Image
                    src={founder.image}
                    alt={founder.name}
                    width={600}
                    format="webp"
                    loading="lazy"
                    class="h-full w-full object-cover object-top"
                  />
                ) : (
                  <Image
                    src={founder.image}
                    alt=""
                    width={320}
                    loading="lazy"
                    class="h-auto max-h-64 w-3/4 object-contain"
                  />
                )}
              </div>

              <div class="p-6 text-center">
                <h3 class="text-2xl font-bold text-sky-700">{founder.name}</h3>

                <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-slate-600">
                  Co-Founder
                </p>

                {founder.bio && (
                  <p class="mt-4 text-left leading-relaxed text-slate-700">
                    {founder.bio}
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-8 text-center">
        <a
          href="/about"
          class="hope-action inline-flex w-fit min-h-11 items-center justify-center rounded-lg bg-sky-700 px-6 py-3 font-semibold text-white hover:bg-sky-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
        >
          ← Explore Our Story
        </a>
      </div>
    </div>
  </section>
</Layout>
