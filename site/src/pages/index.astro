---
import Layout from "../layouts/main.astro";
import { getImage } from "astro:assets";
import aerialImage from "../assets/aerial.jpg";

const optimizedAerialImage = await getImage({
  src: aerialImage,
  format: "webp",
  quality: 60,
});
---

<Layout title="Home">
  <section
    class="bg-slate-900 text-white relative min-h-[70vh] lg:min-h-[calc(100vh-108px)] flex items-center overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat z-0"
      style={`background-image: url(${optimizedAerialImage.src});`}
    >
    </div>

    <div
      class="absolute inset-0 bg-gradient-to-r from-sky-950/80 to-slate-900/70 z-10"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20">
      <div class="max-w-3xl lg:translate-x-15">
        <span
          class="inline-block bg-sky-900/80 text-sky-300 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-4 border border-sky-700"
        >
          Serving Oklahoma
        </span>
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight mb-6"
        >
          Hope Starts Here.
        </h1>
        <p
          class="text-lg sm:text-xl text-slate-200 mb-6 leading-relaxed max-w-xl"
        >
          Hope House Guthrie provides shelter, meals, clothing, recovery
          support, and a path towards stability for people from across Oklahoma
          who need a place to begin again.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/programs"
            class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-8 py-3.5 rounded-lg text-center shadow-lg transition-all"
          >
            Get Help
          </a>
          <a
            href="/donate"
            class="bg-white/30 hover:bg-white/20 text-white font-semibold px-8 py-3.5 rounded-lg text-center border border-white/20 transition-all"
          >
            Support Hope House
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Services Grid -->
  <section class="py-24 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-slate-900">
          Serving Hope & Moving Forward
        </h2>
        <p class="mt-3 text-slate-600">
          We advocate for every person who comes through our doors, offering
          short-term shelter, long-term stabilization, and community care.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div
          class="bg-slate-50 border border-slate-200 rounded-xl p-6 hover:shadow-md transition-shadow"
        >
          <div
            class="w-12 h-12 bg-sky-100 text-sky-700 rounded-lg flex items-center justify-center font-bold text-xl mb-4"
          >
            🍲
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">
            Community Lunch & Walk-In Services
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Serving daily hot lunches from 11:00 PM – 1:00 PM. Walk-in services
            include showers, clothing, and hygiene toiletries until 5:00 PM.
          </p>
          <a
            href="/programs#soup-kitchen"
            class="text-sky-700 text-sm font-semibold hover:underline"
            >Learn More &rarr;</a
          >
        </div>

        <div
          class="bg-slate-50 border border-slate-200 rounded-xl p-6 hover:shadow-md transition-shadow"
        >
          <div
            class="w-12 h-12 bg-amber-100 text-amber-700 rounded-lg flex items-center justify-center font-bold text-xl mb-4"
          >
            🏠
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">
            Transitional Housing
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Transitional housing with structured support to help individuals
            work toward stability, independence, and their next step forward.
          </p>
          <a
            href="/programs#housing"
            class="text-sky-700 text-sm font-semibold hover:underline"
            >Learn More &rarr;</a
          >
        </div>

        <div
          class="bg-slate-50 border border-slate-200 rounded-xl p-6 hover:shadow-md transition-shadow"
        >
          <div
            class="w-12 h-12 bg-emerald-100 text-emerald-700 rounded-lg flex items-center justify-center font-bold text-xl mb-4"
          >
            🌱
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">
            Recovery & Support
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Narcotics Anonymous (NA) meetings, recovery support, job transition,
            budgeting, and connections to community resources.
          </p>
          <a
            href="/programs#recovery"
            class="text-sky-700 text-sm font-semibold hover:underline"
            >Learn More &rarr;</a
          >
        </div>
      </div>
    </div>
  </section>

 <!-- Community Partners -->
<section class="py-16 bg-slate-100 border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2
      class="text-center text-xs font-semibold uppercase tracking-wider text-slate-500 mb-8"
    >
      Trusted Community Partners &amp; Supporters
    </h2>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 auto-rows-fr gap-4 max-w-5xl mx-auto text-slate-600 font-semibold text-sm"
    >
      <a
        href="https://unitedwayokc.org/partnerships/united-way-of-logan-county/partner-agencies/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-14 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-center shadow-sm transition-colors hover:text-sky-700 hover:border-sky-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
      >
        <span>United Way of Logan County</span>
        <span class="shrink-0" aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>

      <a
        href="https://logancodrugcourt.org/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-14 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-center shadow-sm transition-colors hover:text-sky-700 hover:border-sky-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
      >
        <span>Logan County Drug Court</span>
        <span class="shrink-0" aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>

      <a
        href="https://www.godsfoodbank.org/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-14 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-center shadow-sm transition-colors hover:text-sky-700 hover:border-sky-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
      >
        <span>God's Food Bank</span>
        <span class="shrink-0" aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>

      <a
        href="https://cocaa.org/logan-county/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-14 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-center shadow-sm transition-colors hover:text-sky-700 hover:border-sky-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
      >
        <span>Community Action Agency</span>
        <span class="shrink-0" aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>

      <a
        href="https://www.aarp.org/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-14 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-center shadow-sm transition-colors hover:text-sky-700 hover:border-sky-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
      >
        <span>AARP</span>
        <span class="shrink-0" aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>

      <a
        href="https://www.servinglogan.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-14 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-center shadow-sm transition-colors hover:text-sky-700 hover:border-sky-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
      >
        <span>Logan Community Services (DV Support)</span>
        <span class="shrink-0" aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>

      <span
        class="flex min-h-14 items-center justify-center rounded-lg border border-slate-200 bg-white px-4 py-2 text-center shadow-sm sm:col-span-2 sm:w-[calc((100%-1rem)/2)] sm:justify-self-center lg:col-span-1 lg:col-start-2 lg:w-full"
      >
        Central OK Workforce Programs
      </span>
    </div>
  </div>
</section>
</Layout>
