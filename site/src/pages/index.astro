---
import Layout from "../layouts/main.astro";
import { Image, getImage } from "astro:assets";
import aerialImage from "../assets/aerial.jpg";
import { optional } from "astro:schema";

import unitedWayPartnerLogo from "../assets/partners/united-way-logo-HHG.jpg";
import drugCourtLogo from "../assets/partners/logan-county-drug-court-logo.png";
import godsFoodBankLogo from "../assets/partners/gods-food-bank-logo.jpg";
import communityActionLogo from "../assets/partners/community-action-logo.jpg";
import aarpLogo from "../assets/partners/aarp-logo.svg";
import loganCommunityLogo from "../assets/partners/lcs-logo.png";
import Spotlight from "../components/Spotlight.astro"

const optimizedAerialImage = await getImage({
  src: aerialImage,
  format: "webp",
  quality: 60,
});
---

<Layout title="Home">
  <!-- Homepage Hero -->
  <section class="relative overflow-hidden bg-sky-50 lg:bg-slate-900">
    <img
      src={optimizedAerialImage.src}
      width={optimizedAerialImage.attributes.width}
      height={optimizedAerialImage.attributes.height}
      alt="Aerial view of Hope House Guthrie and its surrounding grounds"
      loading="eager"
      fetchpriority="high"
      class="block w-full h-auto lg:absolute lg:inset-0 lg:h-full lg:object-cover lg:object-center"
    />

    <div
      class="hidden lg:block absolute inset-0 bg-gradient-to-r from-sky-950/80 to-slate-900/40"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 lg:py-20 lg:min-h-[calc(100vh-108px)] lg:flex lg:items-center"
    >
      <div class="max-w-3xl lg:translate-x-15">
        <span
          class="inline-block bg-sky-100 text-sky-700 lg:bg-sky-900/80 lg:text-sky-300 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-4 border border-sky-200 lg:border-sky-700"
        >
          Serving Oklahoma
        </span>

        <h1
          class="text-4xl sm:text-5xl lg:text-6xl text-sky-700 lg:text-white font-extrabold tracking-tight leading-tight mb-5 lg:mb-6"
        >
          Hope Starts Here.
        </h1>

        <p
          class="text-lg sm:text-xl text-slate-700 lg:text-slate-200 mb-6 leading-relaxed max-w-xl"
        >
          Hope House Guthrie provides shelter, meals, clothing, recovery
          support, and a path towards stability for people from across Oklahoma
          who need a place to begin again.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/contact#client-inquiry"
            class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-8 py-3.5 rounded-lg text-center shadow-sm transition-colors"
          >
            Get Help
          </a>

          <a
            href="/donate"
            class="bg-white text-sky-700 border border-sky-300 hover:bg-sky-100 lg:bg-white/30 lg:text-white lg:border-white/20 lg:hover:bg-white/20 font-semibold px-8 py-3.5 rounded-lg text-center transition-colors"
          >
            Support Hope House
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Services Grid -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-3xl font-bold text-sky-700">
          Serving Hope &amp; Moving Forward
        </h2>

        <div
          class="w-full h-1 bg-sky-500 rounded-full mx-auto mt-4 mb-5"
          aria-hidden="true"
        >
        </div>

        <p class="text-slate-900 leading-relaxed">
          We advocate for every person who comes through our doors, offering
          short-term shelter, long-term stabilization, and community care.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div
          class="hope-frame hope-frame-accent flex flex-col bg-sky-50 p-6"
        >
          <div
            class="w-12 h-12 bg-sky-100 rounded-lg flex items-center justify-center text-xl mb-4"
            aria-hidden="true"
          >
            🍲
          </div>

          <h3 class="text-xl font-bold text-slate-900 mb-2">
            Community Lunch &amp; Walk-In Services
          </h3>

          <p class="text-slate-800 text-sm leading-relaxed mb-6">
            Serving daily hot lunches from 11:00 AM – 1:00 PM. Walk-in services
            include showers, clothing, and hygiene toiletries until 5:00 PM.
          </p>

          <a
            href="/programs#soup-kitchen"
            class="mt-auto self-start text-sky-700 text-sm font-semibold hover:underline"
          >
            Learn More &rarr;
          </a>
        </div>

        <div
          class="hope-frame hope-frame-accent flex flex-col bg-sky-50 p-6"
        >
          <div
            class="w-12 h-12 bg-amber-100 rounded-lg flex items-center justify-center text-xl mb-4"
            aria-hidden="true"
          >
            🏠
          </div>

          <h3 class="text-xl font-bold text-slate-900 mb-2">
            Transitional Housing
          </h3>

          <p class="text-slate-800 text-sm leading-relaxed mb-6">
            Transitional housing with structured support to help individuals
            work toward stability, independence, and their next step forward.
          </p>

          <a
            href="/programs#housing"
            class="mt-auto self-start text-sky-700 text-sm font-semibold hover:underline"
          >
            Learn More &rarr;
          </a>
        </div>

        <div
          class="hope-frame hope-frame-accent flex flex-col bg-sky-50 p-6"
        >
          <div
            class="w-12 h-12 bg-emerald-100 rounded-lg flex items-center justify-center text-xl mb-4"
            aria-hidden="true"
          >
            🌱
          </div>

          <h3 class="text-xl font-bold text-slate-900 mb-2">
            Recovery &amp; Support
          </h3>

          <p class="text-slate-800 text-sm leading-relaxed mb-6">
            Narcotics Anonymous (NA) meetings, recovery support, job transition,
            budgeting, and connections to community resources.
          </p>

          <a
            href="/programs#recovery"
            class="mt-auto self-start text-sky-700 text-sm font-semibold hover:underline"
          >
            Learn More &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <Spotlight />

  <!-- Our Impact -->
  <section class="py-12 lg:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h2 class="text-3xl font-bold text-sky-700">Our Impact</h2>

        <div
          class="w-full h-1 bg-sky-500 rounded-full mx-auto mt-4 mb-4"
          aria-hidden="true"
        >
        </div>

        <p class="text-slate-600">
          Meals, essential resources, and hope for our community.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
        <div
          class="hope-frame hope-frame-accent bg-white px-6 py-8 text-center"
        >
          <div class="text-3xl mb-3" aria-hidden="true">🍲</div>

          <h3 class="text-xl font-bold text-sky-700">Meals Served</h3>

          <p class="mt-3 text-slate-600 text-sm">
            Community meal totals coming soon
          </p>
        </div>

        <div
          class="hope-frame hope-frame-accent bg-white px-6 py-8 text-center"
        >
          <div class="text-3xl mb-3" aria-hidden="true">📦</div>

          <h3 class="text-xl font-bold text-sky-700">Food Boxes Distributed</h3>

          <p class="mt-3 text-slate-600 text-sm">
            Food distribution totals coming soon
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Community Partners -->
  <section class="py-7 bg-sky-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-center text-xs font-semibold uppercase tracking-wider text-slate-500 mb-8"
      >
        Trusted Community Partners &amp; Supporters
      </h2>

      <div
        class="flex flex-wrap items-center justify-center gap-x-8 gap-y-6 max-w-5xl mx-auto"
      >
        {
          [
            {
              name: "United Way of Logan County",
              logo: unitedWayPartnerLogo,
              href: "https://unitedwayokc.org/partnerships/united-way-of-logan-county/partner-agencies/",
            },
            {
              name: "Logan County Drug Court",
              logo: drugCourtLogo,
              href: "https://logancodrugcourt.org/",
            },
            {
              name: "God's Food Bank",
              logo: godsFoodBankLogo,
              href: "https://www.godsfoodbank.org/",
            },
            {
              name: "Community Action Agency",
              logo: communityActionLogo,
              href: "https://cocaa.org/logan-county/",
            },
            {
              name: "AARP",
              logo: aarpLogo,
              href: "https://www.aarp.org/",
            },
            {
              name: "Logan Community Services",
              logo: loganCommunityLogo,
              href: "https://www.servinglogan.com/",
            },
          ].map((partner) => (
            <a
              href={partner.href}
              target="_blank"
              rel="noopener noreferrer"
              class="hope-frame group flex h-28 w-full max-w-64 items-center justify-center bg-white p-3 sm:w-[calc((100%-2rem)/2)] lg:w-[calc((100%-4rem)/3)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
            >
              <Image
                src={partner.logo}
                alt={partner.name}
                width={320}
                format={partner.logo.format === "svg" ? undefined : "webp"}
                loading="lazy"
                class="max-h-24 h-auto w-auto max-w-full object-contain transition-transform duration-200 group-hover:scale-105 motion-reduce:transform-none"
              />
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          ))
        }

        <div
          class="flex min-h-20 w-full max-w-64 items-center justify-center px-3 text-center text-sm font-semibold text-slate-600"
        >
          Central OK Workforce Programs
        </div>
      </div>
    </div>
  </section>
</Layout>
