---
import Layout from "../layouts/main.astro";
import PageHeader from "../components/PageHeader.astro";

const donationUrl =
  "https://www.paypal.com/cgi-bin/webscr?cmd=_donations&business=hopehouseguthrie@yahoo.com&item_name=Adopt-a-Room%20-%20Hope%20House%20Guthrie&currency_code=USD";

const supportAreas = [
  {
    icon: "🏠",
    title: "A Safe Place to Stay",
    description:
      "Help sustain a welcoming place for people working toward stability and their next step forward.",
  },
  {
    icon: "🤝",
    title: "Support Along the Way",
    description:
      "Support a residential program built around encouragement, accountability, and practical life skills.",
  },
  {
    icon: "🌱",
    title: "Room to Begin Again",
    description:
      "Help keep shelter and support available as residents rebuild routines and work toward independence.",
  },
];
---

<Layout title="Adopt a Room">
  <PageHeader
    title="Adopt a Room. Make Space for Hope."
    description="Help sustain a safe, welcoming place for someone rebuilding their life through a monthly donation of $40 or more."
  />

  <section class="bg-white py-12 sm:py-16" aria-labelledby="room-support-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
            A Place to Begin Again
          </p>

          <h2
            id="room-support-title"
            class="mt-3 text-3xl font-bold leading-tight text-sky-700"
          >
            More Than a Room. A Chance to Move Forward.
          </h2>

          <div
            class="mt-4 h-1 w-full rounded-full bg-sky-700"
            aria-hidden="true"
          >
          </div>

          <p class="mt-5 leading-relaxed text-slate-700">
            Having a safe place to stay gives people space to focus on what
            comes next. At Hope House Guthrie, residents work toward recovery,
            stability, and independence with support along the way.
          </p>

          <p class="mt-4 leading-relaxed text-slate-700">
            Through Adopt-a-Room, your monthly gift helps sustain the shelter
            and residential support that make those next steps possible.
          </p>

          <a
            href="#choose-room"
            class="hope-action mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-emerald-600 px-6 py-3 font-bold text-white transition-colors hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700 sm:w-auto"
          >
            Become a Room Sponsor →
          </a>
        </div>

        <div
          class="hope-frame hope-frame-accent bg-sky-50 p-8 text-center sm:p-10"
        >
          <div
            class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-sky-100 text-5xl"
            aria-hidden="true"
          >
            🏠
          </div>

          <p
            class="mt-6 text-sm font-bold uppercase tracking-wider text-sky-700"
          >
            Adopt-a-Room
          </p>

          <p class="mt-3 text-5xl font-extrabold text-sky-700">
            $40<span class="text-2xl">+</span>
          </p>

          <p class="mt-2 font-semibold text-slate-700">
            Minimum monthly donation
          </p>

          <p class="mx-auto mt-5 max-w-sm leading-relaxed text-slate-700">
            A steady commitment to helping Hope House remain a place of shelter,
            encouragement, and new beginnings.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-sky-50 py-12 sm:py-16" aria-labelledby="support-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 text-center">
        <h2 id="support-title" class="text-3xl font-bold text-sky-700">
          What Your Support Helps Make Possible
        </h2>

        <div class="mt-4 h-1 w-full rounded-full bg-sky-700" aria-hidden="true">
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          supportAreas.map((area) => (
            <article class="hope-frame hope-frame-accent bg-white p-6">
              <span
                class="mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-sky-100 text-3xl"
                aria-hidden="true"
              >
                {area.icon}
              </span>

              <h3 class="text-xl font-bold text-sky-700">{area.title}</h3>

              <p class="mt-3 text-sm leading-relaxed text-slate-700">
                {area.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Demo room sponsorship cards — replace before publishing -->
  <section
    id="choose-room"
    class="scroll-mt-64 bg-white py-12 sm:py-16 md:scroll-mt-40"
    aria-labelledby="choose-room-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 text-center">
        <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
          Make a Connection
        </p>

        <h2 id="choose-room-title" class="mt-3 text-3xl font-bold text-sky-700">
          Choose a Room to Sponsor
        </h2>

        <div class="mt-4 h-1 w-full rounded-full bg-sky-700" aria-hidden="true">
        </div>

        <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-slate-700">
          Help make room for rest, encouragement, and a new beginning through a
          monthly sponsorship of $40 or more.
        </p>

        <p
          class="mx-auto mt-4 max-w-2xl rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900"
        >
          Concept preview for review: these room names, descriptions, and
          sponsorship statuses are fictional. Demo selections do not reserve a
          room or start a donation.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <article
          class="hope-frame hope-frame-accent flex flex-col bg-sky-50 p-6"
        >
          <div
            class="mb-5 flex h-24 items-center justify-center rounded-xl bg-sky-100 text-5xl"
            aria-hidden="true"
          >
            🏠
          </div>

          <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
            Demo · Available to Sponsor
          </p>

          <h3 class="mt-2 text-2xl font-bold text-sky-700">Room of Hope</h3>

          <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-700">
            A welcoming space to catch your breath, find encouragement, and
            begin taking the next steps toward stability.
          </p>

          <p class="mt-5 font-bold text-slate-900">$40+ per month</p>

          <button
            type="button"
            data-demo-room="Room of Hope"
            class="hope-action mt-4 min-h-11 rounded-lg bg-emerald-600 px-5 py-3 font-bold text-white transition-colors hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700"
          >
            Select This Room · Demo
          </button>
        </article>

        <article
          class="hope-frame hope-frame-accent flex flex-col bg-sky-50 p-6"
        >
          <div
            class="mb-5 flex h-24 items-center justify-center rounded-xl bg-sky-100 text-5xl"
            aria-hidden="true"
          >
            🌱
          </div>

          <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
            Demo · Available to Sponsor
          </p>

          <h3 class="mt-2 text-2xl font-bold text-sky-700">Room of Renewal</h3>

          <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-700">
            Space to build healthy routines, work toward personal goals, and
            move forward with support along the way.
          </p>

          <p class="mt-5 font-bold text-slate-900">$40+ per month</p>

          <button
            type="button"
            data-demo-room="Room of Renewal"
            class="hope-action mt-4 min-h-11 rounded-lg bg-emerald-600 px-5 py-3 font-bold text-white transition-colors hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700"
          >
            Select This Room · Demo
          </button>
        </article>

        <article
          class="hope-frame hope-frame-accent flex flex-col bg-sky-50 p-6"
        >
          <div
            class="mb-5 flex h-24 items-center justify-center rounded-xl bg-sky-100 text-5xl"
            aria-hidden="true"
          >
            ☀️
          </div>

          <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
            Demo · Sponsored
          </p>

          <h3 class="mt-2 text-2xl font-bold text-sky-700">
            Room of New Beginnings
          </h3>

          <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-700">
            A place to look ahead, rebuild confidence, and prepare for greater
            independence.
          </p>

          <p class="mt-5 font-bold text-slate-900">
            Supported by a caring donor
          </p>

          <div
            class="mt-4 flex min-h-11 items-center justify-center rounded-lg border border-sky-200 bg-sky-100 px-5 py-3 font-bold text-sky-700"
          >
            Already Sponsored · Demo
          </div>
        </article>
      </div>

      <!-- Fictional story for concept review -->
      <article class="hope-frame hope-frame-accent mt-8 bg-sky-50 p-6 sm:p-8">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
          <div
            class="flex h-24 w-24 shrink-0 items-center justify-center self-center rounded-full bg-sky-100 text-4xl sm:self-start"
            aria-hidden="true"
          >
            👤
          </div>

          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
              Fictional Person &amp; Story · Demo Only
            </p>

            <h3 class="mt-2 text-2xl font-bold text-sky-700">Meet Alex</h3>

            <p class="mt-3 leading-relaxed text-slate-700">
              Alex came to Hope House looking for a safe place to begin again
              after experiencing homelessness and struggling with addiction.
              With a stable place to stay, encouragement, and recovery support,
              Alex began building healthy routines and working toward employment
              and independent housing.
            </p>

            <blockquote class="mt-5 border-l-4 border-sky-700 pl-4">
              <p class="italic leading-relaxed text-slate-700">
                “Having somewhere safe to sleep gave me the chance to focus on
                tomorrow. For the first time in a long time, I could see a way
                forward.”
              </p>
              <footer class="mt-2 text-sm font-semibold text-sky-700">
                — Alex, fictional sample testimonial
              </footer>
            </blockquote>

            <p class="mt-5 text-sm text-slate-600">
              This sample demonstrates how an approved story could appear. Alex
              is not a real client and is not assigned to any room shown.
            </p>
          </div>
        </div>
      </article>

      <div
        id="demo-room-selection"
        class="hope-frame mt-8 hidden bg-sky-50 p-6 text-center"
      >
        <p
          id="demo-room-message"
          role="status"
          aria-live="polite"
          class="font-semibold text-sky-700"
        >
        </p>

        <p class="mt-3 text-sm leading-relaxed text-slate-700">
          In the finished version, the selected sponsorship would carry through
          to the monthly giving process. This preview does not save a selection
          or process a payment.
        </p>
      </div>
    </div>
  </section>

  <script>
    const demoSelection = document.getElementById("demo-room-selection");
    const demoMessage = document.getElementById("demo-room-message");

    document
      .querySelectorAll<HTMLButtonElement>("[data-demo-room]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          if (!demoSelection || !demoMessage) return;

          demoSelection.classList.remove("hidden");
          demoMessage.textContent = `Demo selection: ${button.dataset.demoRoom} — $40+ per month.`;

          demoSelection.scrollIntoView({
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
              .matches
              ? "auto"
              : "smooth",
            block: "center",
          });
        });
      });
  </script>

  <section
    id="sponsor"
    class="scroll-mt-64 bg-white py-12 sm:py-16 md:scroll-mt-40"
    aria-labelledby="sponsor-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 text-center">
        <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
          Make Room for Hope
        </p>

        <h2 id="sponsor-title" class="mt-3 text-3xl font-bold text-sky-700">
          Become an Adopt-a-Room Sponsor
        </h2>

        <div class="mt-4 h-1 w-full rounded-full bg-sky-700" aria-hidden="true">
        </div>

        <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-slate-700">
          Choose a monthly gift of $40 or more. Contact our team if you need
          help arranging your sponsorship.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <article
          class="hope-frame hope-frame-accent flex flex-col bg-sky-50 p-6 sm:p-8"
        >
          <h3 class="text-xl font-bold text-sky-700">Give Online</h3>

          <p class="mt-3 leading-relaxed text-slate-700">
            Open our PayPal donation page to make your gift. If a monthly giving
            option is available, select it to set up your sponsorship.
            Otherwise, contact our team to arrange monthly giving.
          </p>

          <a
            href={donationUrl}
            class="hope-action mt-6 inline-flex min-h-11 items-center justify-center rounded-lg bg-emerald-600 px-6 py-3 text-center font-bold text-white transition-colors hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700"
          >
            Give Through PayPal →
          </a>
        </article>

        <article class="hope-frame hope-frame-accent bg-sky-50 p-6 sm:p-8">
          <h3 class="text-xl font-bold text-sky-700">Give by Check</h3>

          <p class="mt-3 text-slate-700">Make checks payable to:</p>
          <p class="mt-2 font-bold text-slate-900">NHD - HOPE HOUSE GUTHRIE</p>

          <p class="mt-4 leading-relaxed text-slate-700">
            Mail to:<br />
            PO Box 491<br />
            Guthrie, OK 73044
          </p>

          <p class="mt-4 text-sm leading-relaxed text-slate-700">
            Write “Adopt-a-Room” in the memo line so our team can identify your
            sponsorship gift.
          </p>
        </article>
      </div>

      <div class="mt-8 text-center">
        <p class="text-slate-700">Questions about sponsoring a room?</p>

        <a
          href="tel:4058870288"
          class="mt-2 inline-block rounded font-bold text-sky-700 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
        >
          Call Admin: (405) 887-0288
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-sky-200 bg-sky-50 py-10">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="text-xl font-bold text-sky-700">
        Thank You for Making Space for Hope
      </h2>

      <p class="mt-3 leading-relaxed text-slate-700">
        Your support helps people find a place to begin again and take
        meaningful steps toward a more stable future.
      </p>

      <a
        href="/donate"
        class="mt-5 inline-block font-semibold text-sky-700 hover:underline"
      >
        Explore Other Ways to Give →
      </a>
    </div>
  </section>
</Layout>
