---
import Layout from "../layouts/main.astro";
import PageHeader from "../components/PageHeader.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import hopeLogo from "../assets/logo.svg";
import paypalLogo from "../assets/paypal-logo.jpg";

const allStories = (await getCollection("testimonials"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data);

// Include all stories; the browser randomly displays two.
const stories = allStories;

const donationUrl =
  "https://www.paypal.com/cgi-bin/webscr?cmd=_donations&business=hopehouseguthrie@yahoo.com&item_name=Adopt-a-Room%20-%20Hope%20House%20Guthrie&currency_code=USD";
---

<Layout title="Adopt a Room">
  <PageHeader
    title="Adopt a Room. Make Space for Hope."
    description="Help sustain safe shelter and support for people rebuilding their lives, with monthly giving levels starting at $20."
  />

  <section class="bg-white py-12 sm:py-16" aria-labelledby="room-support-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
            A Place to Begin Again
          </p>

          <h2
            id="room-support-title"
            class="mt-3 text-3xl font-bold leading-tight text-sky-700"
          >
            More Than a Room. A Chance to Move Forward.
          </h2>

          <div
            class="mt-4 h-1 w-full rounded-full bg-sky-700"
            aria-hidden="true"
          >
          </div>

          <p class="mt-5 leading-relaxed text-slate-700">
            Having a safe place to stay gives people space to focus on what
            comes next. At Hope House Guthrie, residents work toward recovery,
            stability, and independence with support along the way.
          </p>

          <p class="mt-4 leading-relaxed text-slate-700">
            Through Adopt-a-Room, your monthly gift helps sustain the shelter
            and residential support that make those next steps possible.
          </p>

          <a
            href="#choose-room"
            class="hope-action mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-emerald-600 px-6 py-3 font-bold text-white transition-colors hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700 sm:w-auto"
          >
            Become a Room Sponsor →
          </a>
        </div>

        <div
          class="hope-frame hope-frame-accent bg-sky-50 p-8 text-center sm:p-10"
        >
          <div
            class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-sky-100 text-5xl"
            aria-hidden="true"
          >
            🏠
          </div>

          <p
            class="mt-6 text-sm font-bold uppercase tracking-wider text-sky-700"
          >
            Adopt-a-Room
          </p>

          <p class="mt-3 text-5xl font-extrabold text-sky-700">
            $20<span class="text-2xl">+</span>
          </p>

          <p class="mt-2 font-semibold text-slate-700">
            Monthly giving starts here
          </p>

          <p class="mx-auto mt-5 max-w-sm leading-relaxed text-slate-700">
            Choose a giving level of $20, $30, or $40 per month to help sustain
            shelter, encouragement, and opportunities for a new beginning.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    id="choose-room"
    class="scroll-mt-64 bg-sky-50 py-12 sm:py-16 md:scroll-mt-40"
    aria-labelledby="support-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 text-center">
        <h2 id="support-title" class="text-3xl font-bold text-sky-700">
          Choose Your Monthly Giving Level
        </h2>

        <p class="mt-3 text-slate-700">
          Select a card to continue to payment with your chosen amount.
        </p>

        <div class="mt-4 h-1 w-full rounded-full bg-sky-700" aria-hidden="true">
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          [
            {
              name: "Room of Hope",
              amount: 20,
              icon: "🏠",
              description:
                "Help make space for safety, encouragement, and the first steps toward stability.",
            },
            {
              name: "Room of Renewal",
              amount: 30,
              icon: "🌱",
              description:
                "Help sustain a welcoming place where residents can build healthy routines and work toward their goals.",
            },
            {
              name: "Room of New Beginnings",
              amount: 40,
              icon: "☀️",
              description:
                "Help strengthen the shelter and ongoing support that allow residents to prepare for greater independence.",
            },
          ].map((level) => (
            <a
              href="#demo-room-selection"
              data-demo-room={level.name}
              data-demo-amount={level.amount}
              aria-label={`Choose ${level.name}: $${level.amount} per month`}
              class="hope-frame hope-frame-accent flex flex-col bg-sky-50 p-6 no-underline transition-colors hover:bg-sky-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
            >
              <div
                class="mb-5 flex h-24 items-center justify-center rounded-xl bg-sky-100 text-5xl"
                aria-hidden="true"
              >
                {level.icon}
              </div>

              <h3 class="text-2xl font-bold text-sky-700">{level.name}</h3>

              <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-700">
                {level.description}
              </p>

              <p class="mt-5 text-xl font-bold text-slate-900">
                ${level.amount} per month
              </p>
            </a>
          ))
        }
      </div>

      <div class="mt-6 flex items-center justify-center gap-3">
        <span class="text-sm text-slate-600">
          Secure payment through PayPal
        </span>

        <Image
          src={paypalLogo}
          alt="PayPal"
          width={100}
          loading="lazy"
          class="h-auto w-20 shrink-0 object-contain"
        />
      </div>

      <!-- Client stories -->
      <div id="random-client-stories" class="mt-8 space-y-8">
        {
          stories.map((story, index) => (
            <article
              data-story-card
              hidden={index >= 2}
              class="hope-frame hope-frame-accent bg-white p-6 sm:p-8"
            >
              <div class="grid gap-6 md:grid-cols-[16rem_minmax(0,1fr)]">
                <div
                  class="flex flex-col"
                  data-photo-transition={story.beforePhoto ? "" : undefined}
                >
                  {story.photo ? (
                    <div
                      class:list={[
                        "story-photo-frame relative overflow-hidden rounded-xl",
                        story.videoUrl ? "aspect-[4/3]" : "min-h-72 flex-1",
                      ]}
                      style={`--story-liquid-filter: url(#room-story-liquid-${index})`}
                    >
                      {story.beforePhoto && (
                        <svg
                          class="pointer-events-none absolute h-0 w-0"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <defs>
                            <filter
                              id={`room-story-liquid-${index}`}
                              x="-25%"
                              y="-25%"
                              width="150%"
                              height="150%"
                              color-interpolation-filters="sRGB"
                            >
                              <feTurbulence
                                type="fractalNoise"
                                baseFrequency="0.012 0.025"
                                numOctaves="2"
                                seed={index + 3}
                                result="liquid-noise"
                              />
                              <feDisplacementMap
                                data-liquid-displacement
                                in="SourceGraphic"
                                in2="liquid-noise"
                                scale="0"
                                xChannelSelector="R"
                                yChannelSelector="G"
                              />
                            </filter>
                          </defs>
                        </svg>
                      )}
                      {story.beforePhoto && (
                        <div class="story-photo-before absolute inset-0">
                          <Image
                            src={story.beforePhoto}
                            alt={`Earlier photo of ${story.name}`}
                            width={640}
                            format="webp"
                            quality={80}
                            loading="lazy"
                            class="h-full w-full object-cover"
                            style={{
                              objectPosition: story.beforePhotoPosition,
                            }}
                          />
                          <span class="absolute bottom-3 left-3 rounded-md bg-sky-700 px-3 py-1 text-sm font-semibold text-white">
                            Intake
                          </span>
                        </div>
                      )}

                      <div
                        class:list={[
                          "absolute inset-0",
                          story.beforePhoto && "story-photo-now",
                        ]}
                      >
                        <Image
                          src={story.photo}
                          alt={`Recent portrait of ${story.name}`}
                          width={640}
                          format="webp"
                          quality={80}
                          loading="lazy"
                          class="h-full w-full object-cover"
                          style={{ objectPosition: story.photoPosition }}
                        />
                        {story.beforePhoto && (
                          <span class="absolute bottom-3 left-3 rounded-md bg-sky-700 px-3 py-1 text-sm font-semibold text-white">
                            Current
                          </span>
                        )}
                      </div>
                    </div>
                  ) : (
                    <div class="flex min-h-72 flex-1 items-center justify-center rounded-xl bg-sky-50 p-8">
                      <Image
                        src={hopeLogo}
                        alt="Hope House Guthrie"
                        width={240}
                        loading="lazy"
                        class="h-auto w-full object-contain"
                      />
                    </div>
                  )}

                  {story.videoUrl && (
                    <a
                      href={story.videoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hope-action mt-4 inline-flex min-h-11 items-center justify-center rounded-lg bg-sky-700 px-4 py-3 text-center text-sm font-bold text-white hover:bg-sky-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
                    >
                      Watch {story.name}’s Story ↗
                    </a>
                  )}
                </div>

                <div class="min-w-0">
                  <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
                    Stories of Hope
                  </p>

                  <h3 class="mt-2 text-2xl font-bold text-sky-700">
                    Meet {story.name}
                  </h3>

                  {story.paragraphs.map((paragraph) => (
                    <p class="mt-3 leading-relaxed text-slate-700">
                      {paragraph}
                    </p>
                  ))}

                  {story.quote && (
                    <blockquote class="mt-5 border-l-4 border-sky-700 pl-4">
                      <p class="italic leading-relaxed text-slate-700">
                        “{story.quote}”
                      </p>
                      <footer class="mt-2 text-sm font-semibold text-sky-700">
                        {story.name}
                      </footer>
                    </blockquote>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-8 text-center">
        <a
          href="/testimonials"
          class="inline-flex min-h-11 items-center justify-center font-semibold text-sky-700 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
        >
          See More Stories of Hope →
        </a>
      </div>
    </div>
  </section>

  <div
    id="demo-room-selection"
    class="hope-frame mt-8 hidden bg-sky-50 p-6 text-center"
  >
    <p
      id="demo-room-message"
      role="status"
      aria-live="polite"
      class="font-semibold text-sky-700"
    >
    </p>

    <p class="mt-3 text-sm leading-relaxed text-slate-700">
      In the finished version, the selected sponsorship would carry through to
      the monthly giving process. This preview does not save a selection or
      process a payment.
    </p>
  </div>

  <script>
    const demoSelection = document.getElementById("demo-room-selection");
    const demoMessage = document.getElementById("demo-room-message");

    document
      .querySelectorAll<HTMLAnchorElement>("[data-demo-room]")
      .forEach((button) => {
        button.addEventListener("click", (event) => {
          event.preventDefault();
          if (!demoSelection || !demoMessage) return;

          demoSelection.classList.remove("hidden");
          demoMessage.textContent = `Demo selection: ${button.dataset.demoRoom} - $${button.dataset.demoAmount} per month.`;

          demoSelection.scrollIntoView({
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
              .matches
              ? "auto"
              : "smooth",
            block: "center",
          });
        });
      });
  </script>

  <section
    id="sponsor"
    class="scroll-mt-64 bg-white py-12 sm:py-16 md:scroll-mt-40"
    aria-labelledby="sponsor-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 text-center">
        <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
          Make Room for Hope
        </p>

        <h2 id="sponsor-title" class="mt-3 text-3xl font-bold text-sky-700">
          Become an Adopt-a-Room Sponsor
        </h2>

        <div class="mt-4 h-1 w-full rounded-full bg-sky-700" aria-hidden="true">
        </div>

        <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-slate-700">
          Monthly giving levels start at $20. Contact our team for help
          arranging your Adopt-a-Room sponsorship.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <article
          class="hope-frame hope-frame-accent flex flex-col bg-sky-50 p-6 sm:p-8"
        >
          <h3 class="text-xl font-bold text-sky-700">Give Online</h3>

          <p class="mt-3 leading-relaxed text-slate-700">
            Open our PayPal donation page to make your gift. If a monthly giving
            option is available, select it to set up your sponsorship.
            Otherwise, contact our team to arrange monthly giving.
          </p>

          <a
            href={donationUrl}
            class="hope-action mt-6 inline-flex min-h-11 items-center justify-center rounded-lg bg-emerald-600 px-6 py-3 text-center font-bold text-white transition-colors hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700"
          >
            Give Through PayPal →
          </a>

          <div class="mt-4 flex items-center justify-center gap-3">
            <span class="text-xs text-slate-500">
              Secure payment through PayPal
            </span>

            <Image
              src={paypalLogo}
              alt="PayPal"
              width={80}
              loading="lazy"
              class="h-auto w-16 shrink-0 object-contain"
            />
          </div>
        </article>

        <article class="hope-frame hope-frame-accent bg-sky-50 p-6 sm:p-8">
          <h3 class="text-xl font-bold text-sky-700">Give by Check</h3>

          <p class="mt-3 text-slate-700">Make checks payable to:</p>
          <p class="mt-2 font-bold text-slate-900">NHD - HOPE HOUSE GUTHRIE</p>

          <p class="mt-4 leading-relaxed text-slate-700">
            Mail to:<br />
            PO Box 491<br />
            Guthrie, OK 73044
          </p>

          <p class="mt-4 text-sm leading-relaxed text-slate-700">
            Write “Adopt-a-Room” in the memo line so our team can identify your
            sponsorship gift.
          </p>
        </article>
      </div>

      <div class="mt-8 text-center">
        <p class="text-slate-700">Questions about sponsoring a room?</p>

        <a
          href="tel:4058870288"
          class="mt-2 inline-block rounded font-bold text-sky-700 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
        >
          Call Admin: (405) 887-0288
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-sky-200 bg-sky-50 py-10">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="text-xl font-bold text-sky-700">
        Thank You for Making Space for Hope
      </h2>

      <p class="mt-3 leading-relaxed text-slate-700">
        Your support helps people find a place to begin again and take
        meaningful steps toward a more stable future.
      </p>

      <a
        href="/donate"
        class="mt-5 inline-block font-semibold text-sky-700 hover:underline"
      >
        Explore Other Ways to Give →
      </a>
    </div>
  </section>

  <script>
    const container = document.getElementById("random-client-stories");

    if (container) {
      const cards = Array.from(
        container.querySelectorAll<HTMLElement>("[data-story-card]"),
      );

      // Shuffle the cards on each page load.
      for (let i = cards.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [cards[i], cards[j]] = [cards[j], cards[i]];
      }

      cards.forEach((card, index) => {
        card.hidden = index >= 2;
        container.appendChild(card);
      });
    }
  </script>

  <style>
    [data-story-card][hidden] {
      display: none !important;
    }

    .story-photo-before {
      opacity: 0;
    }

    .story-photo-now {
      opacity: 1;
    }

    [data-photo-transition][data-liquid-active]
      .story-photo-before
      :global(img),
    [data-photo-transition][data-liquid-active] .story-photo-now :global(img) {
      filter: var(--story-liquid-filter);
      transform: scale(1.06);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-photo-transition] .story-photo-before {
        opacity: 0 !important;
      }

      [data-photo-transition] .story-photo-now {
        opacity: 1 !important;
      }

      [data-photo-transition] .story-photo-now span {
        opacity: 1 !important;
      }

      [data-photo-transition] :global(img) {
        filter: none !important;
        transform: none !important;
      }
    }
  </style>

  <script>
    function setupRoomStoryPhotos() {
      const container = document.getElementById("random-client-stories");
      if (!container) return;

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const cleanups: Array<() => void> = [];

      container
        .querySelectorAll<HTMLElement>("[data-photo-transition]")
        .forEach((frame) => {
          const before = frame.querySelector<HTMLElement>(
            ".story-photo-before",
          );
          const current = frame.querySelector<HTMLElement>(".story-photo-now");
          const displacement = frame.querySelector<SVGFEDisplacementMapElement>(
            "[data-liquid-displacement]",
          );

          if (!before || !current || !displacement) return;

          const beforeLabel = before.querySelector("span");
          const currentLabel = current.querySelector("span");

          const intakeHold = 4000;
          const transition = 1800;
          const currentHold = 6000;
          const cycle = intakeHold + transition + currentHold + transition;

          let elapsed = 0;
          let lastTime: number | null = null;
          let animationId = 0;
          let visible = false;
          let ready = false;
          let disposed = false;

          const ease = (value: number) => value * value * (3 - 2 * value);

          function render() {
            let amount = 0;
            let strength = 0;

            if (elapsed < intakeHold) {
              amount = 0;
            } else if (elapsed < intakeHold + transition) {
              const progress = (elapsed - intakeHold) / transition;
              amount = ease(progress);
              strength = Math.sin(Math.PI * progress) * 65;
            } else if (elapsed < intakeHold + transition + currentHold) {
              amount = 1;
            } else {
              const progress =
                (elapsed - intakeHold - transition - currentHold) / transition;

              amount = 1 - ease(progress);
              strength = Math.sin(Math.PI * progress) * 65;
            }

            before.style.opacity = "1";
            current.style.opacity = String(amount);
            displacement.setAttribute("scale", strength.toFixed(2));
            frame.toggleAttribute("data-liquid-active", strength > 0.1);

            if (beforeLabel) {
              beforeLabel.style.opacity = amount < 0.5 ? "1" : "0";
            }

            if (currentLabel) {
              currentLabel.style.opacity = amount >= 0.5 ? "1" : "0";
            }
          }

          function shouldRun() {
            return (
              ready &&
              !disposed &&
              visible &&
              !document.hidden &&
              !reducedMotion.matches
            );
          }

          function tick(time: number) {
            animationId = 0;

            if (!shouldRun()) {
              lastTime = null;
              return;
            }

            if (lastTime !== null) {
              elapsed = (elapsed + Math.min(time - lastTime, 100)) % cycle;
            }

            lastTime = time;
            render();
            animationId = requestAnimationFrame(tick);
          }

          function sync() {
            cancelAnimationFrame(animationId);
            animationId = 0;
            lastTime = null;

            if (reducedMotion.matches) {
              frame.removeAttribute("data-liquid-active");
              before.style.opacity = "0";
              current.style.opacity = "1";
              displacement.setAttribute("scale", "0");

              if (currentLabel) currentLabel.style.opacity = "1";
            } else if (ready) {
              render();
            }

            if (shouldRun()) {
              animationId = requestAnimationFrame(tick);
            }
          }

          const observer = new IntersectionObserver(
            ([entry]) => {
              visible = entry.isIntersecting;
              sync();
            },
            { threshold: 0.1 },
          );

          observer.observe(frame);
          reducedMotion.addEventListener("change", sync);
          document.addEventListener("visibilitychange", sync);

          const images = Array.from(
            frame.querySelectorAll<HTMLImageElement>("img"),
          );

          Promise.all(
            images.map(
              (image) =>
                new Promise<void>((resolve) => {
                  if (image.complete) {
                    resolve();
                    return;
                  }

                  image.addEventListener("load", () => resolve(), {
                    once: true,
                  });
                  image.addEventListener("error", () => resolve(), {
                    once: true,
                  });
                }),
            ),
          ).then(() => {
            if (disposed) return;
            ready = images.every((image) => image.naturalWidth > 0);
            sync();
          });

          cleanups.push(() => {
            disposed = true;
            cancelAnimationFrame(animationId);
            observer.disconnect();
            reducedMotion.removeEventListener("change", sync);
            document.removeEventListener("visibilitychange", sync);
          });
        });

      document.addEventListener(
        "astro:before-swap",
        () => cleanups.forEach((cleanup) => cleanup()),
        { once: true },
      );
    }

    setupRoomStoryPhotos();
    document.addEventListener("astro:after-swap", setupRoomStoryPhotos);
  </script>
</Layout>
