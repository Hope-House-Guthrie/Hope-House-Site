---
import Layout from "@/layouts/main/index.astro";
import PageHeader from "@/lib/PageHeader.astro";
import { Image } from "astro:assets";
import paypalLogo from "@/assets/paypal-logo.jpg";

const givingLevels = [10, 25, 50];
---

<Layout title="The 300 Club">
  <PageHeader title="The 300 Club" description="Small Gifts. Steady Hope." />

  <section class="bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
            A Little Each Month. A Community of Hope.
          </p>

          <h2
            class="mt-3 text-3xl font-bold leading-tight text-sky-700 sm:text-4xl"
          >
            Be Part of What Makes Tomorrow Possible.
          </h2>

          <div
            class="mt-4 h-1 w-full rounded-full bg-sky-700"
            aria-hidden="true"
          >
          </div>

          <p class="mt-5 text-lg leading-relaxed text-slate-700">
            Starting at $10 a month, you can help keep Hope House Guthrie ready
            for the next person who needs us.
          </p>

          <p class="mt-4 leading-relaxed text-slate-700">
            A hot meal. A welcoming place. Someone willing to help. These
            everyday moments depend on a community that keeps showing up. The
            300 Club is your invitation to be part of that community.
          </p>

          <a
            href="#join-the-club"
            class="hope-action mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-emerald-600 px-6 py-3 font-bold text-white transition-colors hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700 sm:w-auto"
          >
            Count Me In →
          </a>
        </div>

        <div
          class="hope-frame hope-frame-accent bg-sky-50 p-8 text-center sm:p-10"
        >
          <p class="text-sm font-bold uppercase tracking-wider text-sky-700">
            Small Gifts. Steady Hope.
          </p>

          <p class="mt-5 text-6xl font-extrabold text-sky-700">
            $10<span class="text-2xl"> / month</span>
          </p>

          <p class="mt-4 text-xl font-bold text-slate-900">
            A starting point for lasting support.
          </p>

          <p class="mt-4 leading-relaxed text-slate-700">
            Give $10, $25, $50, or another monthly amount that works for you.
            Every member belongs to the same community of hope.
          </p>

          <p
            class="mt-6 border-t border-sky-200 pt-6 font-semibold text-sky-700"
          >
            You don’t have to give big to be part of something life-changing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    class="bg-sky-50 py-12 sm:py-16"
    aria-labelledby="steady-support-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-8 max-w-2xl text-center">
        <h2 id="steady-support-title" class="text-3xl font-bold text-sky-700">
          Help Keep Hope Showing Up.
        </h2>

        <p class="mt-4 leading-relaxed text-slate-700">
          Monthly support helps Hope House Guthrie plan for everyday needs and
          continue serving our neighbors in Logan County.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <article class="hope-frame hope-frame-accent bg-white p-6 sm:p-8">
          <h3 class="text-xl font-bold text-sky-700">Meals & Connection</h3>
          <p class="mt-3 leading-relaxed text-slate-700">
            Help sustain our daily community lunch and a welcoming place where
            neighbors can share a meal and connect with support.
          </p>
        </article>

        <article class="hope-frame hope-frame-accent bg-white p-6 sm:p-8">
          <h3 class="text-xl font-bold text-sky-700">Everyday Essentials</h3>
          <p class="mt-3 leading-relaxed text-slate-700">
            Help cover utilities, cleaning supplies, and the everyday
            necessities that keep Hope House Guthrie running.
          </p>
        </article>

        <article class="hope-frame hope-frame-accent bg-white p-6 sm:p-8">
          <h3 class="text-xl font-bold text-sky-700">A Place to Turn</h3>
          <p class="mt-3 leading-relaxed text-slate-700">
            Help sustain services and a community where people can find
            encouragement as they work toward recovery and stability.
          </p>
        </article>
      </div>

      <p
        class="mx-auto mt-8 max-w-2xl text-center text-sm leading-relaxed text-slate-600"
      >
        The 300 Club supports the ongoing work of Hope House Guthrie. Gifts help
        meet needs across our services.
      </p>
    </div>
  </section>

  <section class="bg-white py-12 sm:py-16" aria-labelledby="club-story-title">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
        An Idea Worth Growing
      </p>

      <h2 id="club-story-title" class="mt-3 text-3xl font-bold text-sky-700">
        It Started With 300. It Continues With You.
      </h2>

      <p class="mt-5 leading-relaxed text-slate-700">
        The original idea was simple: bring together 300 supporters giving $10 a
        month. Together, those small gifts would provide $3,000 in dependable
        monthly support.
      </p>

      <p class="mt-4 leading-relaxed text-slate-700">
        Today, we’re building on that idea. The 300 Club welcomes monthly gifts
        starting at $10, with room for our community and its support to grow
        beyond the original goal.
      </p>

      <p class="mt-4 leading-relaxed text-slate-700">
        Whether you give $10 or more, you’re part of the same effort: helping
        Hope House Guthrie keep showing up for people who need us.
      </p>
    </div>
  </section>

  <section
    id="join-the-club"
    class="scroll-mt-64 bg-sky-50 py-12 sm:py-16 md:scroll-mt-40"
    aria-labelledby="join-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-8 max-w-2xl text-center">
        <h2 id="join-title" class="text-3xl font-bold text-sky-700">
          Find Your Monthly Fit.
        </h2>

        <p class="mt-4 leading-relaxed text-slate-700">
          Choose an amount that works for you. Our team can help you arrange
          your monthly gift and become part of The 300 Club.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {
          givingLevels.map((amount) => (
            <article class="hope-frame hope-frame-accent flex flex-col bg-white p-6 text-center">
              <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
                The 300 Club
              </p>

              <h3 class="mt-4 text-4xl font-extrabold text-sky-700">
                ${amount}
              </h3>

              <p class="mt-2 text-slate-600">per month</p>

              <a
                href={`mailto:admin@hopehouseguthrie.org?subject=${encodeURIComponent("300 Club Monthly Giving Inquiry")}&body=${encodeURIComponent(`Hello! I'd like to join The 300 Club with a $${amount} monthly gift. Please let me know how to get started.`)}`}
                class="hope-action mt-6 inline-flex min-h-11 items-center justify-center rounded-lg bg-emerald-600 px-4 py-3 font-bold text-white transition-colors hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700"
              >
                Count Me In →
              </a>
            </article>
          ))
        }

        <article
          class="hope-frame hope-frame-accent flex flex-col bg-white p-6 text-center"
        >
          <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
            The 300 Club
          </p>

          <h3 class="mt-4 text-3xl font-extrabold text-sky-700">Your Amount</h3>

          <p class="mt-2 text-slate-600">starting at $10 per month</p>

          <a
            href="tel:4058870288"
            class="hope-action mt-auto inline-flex min-h-11 items-center justify-center rounded-lg bg-emerald-600 px-4 py-3 font-bold text-white transition-colors hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700"
          >
            Let’s Talk →
          </a>
        </article>
      </div>

      <div class="mt-6 flex items-center justify-center gap-3">
        <span class="text-xs text-slate-500">
          PayPal monthly giving coming soon
        </span>

        <Image
          src={paypalLogo}
          alt="PayPal"
          width={80}
          loading="lazy"
          class="h-auto w-16 shrink-0 object-contain"
        />
      </div>

      <div class="mx-auto mt-10 max-w-2xl text-center">
        <p class="leading-relaxed text-slate-700">
          Prefer to arrange your gift by phone?
        </p>

        <a
          href="tel:4058870288"
          class="mt-2 inline-block font-bold text-sky-700 hover:underline"
        >
          Call Admin: (405) 887-0288
        </a>

        <p class="mt-4 text-sm text-slate-600">
          Choosing an amount opens an inquiry. It does not charge you or set up
          a recurring payment.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="text-3xl font-bold text-sky-700">
        See the People Behind the Purpose.
      </h2>

      <p class="mt-4 leading-relaxed text-slate-700">
        Meet people who have found support, built connections, and taken steps
        forward at Hope House Guthrie.
      </p>

      <a
        href="/impact"
        class="hope-action mt-6 inline-flex min-h-11 items-center justify-center rounded-lg bg-sky-700 px-6 py-3 font-bold text-white transition-colors hover:bg-sky-800"
      >
        Read Our Stories of Hope →
      </a>
    </div>
  </section>

  <section class="border-t border-sky-200 bg-sky-50 py-10">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="text-2xl font-bold text-sky-700">
        Small Gifts. Steady Hope. Together.
      </h2>

      <p class="mt-4 leading-relaxed text-slate-700">
        Hope House Guthrie is operated by Neighborhood Hope Dealers, Inc. Your
        support helps keep our work moving forward.
      </p>

      <a
        href="/donate"
        class="mt-5 inline-block font-semibold text-sky-700 hover:underline"
      >
        Explore Other Ways to Give →
      </a>
    </div>
  </section>
</Layout>
