---
import { Image } from "astro:assets";
import paypalLogo from "@/assets/paypal-logo.jpg";
import TestimonialCard from "@/pages/impact/lib/TestimonialCard.astro";

interface Props {
  stories: any[];
}

const { stories } = Astro.props;
---

<section
  id="choose-room"
  class="scroll-mt-64 bg-sky-50 py-12 sm:py-16 md:scroll-mt-40"
  aria-labelledby="support-title"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 text-center">
      <h2 id="support-title" class="text-3xl font-bold text-sky-700">
        Choose Your Monthly Giving Level
      </h2>

      <p class="mt-3 text-slate-700">
        Select a card to continue to payment with your chosen amount.
      </p>

      <div class="mt-4 h-1 w-full rounded-full bg-sky-700" aria-hidden="true">
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        [
          {
            name: "Room of Hope",
            amount: 20,
            icon: "🏠",
            description:
              "Help make space for safety, encouragement, and the first steps toward stability.",
          },
          {
            name: "Room of Renewal",
            amount: 30,
            icon: "🌱",
            description:
              "Help sustain a welcoming place where residents can build healthy routines and work toward their goals.",
          },
          {
            name: "Room of New Beginnings",
            amount: 40,
            icon: "☀️",
            description:
              "Help strengthen the shelter and ongoing support that allow residents to prepare for greater independence.",
          },
        ].map((level) => (
          <a
            href="#demo-room-selection"
            data-demo-room={level.name}
            data-demo-amount={level.amount}
            aria-label={`Choose ${level.name}: $${level.amount} per month`}
            class="hope-frame hope-frame-accent flex flex-col bg-sky-50 p-6 no-underline transition-colors hover:bg-sky-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
          >
            <div
              class="mb-5 flex h-24 items-center justify-center rounded-xl bg-sky-100 text-5xl"
              aria-hidden="true"
            >
              {level.icon}
            </div>

            <h3 class="text-2xl font-bold text-sky-700">{level.name}</h3>

            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-700">
              {level.description}
            </p>

            <p class="mt-5 text-xl font-bold text-slate-900">
              ${level.amount} per month
            </p>
          </a>
        ))
      }
    </div>

    <div class="mt-6 flex items-center justify-center gap-3">
      <span class="text-sm text-slate-600">
        Secure payment through PayPal
      </span>

      <Image
        src={paypalLogo}
        alt="PayPal"
        width={100}
        loading="lazy"
        class="h-auto w-20 shrink-0 object-contain"
      />
    </div>

    <!-- Client stories -->
    <div id="random-client-stories" class="mt-8 space-y-8">
      {
        stories.map((story, index) => (
          <TestimonialCard
            story={story}
            index={index}
            idPrefix="room-story-liquid"
          />
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <a
        href="/impact"
        class="inline-flex min-h-11 items-center justify-center font-semibold text-sky-700 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
      >
        See More Stories of Hope →
      </a>
    </div>
  </div>
</section>

<div
  id="demo-room-selection"
  class="hope-frame mt-8 hidden bg-sky-50 p-6 text-center"
>
  <p
    id="demo-room-message"
    role="status"
    aria-live="polite"
    class="font-semibold text-sky-700"
  >
  </p>

  <p class="mt-3 text-sm leading-relaxed text-slate-700">
    In the finished version, the selected sponsorship would carry through to
    the monthly giving process. This preview does not save a selection or
    process a payment.
  </p>
</div>

<script>
  const demoSelection = document.getElementById("demo-room-selection");
  const demoMessage = document.getElementById("demo-room-message");

  document
    .querySelectorAll<HTMLAnchorElement>("[data-demo-room]")
    .forEach((button) => {
      button.addEventListener("click", (event) => {
        event.preventDefault();
        if (!demoSelection || !demoMessage) return;

        demoSelection.classList.remove("hidden");
        demoMessage.textContent = `Demo selection: ${button.dataset.demoRoom} - $${button.dataset.demoAmount} per month.`;

        demoSelection.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
            .matches
            ? "auto"
            : "smooth",
          block: "center",
        });
      });
    });
</script>