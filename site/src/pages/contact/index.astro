---
import Layout from "@/layouts/main/index.astro";
import PageHeader from "@/lib/PageHeader.astro";
import ContactInfo from "./lib/ContactInfo.astro";
import ServicesHoursCard from "./lib/ServicesHoursCard.astro";
import SupportGroupCard from "./lib/SupportGroupCard.astro";
import ClientInquiryForm from "@/forms/ClientInquiryForm.astro";
import Container from "@/lib/Container.astro";
---

<Layout title="Contact Us">
  <PageHeader
    title="Contact Hope House Guthrie"
    description="Whether you need assistance, have questions about our programs, or want to support our work, we're here to help connect you with the right information."
  />

  <section class="py-16 bg-white">
    <Container>
      <div class="grid md:grid-cols-2 gap-12">
        <ContactInfo />
        <ServicesHoursCard />
      </div>
    </Container>
  </section>

  <section
    id="meeting-inquiries"
    class="scroll-mt-64 bg-white pb-16 md:scroll-mt-40"
    aria-labelledby="meeting-inquiries-title"
  >
    <Container>
      <SupportGroupCard />
    </Container>
  </section>

  <ClientInquiryForm />
</Layout>