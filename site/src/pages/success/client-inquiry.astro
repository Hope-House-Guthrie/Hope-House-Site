---
import SubmissionConfirmationLayout from "./lib/SubmissionConfirmationLayout.astro";
import NoticeCard from "./lib/NoticeCard.astro";
---

<SubmissionConfirmationLayout
  metaTitle="Client Inquiry Submitted"
  headerTitle="Inquiry Received"
  headerDescription="Thank you for reaching out to Hope House Guthrie. Your information has been securely submitted to our administration team."
  cardTitle="Thank You for Your Inquiry"
  cardSubtitle="Our team has received your submission."
  secondaryButtonHref="/programs"
  secondaryButtonLabel="Explore Programs & Services"
>
  <p>
    Your inquiry has been received, and our administration team will be notified.
  </p>

  <p>
    If a bed is available and you meet our placement requirements, including background checks, someone from our team will contact you.
  </p>

  <NoticeCard variant="amber" title="Important Placement Notice:">
    Submitting an inquiry does not guarantee placement. If you have not heard from us, a bed may not be currently available. Please check back later by submitting another inquiry or calling us directly.
  </NoticeCard>

  <NoticeCard variant="sky" title="Medical Notice:">
    Hope House Guthrie provides transitional shelter and community support. We are not a medical facility and do not provide on-site medical or nursing care.
  </NoticeCard>

  <div class="border-t border-slate-200 pt-6 mt-6 text-center">
    <p class="text-sm font-semibold text-slate-700 mb-2">Need immediate assistance or have questions?</p>
    <a
      href="tel:4058569058"
      class="inline-block text-xl font-bold text-sky-700 hover:underline"
    >
      (405) 856-9058
    </a>
    <p class="text-xs text-slate-500 mt-1">Guthrie, Oklahoma</p>
  </div>
</SubmissionConfirmationLayout>