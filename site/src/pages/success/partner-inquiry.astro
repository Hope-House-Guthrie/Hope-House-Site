---
import Layout from "@/layouts/main.astro";
import PageHeader from "@/components/PageHeader.astro";
---

<Layout title="Partner Inquiry Submitted">
  <PageHeader
    title="Partner Inquiry Received"
    description="Thank you for partnering with Hope House Guthrie! Your message has been sent to our leadership team."
  />

  <section class="py-16 bg-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="hope-frame hope-frame-accent bg-white p-6 sm:p-10 shadow-sm">
        <div class="flex items-center gap-4 mb-6">
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600"
            aria-hidden="true"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-sky-700">
              Thank You for Supporting Hope House
            </h2>
            <p class="text-sm text-slate-600">
              Your inquiry has been received by our administrative team.
            </p>
          </div>
        </div>

        <div class="space-y-4 text-base leading-relaxed text-slate-700">
          <p>
            Community partnerships, donations, and shared resources are vital to sustaining our mission and providing essential support to those in need throughout Guthrie and Logan County.
          </p>

          <p>
            Our administration team will review your message and details regarding financial contributions, supplies, services, or collaboration ideas, and will connect with you soon.
          </p>

          <div class="rounded-lg border border-sky-200 bg-sky-50/50 p-4 text-sm text-slate-700 leading-relaxed">
            <strong class="font-semibold text-slate-900 block mb-1">Need to speak with us directly?</strong>
            For urgent sponsorship inquiries, supply drop-offs, or direct coordination, feel free to contact us:
            <div class="mt-2 flex flex-col sm:flex-row gap-2 sm:gap-6">
              <a href="tel:4058569058" class="font-bold text-sky-700 hover:underline">
                📞 (405) 856-9058
              </a>
              <a href="mailto:admin-staff@hopehouseguthrie.org" class="font-bold text-sky-700 hover:underline">
                ✉️ admin-staff@hopehouseguthrie.org
              </a>
            </div>
          </div>
        </div>

        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="/"
            class="inline-flex items-center justify-center rounded-lg bg-sky-700 px-6 py-3 font-semibold text-white hover:bg-sky-800 transition-colors"
          >
            ← Return to Homepage
          </a>
          <a
            href="/get-involved"
            class="inline-flex items-center justify-center rounded-lg border border-sky-300 bg-white px-6 py-3 font-semibold text-sky-700 hover:bg-sky-50 transition-colors"
          >
            Ways to Get Involved
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>