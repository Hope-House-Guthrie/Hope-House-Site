---
interface Props {
  variant?: "sky" | "amber";
  title?: string;
  class?: string;
}

const { variant = "sky", title, class: className = "" } = Astro.props;

const variantStyles = {
  sky: "border-sky-200 bg-sky-50/50 text-slate-700",
  amber: "border-amber-200 bg-amber-50/70 text-amber-900"
};

const titleStyles = {
  sky: "text-slate-900",
  amber: "text-amber-950"
};
---

<div class={`rounded-lg border p-4 text-sm leading-relaxed ${variantStyles[variant]} ${className}`}>
  {title && <strong class={`font-semibold block mb-1 ${titleStyles[variant]}`}>{title}</strong>}
  <slot />
</div>