---
import SubmissionConfirmationLayout from "./lib/SubmissionConfirmationLayout.astro";
import NoticeCard from "./lib/NoticeCard.astro";
---

<SubmissionConfirmationLayout
  metaTitle="Volunteer Inquiry Submitted"
  headerTitle="Volunteer Inquiry Received"
  headerDescription="Thank you for your heart to serve! Your volunteer inquiry has been submitted to Hope House Guthrie."
  cardTitle="Thank You for Wanting to Serve!"
  cardSubtitle="Your inquiry has been received by our volunteer coordinators."
  secondaryButtonHref="/volunteer"
  secondaryButtonLabel="View Volunteer Opportunities"
>
  <p>
    Volunteers are the heart and hands of Hope House Guthrie. Whether helping serve hot lunches at Lou's, organizing donations, mentoring residents, or assisting with facility upkeep, your willingness to help makes a lasting difference in our community.
  </p>

  <p>
    Our team will review your areas of interest and availability and get in touch with you regarding upcoming orientation and volunteer opportunities.
  </p>

  <NoticeCard variant="sky" title="Want to get involved right away?">
    You can always reach out directly to coordinate group projects or inquire about urgent volunteer needs:
    <div class="mt-2 flex flex-col sm:flex-row gap-2 sm:gap-6">
      <a href="tel:4058569058" class="font-bold text-sky-700 hover:underline">
        📞 (405) 856-9058
      </a>
      <a href="mailto:admin-staff@hopehouseguthrie.org" class="font-bold text-sky-700 hover:underline">
        ✉️ admin-staff@hopehouseguthrie.org
      </a>
    </div>
  </NoticeCard>
</SubmissionConfirmationLayout>