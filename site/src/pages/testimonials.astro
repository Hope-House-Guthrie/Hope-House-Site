---
import Layout from "../layouts/main.astro";
import PageHeader from "../components/PageHeader.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import hopeLogo from "../assets/logo.svg";

const stories = (await getCollection("testimonials"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data);
---

<Layout title="Stories of Hope">
  <PageHeader
    title="Stories of Hope"
    description="Real stories from people who have found shelter, support, and a new beginning at Hope House Guthrie."
  />

  <section class="bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="space-y-8">
        {
          stories.map((story, index) => (
            <article class="hope-frame hope-frame-accent bg-white p-6 sm:p-8">
              <div class="grid gap-6 md:grid-cols-[16rem_minmax(0,1fr)]">
                <div
                  class="flex flex-col"
                  data-photo-transition={story.beforePhoto ? "" : undefined}
                >
                  {story.photo ? (
                    <div
                      class:list={[
                        "story-photo-frame relative overflow-hidden rounded-xl",
                        story.videoUrl ? "aspect-[4/3]" : "min-h-72 flex-1",
                      ]}
                      style={`--story-liquid-filter: url(#story-liquid-${index})`}
                    >
                      {story.beforePhoto && (
                        <>
                          <svg
                            class="pointer-events-none absolute h-0 w-0"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <defs>
                              <filter
                                id={`story-liquid-${index}`}
                                x="-25%"
                                y="-25%"
                                width="150%"
                                height="150%"
                                color-interpolation-filters="sRGB"
                              >
                                <feTurbulence
                                  type="fractalNoise"
                                  baseFrequency="0.012 0.025"
                                  numOctaves="2"
                                  seed={index + 3}
                                  result="liquid-noise"
                                />
                                <feDisplacementMap
                                  data-liquid-displacement
                                  in="SourceGraphic"
                                  in2="liquid-noise"
                                  scale="0"
                                  xChannelSelector="R"
                                  yChannelSelector="G"
                                />
                              </filter>
                            </defs>
                          </svg>

                          <div class="story-photo-before absolute inset-0">
                            <Image
                              src={story.beforePhoto}
                              alt={`Earlier photo of ${story.name}`}
                              width={640}
                              format="webp"
                              quality={80}
                              loading="lazy"
                              class="h-full w-full object-cover"
                              style={{
                                objectPosition: story.beforePhotoPosition,
                              }}
                            />
                            <span class="absolute bottom-3 left-3 rounded-md bg-sky-700 px-3 py-1 text-sm font-semibold text-white">
                              Intake
                            </span>
                          </div>
                        </>
                      )}

                      <div
                        class:list={[
                          "absolute inset-0",
                          story.beforePhoto && "story-photo-now",
                        ]}
                      >
                        <Image
                          src={story.photo}
                          alt={`Recent portrait of ${story.name}`}
                          width={640}
                          format="webp"
                          quality={80}
                          loading="lazy"
                          class="h-full w-full object-cover"
                          style={{ objectPosition: story.photoPosition }}
                        />
                        {story.beforePhoto && (
                          <span class="absolute bottom-3 left-3 rounded-md bg-sky-700 px-3 py-1 text-sm font-semibold text-white">
                            Current
                          </span>
                        )}
                      </div>
                    </div>
                  ) : (
                    <div class="flex min-h-72 flex-1 items-center justify-center rounded-xl bg-sky-50 p-8">
                      <Image
                        src={hopeLogo}
                        alt="Hope House Guthrie"
                        width={240}
                        loading="lazy"
                        class="h-auto w-full object-contain"
                      />
                    </div>
                  )}

                  {story.videoUrl && (
                    <a
                      href={story.videoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hope-action mt-4 inline-flex min-h-11 items-center justify-center rounded-lg bg-sky-700 px-4 py-3 text-center text-sm font-bold text-white hover:bg-sky-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
                    >
                      Watch {story.name}’s Story ↗
                    </a>
                  )}
                </div>

                <div class="min-w-0">
                  <p class="text-xs font-bold uppercase tracking-wider text-sky-700">
                    Stories of Hope
                  </p>

                  <h3 class="mt-2 text-2xl font-bold text-sky-700">
                    Meet {story.name}
                  </h3>

                  {story.paragraphs.map((paragraph) => (
                    <p class="mt-3 leading-relaxed text-slate-700">
                      {paragraph}
                    </p>
                  ))}

                  {story.quote && (
                    <blockquote class="mt-5 border-l-4 border-sky-700 pl-4">
                      <p class="italic leading-relaxed text-slate-700">
                        “{story.quote}”
                      </p>
                      <footer class="mt-2 text-sm font-semibold text-sky-700">
                        {story.name}
                      </footer>
                    </blockquote>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    .story-photo-before {
      opacity: 0;
    }

    .story-photo-now {
      opacity: 1;
    }

    /* Show the intake photo once the animation is ready. */
    [data-photo-transition][data-liquid-ready] .story-photo-before {
      opacity: 1;
    }

    [data-photo-transition][data-liquid-ready] .story-photo-now {
      opacity: 0;
    }

    /* Distort only the photos, keeping labels and controls readable. */
    [data-photo-transition][data-liquid-active]
      .story-photo-before
      :global(img),
    [data-photo-transition][data-liquid-active] .story-photo-now :global(img) {
      filter: var(--story-liquid-filter);
      transform: scale(1.06);
    }

    .story-photo-control {
      display: none;
    }

    [data-photo-transition][data-liquid-ready] .story-photo-control {
      display: block;
    }

    @media (prefers-reduced-motion: reduce) {
      [data-photo-transition] .story-photo-before {
        opacity: 0 !important;
      }

      [data-photo-transition] .story-photo-now {
        opacity: 1 !important;
      }

      [data-photo-transition] .story-photo-control {
        display: none !important;
      }

      [data-photo-transition] :global(img) {
        filter: none !important;
        transform: none !important;
      }
    }
  </style>

  <script>
    function setupStoryPhotos() {
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );

      const cleanups: Array<() => void> = [];

      document
        .querySelectorAll<HTMLElement>("[data-photo-transition]")
        .forEach((frame) => {
          const before = frame.querySelector<HTMLElement>(
            ".story-photo-before",
          );
          const current = frame.querySelector<HTMLElement>(".story-photo-now");
          const displacement = frame.querySelector<SVGFEDisplacementMapElement>(
            "[data-liquid-displacement]",
          );

          if (!before || !current || !displacement) return;

          // Intake: 4 seconds. Current: 6 seconds.
          // Each liquid transition: 1.8 seconds.
          const intakeHold = 4000;
          const transition = 1800;
          const currentHold = 6000;
          const cycle = intakeHold + transition + currentHold + transition;

          let elapsed = 0;
          let lastTime: number | null = null;
          let animationId = 0;
          let visible = false;
          let ready = false;
          let disposed = false;

          const ease = (value: number) => value * value * (3 - 2 * value);

          function render() {
            let amount = 0;
            let strength = 0;

            if (elapsed < intakeHold) {
              amount = 0;
            } else if (elapsed < intakeHold + transition) {
              const progress = (elapsed - intakeHold) / transition;
              amount = ease(progress);
              strength = Math.sin(Math.PI * progress) * 65;
            } else if (elapsed < intakeHold + transition + currentHold) {
              amount = 1;
            } else {
              const progress =
                (elapsed - intakeHold - transition - currentHold) / transition;

              amount = 1 - ease(progress);
              strength = Math.sin(Math.PI * progress) * 65;
            }

            // The intake photo stays underneath so no blank background
            // appears as the current photo fades in or out.
            before.style.opacity = "1";
            current.style.opacity = String(amount);
            displacement.setAttribute("scale", strength.toFixed(2));

            frame.toggleAttribute("data-liquid-active", strength > 0.1);

            // Show only the label belonging to the dominant photo.
            const beforeLabel = before.querySelector("span");
            const currentLabel = current.querySelector("span");

            if (beforeLabel) {
              beforeLabel.style.opacity = amount < 0.5 ? "1" : "0";
            }

            if (currentLabel) {
              currentLabel.style.opacity = amount >= 0.5 ? "1" : "0";
            }
          }

          function tick(time: number) {
            animationId = 0;

            if (!shouldRun()) {
              lastTime = null;
              return;
            }

            if (lastTime !== null) {
              elapsed = (elapsed + Math.min(time - lastTime, 100)) % cycle;
            }

            lastTime = time;
            render();
            animationId = requestAnimationFrame(tick);
          }

          function shouldRun() {
            return (
              ready &&
              !disposed &&
              visible &&
              !document.hidden &&
              !reducedMotion.matches
            );
          }

          function sync() {
            if (animationId) cancelAnimationFrame(animationId);
            animationId = 0;
            lastTime = null;

            if (reducedMotion.matches) {
              frame.removeAttribute("data-liquid-ready");
              frame.removeAttribute("data-liquid-active");
              before.style.opacity = "0";
              current.style.opacity = "1";
              displacement.setAttribute("scale", "0");
            } else if (ready) {
              frame.setAttribute("data-liquid-ready", "");
              render();
            }

            if (shouldRun()) {
              animationId = requestAnimationFrame(tick);
            }
          }

          const observer = new IntersectionObserver(
            ([entry]) => {
              visible = entry.isIntersecting;
              sync();
            },
            { threshold: 0.1 },
          );

          observer.observe(frame);
          reducedMotion.addEventListener("change", sync);
          document.addEventListener("visibilitychange", sync);

          // Wait for both lazy-loaded photos before starting.
          const images = Array.from(
            frame.querySelectorAll<HTMLImageElement>("img"),
          );

          Promise.all(
            images.map(
              (image) =>
                new Promise<void>((resolve) => {
                  if (image.complete) {
                    resolve();
                    return;
                  }

                  image.addEventListener("load", () => resolve(), {
                    once: true,
                  });
                  image.addEventListener("error", () => resolve(), {
                    once: true,
                  });
                }),
            ),
          ).then(() => {
            if (disposed) return;
            ready = images.every((image) => image.naturalWidth > 0);
            sync();
          });

          cleanups.push(() => {
            disposed = true;
            cancelAnimationFrame(animationId);
            observer.disconnect();
            reducedMotion.removeEventListener("change", sync);
            document.removeEventListener("visibilitychange", sync);
          });
        });

      document.addEventListener(
        "astro:before-swap",
        () => cleanups.forEach((cleanup) => cleanup()),
        { once: true },
      );
    }

    setupStoryPhotos();
    document.addEventListener("astro:after-swap", setupStoryPhotos);
  </script>
</Layout>
