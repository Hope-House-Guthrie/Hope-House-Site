---
import { getCollection } from "astro:content";
import Layout from "@/layouts/main/index.astro";
import PageHeader from "@/lib/PageHeader.astro";

import StorySection from "./lib/StorySection.astro";
import MissionVisionSection from "./lib/MissionVisionSection.astro";
import CoreValuesSection from "./lib/CoreValuesSection.astro";
import BoardSectionContainer from "./lib/BoardSectionContainer.astro";

import "./index.css";

const boardMembers = await getCollection("board");
const coreValues = await getCollection("coreValues");
---

<Layout title="About Us">
  <PageHeader
    title="Our History & Vision"
    description="Founded in 2020 under Neighborhood Hope Dealers (NHD), Hope House Guthrie has grown into a life-transformation center for central Oklahoma."
  />

  <StorySection />
  <MissionVisionSection />
  <CoreValuesSection coreValues={coreValues} />
  <BoardSectionContainer members={boardMembers} />

  <script>
    import { setupAboutReveal } from "./lib/setup-about-reveal";

    setupAboutReveal();
    document.addEventListener("astro:after-swap", () => setupAboutReveal());
  </script>
</Layout>