---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/main/index.astro";
import BoardSection from "./lib/BoardSection.astro";
import PageHeader from "@/lib/PageHeader.astro";
import SectionHeading from "@/lib/SectionHeading.astro";
import Container from "@/lib/Container.astro";
import Card from "@/lib/Card.astro";
import hopeHouseSign from "@/assets/hope-house-sign.png";

const allMembers = await getCollection("board");
const coreValues = await getCollection("coreValues");

const sortedMembers = allMembers.sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

const officers = sortedMembers.filter((item) => item.data.group === "officer");
const boardMembers = sortedMembers.filter(
  (item) => item.data.group === "board",
);
const advisoryMembers = sortedMembers.filter(
  (item) => item.data.group === "advisory",
);
---

<Layout title="About Us">
  <PageHeader
    title="Our History & Vision"
    description="Founded in 2020 under Neighborhood Hope Dealers (NHD), Hope House Guthrie has grown into a life-transformation center for central Oklahoma."
  />

  <!-- Our Story -->
  <section class="py-16 bg-white overflow-x-clip">
    <Container class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
      <div>
        <h2 class="text-3xl font-bold text-sky-700 mb-6">Our Story</h2>

        <p class="text-slate-800 mb-4 leading-relaxed">
          Hope House Guthrie began in 2020 with just $80 and a simple
          commitment: make sure people experiencing homelessness on Guthrie’s
          west side had a hot meal. Those early meals were served through <strong
            >Lou’s - Lunch on Us</strong
          >, an effort that became one of the first steps toward what would
          eventually grow into Hope House Guthrie. Through Neighborhood Hope
          Dealers, Inc., a simple meal became the beginning of something larger:
          a place where people could find safety, support, and the opportunity
          to start again.
        </p>

        <p class="text-slate-800 mb-4 leading-relaxed">
          Even as the COVID-19 pandemic brought new challenges, the work
          continued. In 2022, a USDA grant helped purchase an 18,000-square-foot
          building, making room for shelter, residential programs, walk-in
          services, and a growing network of community support.
        </p>

        <p class="text-slate-800 mb-4 leading-relaxed">
          Today, we walk alongside individuals and families facing homelessness,
          addiction, domestic violence, and other hardships. A meal or a safe
          place to sleep may be the first step. Recovery support, counseling,
          life skills, and employment readiness help people take the next steps
          toward stability and independence.
        </p>

        <p class="text-slate-800 leading-relaxed">
          For many of our staff members, this mission is personal. They once
          came to Hope House seeking help and now help lead the programs that
          supported their own recovery. Their experience brings understanding
          and practical encouragement to our work—and offers others a powerful
          reason to believe a new beginning is possible.
        </p>
      </div>

      <figure>
        <Image
          src={hopeHouseSign}
          alt="Hope House Guthrie sign at the parking lot entrance"
          format="webp"
          widths={[400, 800, 1200]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          class="hope-frame block w-full h-auto bg-sky-100 p-2"
        />
        <figcaption class="mt-3 text-center text-sm text-slate-800">
          Welcoming visitors since 2021. Hope House Guthrie’s entrance sign was
          generously funded by Mrs. Gellenback.
        </figcaption>
      </figure>

      <div class="mt-0.5 mb-8 text-center">
        <a
          href="founders"
          class="hope-action inline-flex w-fit min-h-11 items-center justify-center rounded-lg bg-sky-700 px-6 py-3 font-semibold text-white hover:bg-sky-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
        >
          Meet Our Founders →
        </a>
      </div>
    </Container>
  </section>

  <!-- Mission and Vision -->
  <section class="py-16 bg-sky-50 border-y border-sky-100">
    <Container>
      <SectionHeading
        title="Serving Hope & Moving Forward"
        subtitle="Our purpose today. Our hope for tomorrow."
        class="mb-10"
        subtitleClass="mt-2 text-lg text-slate-800"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <Card data-about-reveal="left" class="overflow-hidden bg-white">
          <div class="bg-sky-700 px-6 py-3 sm:px-8">
            <h3 class="text-2xl font-bold text-white text-center">
              Our Mission
            </h3>
          </div>

          <div class="p-6 sm:p-8">
            <p class="text-slate-800 leading-relaxed">
              We serve the most needful in our community; we feed the hungry,
              shelter the homeless, and provide safety for the hurt and the
              neglected. We advocate for each person who comes through our
              door.
            </p>
          </div>
        </Card>

        <Card data-about-reveal="right" class="overflow-hidden bg-white">
          <div class="bg-sky-700 px-6 py-3 sm:px-8">
            <h3 class="text-2xl font-bold text-white text-center">
              Our Vision
            </h3>
          </div>

          <div class="p-6 sm:p-8">
            <p class="text-slate-800 leading-relaxed">
              To create a safe place that empowers individuals and families to
              achieve their full potential and contribute to a thriving
              community.
            </p>
          </div>
        </Card>
      </div>
    </Container>
  </section>

  <!-- Core Values -->
  <section class="py-16 bg-white">
    <Container>
      <SectionHeading
        title="Our Core Values"
        subtitle="The values that shape how we serve, lead, and care for our community."
        class="mb-10"
        subtitleClass="text-slate-800 text-lg mt-4"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          coreValues.map(({ data: value }) => (
            <Card
              accent
              data-about-reveal={value.direction}
              style={`--reveal-delay: ${value.delay}`}
              class="group bg-white p-7 motion-safe:transition-transform motion-safe:duration-700 motion-safe:hover:-translate-y-1"
            >
              <div class="w-12 h-12 rounded-full bg-sky-50 flex items-center justify-center mb-5">
                <svg
                  class="w-6 h-6 text-sky-700"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d={value.icon}
                  />
                </svg>
              </div>

              <h3 class="text-xl font-bold text-sky-700 mb-2">
                {value.title}
              </h3>

              <p class="font-semibold text-slate-900 mb-3">
                {value.statement}
              </p>

              <p class="text-slate-700 leading-relaxed">
                {value.description}
              </p>
            </Card>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Board of Directors -->
  <section class="py-16 bg-sky-50 border-t border-sky-100">
    <Container>
      <SectionHeading
        title="Board of Directors"
        subtitle="Community leaders helping guide the mission and future of Hope House Guthrie."
        class="mb-12"
        subtitleClass="text-slate-700 text-lg mt-4"
      />

      <BoardSection title="Board Officers" members={officers} />
      <BoardSection title="Board Members" members={boardMembers} />
      <BoardSection
        title="Non-Voting Advisory Board"
        members={advisoryMembers}
      />
    </Container>
  </section>

  <style>
    [data-about-reveal] {
      --reveal-x: 0px;
      --reveal-y: 0px;
    }

    [data-about-reveal="left"],
    [data-about-reveal="value-top"] {
      --reveal-x: -28px;
    }

    [data-about-reveal="right"],
    [data-about-reveal="value-bottom"] {
      --reveal-x: 28px;
    }

    @media (min-width: 768px) {
      [data-about-reveal="value-top"] {
        --reveal-x: 0px;
        --reveal-y: -32px;
      }

      [data-about-reveal="value-bottom"] {
        --reveal-x: 0px;
        --reveal-y: 32px;
      }
    }

    @media (max-width: 767px) {
      [data-about-reveal] {
        --reveal-delay: 0ms !important;
      }
    }
  </style>

  <script>
    import { setupAboutReveal } from "./lib/setup-about-reveal";

    setupAboutReveal();
    document.addEventListener("astro:after-swap", () => setupAboutReveal());
  </script>
</Layout>