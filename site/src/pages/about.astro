---
import Layout from '../layouts/main.astro';

const board = [
  { name: 'Sue DuCharme', role: 'Chairman / CEO', desc: 'Director, Neighborhood Solutions' },
  { name: 'John Secondi', role: 'Vice Chair / President', desc: 'Corporate leadership (Telecom, United Way, Gideon’s Int.)' },
  { name: 'Codi Canning', role: 'Treasurer', desc: 'Logan County Community Services' },
  { name: 'Steve Gentling', role: 'Board Member', desc: 'Former Mayor of Guthrie; Ret. Colonel, U.S. Air Force' },
  { name: 'Dena Porter', role: 'Secretary', desc: 'Community Board Leadership' },
  { name: 'Michael Gellenbeck', role: 'Board Member', desc: 'Community Advocate' },
  { name: 'Allison Terrill', role: 'Board Member', desc: 'OG&E Community Reach Coordinator' },
  { name: 'Jody Ahrnsbrak', role: 'Board Member', desc: 'Retired Registered Nurse' },
];
---

<Layout title="About Us">
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold mb-4">Our History & Vision</h1>
      <p class="text-slate-300 max-w-2xl text-lg">
        Founded in 2020 under Neighborhood Hope Dealers (NHD), Hope House Guthrie has grown into a life-transformation center for central Oklahoma.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">From Feeding Meals to Complete Care</h2>
        <p class="text-slate-600 mb-4 leading-relaxed">
          Hope House Guthrie began with a simple mission: feeding the hungry through Neighborhood Hope Dealers. The need quickly expanded, transforming our scope into a full-scale facility accommodating up to 60+ men, women, and children at a time in our Life Transformation Program.
        </p>
        <p class="text-slate-600 leading-relaxed">
          Some who enter our doors face short-term crisis due to financial distress. Others arrive trapped in generational poverty or seeking long-term addiction recovery. We advocate for each person without judgment.
        </p>
      </div>

      <div class="bg-sky-50 border border-sky-100 p-8 rounded-xl">
        <h3 class="text-xl font-bold text-sky-900 mb-4">Facility Overview</h3>
        <ul class="space-y-3 text-slate-700 text-sm">
          <li class="flex items-start gap-2">✓ <strong>35 Furnished Client Rooms:</strong> Providing secure transitional housing.</li>
          <li class="flex items-start gap-2">✓ <strong>Commercial Kitchen:</strong> Fully equipped to cook hot meals daily.</li>
          <li class="flex items-start gap-2">✓ <strong>Meeting & Common Spaces:</strong> Dedicated rooms for NA support groups and counseling.</li>
          <li class="flex items-start gap-2">✓ <strong>Partner Offices:</strong> On-site space for AARP, Community Action, and Domestic Violence support.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Board of Directors -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-2 text-center">Board of Directors</h2>
      <p class="text-center text-slate-600 mb-12">Volunteer-operated guidance under our visionary leadership team.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {board.map((member) => (
          <div class="bg-white p-6 rounded-lg border border-slate-200 shadow-sm">
            <h3 class="font-bold text-slate-900 text-lg">{member.name}</h3>
            <span class="text-xs font-semibold text-sky-700 block mb-2">{member.role}</span>
            <p class="text-xs text-slate-500">{member.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>