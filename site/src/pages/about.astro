---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/main.astro";
import BoardSection from "../components/board-section.astro";
import PageHeader from "../components/PageHeader.astro";
import hopeHouseSign from "../assets/hope-house-sign.png";

const allMembers = await getCollection("board");

const sortedMembers = allMembers.sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

const officers = sortedMembers.filter((item) => item.data.group === "officer");
const boardMembers = sortedMembers.filter(
  (item) => item.data.group === "board",
);
const advisoryMembers = sortedMembers.filter(
  (item) => item.data.group === "advisory",
);
---

<Layout title="About Us">
  <PageHeader
    title="Our History & Vision"
    description="Founded in 2020 under Neighborhood Hope Dealers (NHD), Hope House Guthrie has grown into a life-transformation center for central Oklahoma."
  />

  <!-- Our Story -->
  <section class="py-16 bg-white overflow-x-clip">
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-10 items-start"
    >
      <div>
        <h2 class="text-3xl font-bold text-sky-700 mb-6">Our Story</h2>

        <p class="text-slate-800 mb-4 leading-relaxed">
          Hope House Guthrie began in 2020 with just $80 and a simple
          commitment: make sure people experiencing homelessness on Guthrie’s
          west side had a hot meal. Those early meals were served through <strong
            >Lou’s - Lunch on Us</strong
          >, an effort that became one of the first steps toward what would
          eventually grow into Hope House Guthrie. Through Neighborhood Hope
          Dealers, Inc., a simple meal became the beginning of something larger:
          a place where people could find safety, support, and the opportunity
          to start again.
        </p>

        <p class="text-slate-800 mb-4 leading-relaxed">
          Even as the COVID-19 pandemic brought new challenges, the work
          continued. In 2022, a USDA grant helped purchase an 18,000-square-foot
          building, making room for shelter, residential programs, walk-in
          services, and a growing network of community support.
        </p>

        <p class="text-slate-800 mb-4 leading-relaxed">
          Today, we walk alongside individuals and families facing homelessness,
          addiction, domestic violence, and other hardships. A meal or a safe
          place to sleep may be the first step. Recovery support, counseling,
          life skills, and employment readiness help people take the next steps
          toward stability and independence.
        </p>

        <p class="text-slate-800 leading-relaxed">
          For many of our staff members, this mission is personal. They once
          came to Hope House seeking help and now help lead the programs that
          supported their own recovery. Their experience brings understanding
          and practical encouragement to our work—and offers others a powerful
          reason to believe a new beginning is possible.
        </p>
      </div>

      <figure>
        <Image
          src={hopeHouseSign}
          alt="Hope House Guthrie sign at the parking lot entrance"
          format="webp"
          widths={[400, 800, 1200]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          class="hope-frame block w-full h-auto bg-sky-100 p-2"
        />
        <figcaption class="mt-3 text-center text-sm text-slate-800">
          Welcoming visitors since 2021. Hope House Guthrie’s entrance sign was
          generously funded by Mrs. Gellenback.
        </figcaption>
      </figure>

      <div class="mt-0.5 mb-8 text-center">
        <a
          href="/founders"
          class="hope-action inline-flex w-fit min-h-11 items-center justify-center rounded-lg bg-sky-700 px-6 py-3 font-semibold text-white hover:bg-sky-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-700"
        >
          Meet Our Founders →
        </a>
      </div>
    </div>
  </section>

  <!-- Mission and Vision -->
    <section class="py-16 bg-sky-50 border-y border-sky-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <h2
            class="text-3xl sm:text-4xl font-bold text-sky-700 tracking-tight"
          >
            Serving Hope &amp; Moving Forward
          </h2>

          <div
            class="w-full h-1 bg-sky-700 rounded-full mx-auto mt-4"
            aria-hidden="true"
          >
          </div>

          <p class="mt-2 text-lg text-slate-800">
            Our purpose today. Our hope for tomorrow.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div
            data-about-reveal="left"
            class="hope-frame overflow-hidden bg-white"
          >
            <div class="bg-sky-700 px-6 py-3 sm:px-8">
              <h3 class="text-2xl font-bold text-white text-center">
                Our Mission
              </h3>
            </div>

            <div class="p-6 sm:p-8">
              <p class="text-slate-800 leading-relaxed">
                We serve the most needful in our community; we feed the hungry,
                shelter the homeless, and provide safety for the hurt and the
                neglected. We advocate for each person who comes through our
                door.
              </p>
            </div>
          </div>

          <div
            data-about-reveal="right"
            class="hope-frame overflow-hidden bg-white"
          >
            <div class="bg-sky-700 px-6 py-3 sm:px-8">
              <h3 class="text-2xl font-bold text-white text-center">
                Our Vision
              </h3>
            </div>

            <div class="p-6 sm:p-8">
              <p class="text-slate-800 leading-relaxed">
                To create a safe place that empowers individuals and families to
                achieve their full potential and contribute to a thriving
                community.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Values -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <h2
            class="text-3xl sm:text-4xl font-bold text-sky-700 tracking-tight"
          >
            Our Core Values
          </h2>

          <div
            class="w-full h-1 bg-sky-700 rounded-full mx-auto mt-4"
            aria-hidden="true"
          >
          </div>

          <p class="text-slate-800 text-lg mt-4">
            The values that shape how we serve, lead, and care for our
            community.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            [
              {
                title: "Integrity",
                direction: "value-top",
                delay: "0ms",
                statement: "We do what is right, even when no one is watching.",
                description:
                  "We build our decisions, programs, and relationships on openness, honesty, accountability, and fairness.",
                icon: "M9 12.75 11.25 15 15 9.75M12 3l7.5 3v5.25c0 4.72-3.2 8.91-7.5 9.75-4.3-.84-7.5-5.03-7.5-9.75V6L12 3Z",
              },
              {
                title: "Service",
                direction: "value-bottom",
                delay: "120ms",
                statement:
                  "We serve people with dignity, respect, and purpose.",
                description:
                  "We strive to be welcoming, responsive, inclusive, and responsible with the resources entrusted to us.",
                icon: "M12 20.25s-7.5-4.35-7.5-10.125A4.125 4.125 0 0 1 12 7.875a4.125 4.125 0 0 1 7.5 2.25C19.5 15.9 12 20.25 12 20.25Z",
              },
              {
                title: "Quality of Life",
                direction: "value-top",
                delay: "240ms",
                statement:
                  "We help create the conditions for people to move forward.",
                description:
                  "Through safe spaces, accessible services, strong relationships, and community support, we help individuals and families build a better quality of life.",
                icon: "m3 11.25 9-7.5 9 7.5M5.25 10.5v9h13.5v-9M9 19.5v-5.25h6v5.25",
              },
            ].map((value) => (
              <div
                data-about-reveal={value.direction}
                style={`--reveal-delay: ${value.delay}`}
                class="hope-frame hope-frame-accent group bg-white p-7 motion-safe:transition-transform motion-safe:duration-700 motion-safe:hover:-translate-y-1"
              >
                <div class="w-12 h-12 rounded-full bg-sky-50 flex items-center justify-center mb-5">
                  <svg
                    class="w-6 h-6 text-sky-700"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={value.icon}
                    />
                  </svg>
                </div>

                <h3 class="text-xl font-bold text-sky-700 mb-2">
                  {value.title}
                </h3>

                <p class="font-semibold text-slate-900 mb-3">
                  {value.statement}
                </p>

                <p class="text-slate-700 leading-relaxed">
                  {value.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Board of Directors -->
    <section class="py-16 bg-sky-50 border-t border-sky-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2
            class="text-3xl sm:text-4xl font-bold text-sky-700 tracking-tight"
          >
            Board of Directors
          </h2>

          <div
            class="w-full h-1 bg-sky-700 rounded-full mx-auto mt-4"
            aria-hidden="true"
          >
          </div>

          <p class="text-slate-700 text-lg mt-4">
            Community leaders helping guide the mission and future of Hope House
            Guthrie.
          </p>
        </div>

        <BoardSection title="Board Officers" members={officers} />
        <BoardSection title="Board Members" members={boardMembers} />
        <BoardSection
          title="Non-Voting Advisory Board"
          members={advisoryMembers}
        />
      </div>
    </section>

  <style>
    [data-about-reveal] {
      --reveal-x: 0px;
      --reveal-y: 0px;
    }

    [data-about-reveal="left"],
    [data-about-reveal="value-top"] {
      --reveal-x: -28px;
    }

    [data-about-reveal="right"],
    [data-about-reveal="value-bottom"] {
      --reveal-x: 28px;
    }

    @media (min-width: 768px) {
      [data-about-reveal="value-top"] {
        --reveal-x: 0px;
        --reveal-y: -32px;
      }

      [data-about-reveal="value-bottom"] {
        --reveal-x: 0px;
        --reveal-y: 32px;
      }
    }

    @media (max-width: 767px) {
      [data-about-reveal] {
        --reveal-delay: 0ms !important;
      }
    }
  </style>

  <script>
  function setupAboutReveal() {
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-about-reveal]"),
    );

    if (!cards.length || !("IntersectionObserver" in window)) return;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    if (reducedMotion.matches) return;

    const animations = new Set<Animation>();
    const targets = new Map<HTMLElement, HTMLElement>();

    // Watch stationary spaces so moving cards cannot prevent the trigger.
    cards.forEach((card) => {
      const wrapper = document.createElement("div");
      wrapper.style.minWidth = "0";
      wrapper.style.display = "grid";

      card.before(wrapper);
      wrapper.appendChild(card);

      card.style.visibility = "hidden";
      targets.set(wrapper, card);
    });

    function reveal(card: HTMLElement) {
      const desktop = window.matchMedia("(min-width: 768px)").matches;
      const direction = card.dataset.aboutReveal;
      const rect = card.getBoundingClientRect();

      let x = 0;
      let y = 0;

      if (
        direction === "left" ||
        (!desktop && direction === "value-top")
      ) {
        x = -rect.right - 40;
      } else if (
        direction === "right" ||
        (!desktop && direction === "value-bottom")
      ) {
        x = window.innerWidth - rect.left + 40;
      } else if (direction === "value-top") {
        y = -rect.bottom - 40;
      } else if (direction === "value-bottom") {
        y = window.innerHeight - rect.top + 40;
      }

      const delay = desktop
        ? parseFloat(
            getComputedStyle(card).getPropertyValue("--reveal-delay"),
          ) || 0
        : 0;

      const animation = card.animate(
        [
          { translate: `${x}px ${y}px` },
          { translate: "0px 0px" },
        ],
        {
          duration: 1600,
          delay,
          easing: "cubic-bezier(0.25, 0.1, 0.25, 1)",
          fill: "both",
        },
      );

      card.style.visibility = "";
      animations.add(animation);

      animation.onfinish = () => {
        animation.cancel();
        animations.delete(animation);
      };
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const wrapper = entry.target as HTMLElement;
          const card = targets.get(wrapper);

          if (card) reveal(card);
          observer.unobserve(wrapper);
        });
      },
      {
        threshold: 0.15,
        rootMargin: "0px 0px -40px 0px",
      },
    );

    targets.forEach((_, wrapper) => observer.observe(wrapper));

    function showAll() {
      observer.disconnect();
      animations.forEach((animation) => animation.cancel());
      animations.clear();
      cards.forEach((card) => {
        card.style.visibility = "";
      });
    }

    function onMotionChange() {
      if (reducedMotion.matches) showAll();
    }

    reducedMotion.addEventListener("change", onMotionChange);

    document.addEventListener(
      "astro:before-swap",
      () => {
        showAll();
        reducedMotion.removeEventListener("change", onMotionChange);
      },
      { once: true },
    );
  }

  setupAboutReveal();
  document.addEventListener("astro:after-swap", setupAboutReveal);
</script>
</Layout>
