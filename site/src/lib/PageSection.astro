---
export interface Props {
  title: string;
  subtitle: string;
  variant?: "alternate";
}
---

<section class={`py-18 px-6 sm:px-8 ${Astro.props.variant ?? ""}`} `>
  <div class="max-w-7xl mx-auto">
    <header class="mb-10 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-sky-700">
        {Astro.props.title}
      </h2>
      <hr
        class="h-1 w-full mx-auto mt-4 border-0 rounded-full bg-sky-700"
        aria-hidden="true"
      />
      <p class="max-w-2xl mx-auto mt-4 leading-relaxed text-slate-900">
        {Astro.props.subtitle}
      </p>
    </header>

    <slot />
  </div>
</section>

<style>
  @reference "../styles/main.css";

  section {
    @apply bg-white;

    &.alternate {
      @apply bg-sky-50;
    }
  }
</style>
