---
interface Props {
  title: string;
  subtitle?: string;
  tag?: string;
  centered?: boolean;
  class?: string;
  id?: string;
  titleClass?: string;
  subtitleClass?: string;
}

const {
  title,
  subtitle,
  tag,
  centered = true,
  class: className = "",
  id,
  titleClass = "",
  subtitleClass = "",
} = Astro.props;
---

<div class:list={["mb-8", centered ? "text-center" : "text-left", className]}>
  {
    tag && (
      <p class="text-xs font-bold uppercase tracking-wider text-sky-700 mb-2">
        {tag}
      </p>
    )
  }
  <h2
    id={id}
    class:list={[
      "text-3xl font-bold tracking-tight sm:text-4xl",
      titleClass || "text-sky-700",
    ]}
  >
    {title}
  </h2>
  <div
    class:list={[
      "mt-4 h-1 w-full rounded-full bg-sky-700",
      centered && "mx-auto",
    ]}
    aria-hidden="true"
  >
  </div>
  {
    subtitle && (
      <p
        class:list={[
          "mt-4 leading-relaxed",
          centered ? "mx-auto max-w-2xl text-slate-700" : "text-slate-700",
          subtitleClass,
        ]}
      >
        {subtitle}
      </p>
    )
  }
  <slot />
</div>
