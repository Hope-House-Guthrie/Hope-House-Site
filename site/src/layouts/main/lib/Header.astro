---
import { Image } from "astro:assets";
import hhgLogo from "@/assets/logo.svg";
import DonateTab from "./DonateTab.astro";
---

<!-- Main Navigation -->
<header
  id="site-header"
  class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200"
>
  <!--
    Full-bleed header row (not max-w-7xl) so branding + full nav + CTAs
    can fit on common desktop widths; body sections stay max-w-7xl.
  -->
  <div class="mx-auto w-full px-4 sm:px-6 lg:px-10 py-3 md:py-4">
    <div
      id="header-bar"
      class="relative flex items-center justify-between gap-2 sm:gap-3 min-w-0"
    >
      <a
        id="header-brand"
        href="/"
        class="flex items-center gap-2 sm:gap-3 group min-w-0 shrink"
      >
        <Image
          src={hhgLogo}
          alt="Hope House Guthrie Logo"
          class="h-11 sm:h-14 w-auto shrink-0 object-contain transition-transform group-hover:scale-105"
        />

        <div class="min-w-0 flex flex-col justify-center">
          <span
            class="block font-bold text-sm sm:text-base text-slate-900 leading-tight tracking-tight group-hover:text-sky-700 transition-colors"
          >
            Neighborhood Hope Dealers, Inc.
          </span>

          <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 mt-1">
            <span
              class="text-[10px] sm:text-xs font-bold text-sky-700 tracking-wider uppercase"
            >
              Hope House Guthrie
            </span>
            <span
              class="hidden sm:inline-block w-1 h-1 rounded-full bg-slate-300"
            ></span>
            <span
              class="hidden sm:inline text-[10px] font-semibold text-slate-500 uppercase tracking-widest"
            >
              Est. 2020
            </span>
          </div>
        </div>
      </a>

      <!--
        Full desktop cluster (nav + CTAs). Shown on xl+ screens via CSS;
        below xl the hamburger + compact action row is used.
      -->
      <div
        id="desktop-header-cluster"
        class="hidden xl:flex items-center justify-end gap-2 xl:gap-3 shrink-0"
      >
        <nav
          aria-label="Main navigation"
          class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center gap-4 xl:gap-8 2xl:gap-10 text-base xl:text-lg font-medium text-slate-600"
        >
          <a
            href="/"
            class="hover:text-sky-700 transition-colors whitespace-nowrap"
          >
            Home
          </a>
          <a
            href="/about"
            class="hover:text-sky-700 transition-colors whitespace-nowrap"
          >
            About Us
          </a>
          <a
            href="/programs"
            class="hover:text-sky-700 transition-colors whitespace-nowrap"
          >
            Programs &amp; Services
          </a>
          <a
            href="/contact"
            class="hover:text-sky-700 transition-colors whitespace-nowrap"
          >
            Contact
          </a>
        </nav>

        <div class="flex items-center gap-2 shrink-0">
          <a
            href="/contact#client-inquiry"
            class="hope-action inline-flex h-11 w-36 items-center justify-center rounded-lg bg-sky-700 px-3 text-sm font-semibold text-white transition-colors hover:bg-sky-800 whitespace-nowrap"
          >
            Ask About a Bed
          </a>

          <a
            href="/volunteer#volunteer-interest"
            class="hope-action inline-flex h-11 w-36 items-center justify-center rounded-lg bg-sky-700 px-3 text-sm font-semibold text-white transition-colors hover:bg-sky-800 whitespace-nowrap"
          >
            Volunteer
          </a>
        </div>
      </div>

      <!-- Compact / hamburger navigation (shown on screens smaller than xl) -->
      <details id="compact-nav" class="relative shrink-0 xl:hidden">
        <summary
          aria-label="Navigation menu"
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-100 [&::-webkit-details-marker]:hidden"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>

        <nav
          aria-label="Mobile navigation"
          class="absolute right-0 top-full z-50 mt-2 w-60 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-lg"
        >
          <a
            href="/"
            class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-sky-50 hover:text-sky-700"
          >
            Home
          </a>
          <a
            href="/about"
            class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-sky-50 hover:text-sky-700"
          >
            About Us
          </a>
          <a
            href="/programs"
            class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-sky-50 hover:text-sky-700"
          >
            Programs &amp; Services
          </a>
          <a
            href="/events"
            class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-sky-50 hover:text-sky-700"
          >
            Events
          </a>
          <a
            href="/partners"
            class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-sky-50 hover:text-sky-700"
          >
            Partners &amp; Supporters
          </a>
          <a
            href="/contact"
            class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-sky-50 hover:text-sky-700"
          >
            Contact
          </a>
        </nav>
      </details>
    </div>

    <!-- Compact Quick Actions (shown with hamburger below xl) -->
    <div id="compact-header-actions" class="mt-3 grid grid-cols-2 gap-3 xl:hidden">
      <a
        href="/contact#client-inquiry"
        class="hope-action inline-flex items-center justify-center bg-sky-700 hover:bg-sky-800 text-white font-semibold text-sm px-4 py-2.5 rounded-lg transition-colors whitespace-nowrap"
      >
        Ask About a Bed
      </a>

      <a
        href="/volunteer#volunteer-interest"
        class="hope-action flex items-center justify-center rounded-lg bg-sky-700 px-3 py-3 text-sm font-semibold text-white text-center transition-colors hover:bg-sky-800"
      >
        Volunteer
      </a>
    </div>
  </div>

  <DonateTab />
</header>

<script>
  // Close mobile dropdown when clicking outside
  document.addEventListener("click", (e) => {
    const compactNav = document.getElementById(
      "compact-nav",
    ) as HTMLDetailsElement | null;
    if (compactNav && compactNav.open && !compactNav.contains(e.target as Node)) {
      compactNav.open = false;
    }
  });
</script>
