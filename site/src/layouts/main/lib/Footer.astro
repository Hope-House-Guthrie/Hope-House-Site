---
import { Image } from "astro:assets";
import hhgLogo from "@/assets/logo.svg";
import unitedWayLogo from "@/assets/partners/united-way-logo-HHG.jpg";
---

<!-- Footer -->
<footer class="bg-sky-700 text-sky-100 pt-12 pb-8 border-t border-sky-600">
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-[1.7fr_1fr_1fr_1fr] gap-x-12 gap-y-8 pb-12 border-b border-sky-600"
  >
    <!-- Branding -->
    <div>
      <div class="flex items-center gap-2 sm:gap-3 mb-4">
        <Image
          src={hhgLogo}
          alt="Hope House Guthrie"
          width={hhgLogo.width}
          height={hhgLogo.height}
          loading="lazy"
          class="hope-logo-depth h-10 sm:h-14 w-auto shrink-0 object-contain"
        />

        <div class="h-10 sm:h-14 min-w-0 flex flex-col justify-center">
          <div
            class="text-white font-bold text-[13px] sm:text-lg leading-tight md:whitespace-nowrap"
          >
            Neighborhood Hope Dealers, Inc.
          </div>

          <div
            class="mt-1 text-[10px] sm:text-xs tracking-wide whitespace-nowrap"
          >
            <span class="font-bold text-white"> HOPE HOUSE GUTHRIE </span>

            <span class="text-sky-300 mx-1">•</span>

            <span class="text-sky-200"> EST. 2020 </span>
          </div>
        </div>
      </div>

      <p class="text-sm text-sky-100 mb-4">
        A division of Neighborhood Hope Dealers (NHD), a 501(c)(3)
        non-profit organization serving Logan County, OK.
      </p>

      <p class="text-xs text-sky-200">
        Proud Partner of United Way of Logan County.
      </p>

      <Image
        src={unitedWayLogo}
        alt="United Way of Logan County"
        width={240}
        format="webp"
        class="hope-logo-depth mt-4 h-auto w-60 max-w-full"
        loading="lazy"
      />
    </div>

    <!-- Quick Links -->
    <div>
      <h3
        class="text-white text-sm font-semibold mb-4 uppercase tracking-wider"
      >
        Quick Links
      </h3>

      <ul class="space-y-2 md:space-y-5 text-sm">
        <li>
          <a href="/about" class="hover:text-white transition-colors">
            Our History & Vision
          </a>
        </li>

        <li>
          <a href="/programs" class="hover:text-white transition-colors">
            Transitional Housing
          </a>
        </li>

        <li>
          <a
            href="/programs#recovery"
            class="hover:text-white transition-colors"
          >
            NA Recovery Meetings
          </a>
        </li>

        <li>
          <a href="/donate" class="hover:text-white transition-colors">
            Join the 300 Club
          </a>
        </li>

        <li>
          <a
            href="/donate#adopt-a-room"
            class="hover:text-white transition-colors"
          >
            Adopt-a-Room
          </a>
        </li>

        <li>
          <a href="/volunteer" class="hover:text-white transition-colors">
            Volunteer With Us
          </a>
        </li>
      </ul>
    </div>

    <!-- Direct Support -->
    <div>
      <h3
        class="text-white text-sm font-semibold mb-4 uppercase tracking-wider"
      >
        Direct Support
      </h3>

      <p class="mb-2 text-sm text-sky-100 md:mb-7">
        <strong>Street Address:</strong><br />
        1916 E. Perkins Ave., Guthrie, OK 73044
      </p>

      <p class="mb-2 text-sm text-sky-100 md:mb-7">
        <strong>PO Box:</strong><br />
        PO Box 491, Guthrie, OK 73044
      </p>

      <p class="mb-2 text-sm text-sky-100">
        <strong>Help Desk:</strong><br />
        <a href="tel:4058569058" class="hover:text-white">
          (405) 856-9058
        </a>
      </p>

      <p class="text-sm text-sky-100">
        <strong>Admin:</strong><br />
        <a href="tel:4058870288" class="hover:text-white">
          (405) 887-0288
        </a>
      </p>
    </div>

    <!-- Follow Us -->
    <div class="md:ml-6 text-center md:text-left">
      <h3
        class="text-white text-sm font-semibold mb-4 uppercase tracking-wider"
      >
        Follow Us
      </h3>

      <!-- Social Icons -->
      <div class="flex items-center justify-center md:justify-start gap-3">
        <!-- YouTube -->
        <a
          href="https://www.youtube.com/@HopeHouseGuthrie"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Hope House Guthrie on YouTube"
          title="YouTube"
          class="hope-social w-10 h-10 rounded-full flex items-center justify-center"
        >
          <svg
            viewBox="0 0 24 24"
            class="w-5 h-5"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </a>

        <!-- Mobile Facebook Button -->
        <button
          type="button"
          id="mobile-facebook-toggle"
          aria-label="Facebook pages"
          aria-expanded="false"
          title="Facebook"
          class="hope-social flex h-10 w-10 items-center justify-center rounded-full md:hidden"
        >
          <span class="text-xl font-bold leading-none">f</span>
        </button>

        <!-- Desktop Facebook Menu -->
        <div class="hidden md:block relative group">
          <button
            type="button"
            aria-label="Facebook pages"
            title="Facebook"
            class="hope-social w-10 h-10 rounded-full flex items-center justify-center"
          >
            <span class="text-xl font-bold leading-none">f</span>
          </button>

          <div
            class="absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-56 rounded-lg border border-sky-600 bg-sky-800 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all z-50 overflow-hidden"
          >
            <a
              href="https://www.facebook.com/profile.php?id=100083818248069"
              target="_blank"
              rel="noopener noreferrer"
              class="block px-4 py-3 text-left text-sm text-sky-100 hover:bg-sky-600 hover:text-white transition-colors"
            >
              Hope House Guthrie
            </a>

            <a
              href="https://www.facebook.com/hopehouseguthrie.org"
              target="_blank"
              rel="noopener noreferrer"
              class="block px-4 py-3 text-left text-sm text-sky-100 hover:bg-sky-600 hover:text-white border-t border-sky-600 transition-colors"
            >
              Neighborhood Hope Dealers, Inc.
            </a>
          </div>
        </div>

        <!-- Instagram -->
        <a
          href="https://www.instagram.com/hopehouseguthrie2020/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Hope House Guthrie on Instagram"
          title="Instagram"
          class="hope-social w-10 h-10 rounded-full flex items-center justify-center"
        >
          <svg
            viewBox="0 0 24 24"
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle
              cx="17.5"
              cy="6.5"
              r="1"
              fill="currentColor"
              stroke="none"></circle>
          </svg>
        </a>

        <!-- X -->
        <a
          href="https://x.com/HopeHouseGuth"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Hope House Guthrie on X"
          title="X"
          class="hope-social w-10 h-10 rounded-full flex items-center justify-center"
        >
          <span class="text-lg font-semibold leading-none">𝕏</span>
        </a>
      </div>

      <!-- Mobile Facebook Choices -->
      <div
        id="mobile-facebook-menu"
        class="hidden md:hidden mt-4 mb-2 w-52 mx-auto rounded-lg border border-sky-600 bg-sky-800 overflow-hidden shadow-sm"
      >
        <a
          href="https://www.facebook.com/profile.php?id=100083818248069"
          target="_blank"
          rel="noopener noreferrer"
          class="block px-4 py-2.5 text-left text-sm text-sky-100 hover:bg-sky-600 hover:text-white transition-colors"
        >
          Hope House Guthrie
        </a>

        <a
          href="https://www.facebook.com/hopehouseguthrie.org"
          target="_blank"
          rel="noopener noreferrer"
          class="block px-4 py-2.5 text-left text-sm text-sky-100 hover:bg-sky-600 hover:text-white border-t border-sky-600 transition-colors"
        >
          Neighborhood Hope Dealers, Inc.
        </a>
      </div>

      <p class="mt-6 md:mt-12 text-xs text-sky-100 leading-relaxed">
        Follow Hope House Guthrie for community updates, upcoming events,
        volunteer opportunities, and stories from Hope House.
      </p>

      <div
        class="mt-5 translate-y-[30px] flex justify-center md:justify-end"
      >
        <!-- Preview: TJ can connect this to real visit totals later. -->
        <div
          class="inline-flex items-center gap-3 rounded-lg border border-sky-400/40 bg-sky-800/60 px-4 py-2 shadow-sm"
        >
          <span class="text-xs font-semibold text-sky-100">
            Site Visits
          </span>

          <span
            class="rounded bg-sky-950/50 px-3 py-1 font-mono text-sm font-bold tracking-widest text-white"
          >
            ———
          </span>

          <span class="text-[10px] text-sky-200"> Coming soon </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 flex flex-col xl:flex-row gap-3 items-center justify-between text-xs text-sky-200"
  >
    <p class="text-center md:text-left">
      &copy; {new Date().getFullYear()} Neighborhood Hope Dealers / Hope House
      Guthrie. All rights reserved. 501(c)(3) Tax-Deductible.
    </p>

    <p class="mt-2 md:mt-0 text-center md:text-right">
      Operated by staff and volunteers under the direction of the Board of
      Directors.
    </p>
  </div>
</footer>

<script>
  const facebookToggle = document.getElementById("mobile-facebook-toggle");
  const facebookMenu = document.getElementById("mobile-facebook-menu");

  facebookToggle?.addEventListener("click", () => {
    const isHidden = facebookMenu?.classList.contains("hidden");
    facebookMenu?.classList.toggle("hidden");
    facebookToggle.setAttribute("aria-expanded", isHidden ? "true" : "false");
  });
</script>
