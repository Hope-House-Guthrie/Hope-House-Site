---
import "@/styles/main.css";
import hhgLogo from "@/assets/logo.svg";
import AnnouncementBar from "./lib/AnnouncementBar.astro";
import Header from "./lib/Header.astro";
import Footer from "./lib/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Hope House Guthrie - Providing shelter, food, clothing, and recovery support in Logan County, OK.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth" data-theme"light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={hhgLogo.src} />
    <meta name="description" content={description} />
    <title>{title} | Hope House Guthrie</title>
  </head>
  <body
    class="bg-slate-50 text-slate-800 antialiased flex flex-col min-h-screen"
  >
    <AnnouncementBar />

    <Header />

    <!-- Page Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />

    <script
      async
      src="https://widgets.givebutter.com/latest.umd.cjs?acct=Qbp6xqDwfEboHdnU&p=other"
    ></script>
  </body>
</html>
