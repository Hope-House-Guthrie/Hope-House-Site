---
import "../styles/main.css";
import hhgLogo from "../assets/logo.svg";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Hope House Guthrie - Providing shelter, food, clothing, and recovery support in Logan County, OK.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={hhgLogo.src} />
    <meta name="description" content={description} />
    <title>{title} | Hope House Guthrie</title>
  </head>
  <body
    class="bg-slate-50 text-slate-800 antialiased flex flex-col min-h-screen"
  >
    <!-- Announcement Bar -->
    <div
      class="bg-sky-700 text-white text-sm font-medium py-1.5 px-4 text-center"
    >
      <span
        >Serving lunch daily 11:00 AM – 1:00 PM at 1916 E Perkins, Guthrie, OK</span
      >
    </div>

    <!-- Main Navigation -->
    <header
      class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 md:py-4">
        <div class="flex items-center justify-between gap-3">
          <a href="/" class="flex items-center gap-2 sm:gap-4 group min-w-0">
            <img
              src={hhgLogo.src}
              alt="Hope House Guthrie Logo"
              class="h-12 sm:h-16 w-auto shrink-0 object-contain transition-transform group-hover:scale-105"
            />

            <div class="min-w-0 flex flex-col justify-center">
              <span
                class="block font-bold text-sm sm:text-lg text-slate-900 leading-tight tracking-tight group-hover:text-sky-700 transition-colors"
              >
                Neighborhood Hope Dealers, Inc.
              </span>

              <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 mt-1">
                <span
                  class="text-[10px] sm:text-xs font-bold text-sky-700 tracking-wider uppercase"
                >
                  Hope House Guthrie
                </span>
                <span
                  class="hidden sm:inline-block w-1 h-1 rounded-full bg-slate-300"
                ></span>
                <span
                  class="hidden sm:inline text-[10px] font-semibold text-slate-500 uppercase tracking-widest"
                >
                  Est. 2020
                </span>
              </div>
            </div>
          </a>

          <!-- Desktop Navigation -->
          <nav
            aria-label="Main navigation"
            class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600"
          >
            <a href="/" class="hover:text-sky-700 transition-colors">Home</a>
            <a href="/about" class="hover:text-sky-700 transition-colors">
              About Us
            </a>
            <a href="/programs" class="hover:text-sky-700 transition-colors">
              Programs & Services
            </a>
            <a href="/contact" class="hover:text-sky-700 transition-colors">
              Contact
            </a>
          </nav>

          <!-- Desktop Quick Actions -->
          <div class="hidden md:flex items-center gap-3 shrink-0">
            <a
              href="/contact#client-inquiry"
              class="inline-flex items-center justify-center bg-sky-700 hover:bg-sky-800 text-white font-semibold text-sm px-4 py-2.5 rounded-lg shadow-sm transition-colors whitespace-nowrap"
            >
              Ask About a Bed
            </a>

            <a
              href="/donate"
              class="inline-flex items-center justify-center bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm px-4 py-2.5 rounded-lg shadow-sm transition-colors whitespace-nowrap"
            >
              Donate Now
            </a>
          </div>

          <!-- Mobile Navigation -->
          <details class="relative shrink-0 md:hidden">
            <summary
              aria-label="Navigation menu"
              class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-100 [&::-webkit-details-marker]:hidden"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </summary>

            <nav
              aria-label="Mobile navigation"
              class="absolute right-0 top-full mt-2 w-60 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-lg"
            >
              <a
                href="/"
                class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-sky-50 hover:text-sky-700"
              >
                Home
              </a>
              <a
                href="/about"
                class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-sky-50 hover:text-sky-700"
              >
                About Us
              </a>
              <a
                href="/programs"
                class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-sky-50 hover:text-sky-700"
              >
                Programs & Services
              </a>
              <a
                href="/contact"
                class="block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-sky-50 hover:text-sky-700"
              >
                Contact
              </a>
            </nav>
          </details>
        </div>

        <!-- Mobile Quick Actions -->
        <div class="mt-3 grid grid-cols-2 gap-3 md:hidden">
          <a
            href="/contact#client-inquiry"
            class="flex items-center justify-center rounded-lg bg-sky-700 px-3 py-3 text-sm font-semibold text-white text-center shadow-sm transition-colors hover:bg-sky-800"
          >
            Ask About a Bed
          </a>

          <a
            href="/donate"
            class="flex items-center justify-center rounded-lg bg-emerald-600 px-3 py-3 text-sm font-semibold text-white text-center shadow-sm transition-colors hover:bg-emerald-700"
          >
            Donate Now
          </a>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-sky-700 text-sky-100 pt-12 pb-8 border-t border-sky-600">
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-[1.7fr_1fr_1fr_1fr] gap-x-12 gap-y-8 pb-12 border-b border-sky-600"
      >
        <!-- Branding -->
        <div>
          <div class="flex items-center gap-2 sm:gap-3 mb-4">
            <img
              src={hhgLogo.src}
              alt="Hope House Guthrie"
              width={hhgLogo.width}
              height={hhgLogo.height}
              loading="lazy"
              class="h-10 sm:h-14 w-auto shrink-0 object-contain"
            />

            <div class="h-10 sm:h-14 min-w-0 flex flex-col justify-center">
              <div
                class="text-white font-bold text-[13px] sm:text-lg leading-tight md:whitespace-nowrap"
              >
                Neighborhood Hope Dealers, Inc.
              </div>

              <div
                class="mt-1 text-[10px] sm:text-xs tracking-wide whitespace-nowrap"
              >
                <span class="font-bold text-white"> HOPE HOUSE GUTHRIE </span>

                <span class="text-sky-300 mx-1">•</span>

                <span class="text-sky-200"> EST. 2020 </span>
              </div>
            </div>
          </div>

          <p class="text-sm text-sky-100 mb-4">
            A division of Neighborhood Hope Dealers (NHD), a 501(c)(3)
            non-profit organization serving Logan County, OK.
          </p>

          <p class="text-xs text-sky-200">
            Proud Partner of United Way of Logan County.
          </p>
        </div>

        <!-- Quick Links -->
        <div>
          <h3
            class="text-white text-sm font-semibold mb-4 uppercase tracking-wider"
          >
            Quick Links
          </h3>

          <ul class="space-y-2 text-sm">
            <li>
              <a href="/about" class="hover:text-white transition-colors">
                Our History & Vision
              </a>
            </li>

            <li>
              <a href="/programs" class="hover:text-white transition-colors">
                Transitional Housing
              </a>
            </li>

            <li>
              <a
                href="/programs#recovery"
                class="hover:text-white transition-colors"
              >
                NA Recovery Meetings
              </a>
            </li>

            <li>
              <a href="/donate" class="hover:text-white transition-colors">
                Join the 300 Club
              </a>
            </li>

            <li>
              <a
                href="/donate#adopt-a-room"
                class="hover:text-white transition-colors"
              >
                Adopt-a-Room
              </a>
            </li>
          </ul>
        </div>

        <!-- Direct Support -->
        <div>
          <h3
            class="text-white text-sm font-semibold mb-4 uppercase tracking-wider"
          >
            Direct Support
          </h3>

          <p class="text-sm text-sky-100 mb-2">
            <strong>Physical Facility:</strong><br />
            1916 E Perkins, Guthrie, OK 73044
          </p>

          <p class="text-sm text-sky-100 mb-2">
            <strong>Mailing Address:</strong><br />
            PO Box 491, Guthrie, OK 73044
          </p>

          <p class="text-sm text-sky-100">
            <strong>Phone:</strong><br />

            <a href="tel:4058569058" class="hover:text-white"> 405-856-9058 </a>

            <span> / </span>

            <a href="tel:4058870288" class="hover:text-white"> 405-887-0288 </a>
          </p>
        </div>

        <!-- Follow Us -->
        <div class="md:ml-6 text-center md:text-left">
          <h3
            class="text-white text-sm font-semibold mb-4 uppercase tracking-wider"
          >
            Follow Us
          </h3>

          <!-- Social Icons -->
          <div class="flex items-center justify-center md:justify-start gap-3">
            <!-- YouTube -->
            <a
              href="https://www.youtube.com/@HopeHouseGuthrie"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Hope House Guthrie on YouTube"
              title="YouTube"
              class="w-10 h-10 rounded-full border border-sky-500 flex items-center justify-center text-sky-100 hover:text-white hover:border-sky-400 hover:bg-sky-600 transition-colors"
            >
              <svg
                viewBox="0 0 24 24"
                class="w-5 h-5"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M8 5v14l11-7z"></path>
              </svg>
            </a>

            <!-- Mobile Facebook Button -->
            <button
              type="button"
              id="mobile-facebook-toggle"
              aria-label="Facebook pages"
              aria-expanded="false"
              title="Facebook"
              class="md:hidden w-10 h-10 rounded-full border border-sky-500 flex items-center justify-center text-sky-100 hover:text-white hover:border-sky-400 hover:bg-sky-600 transition-colors"
            >
              <span class="text-xl font-bold leading-none">f</span>
            </button>

            <!-- Desktop Facebook Menu -->
            <div class="hidden md:block relative group">
              <button
                type="button"
                aria-label="Facebook pages"
                title="Facebook"
                class="w-10 h-10 rounded-full border border-sky-500 flex items-center justify-center text-sky-100 hover:text-white hover:border-sky-400 hover:bg-sky-600 transition-colors"
              >
                <span class="text-xl font-bold leading-none">f</span>
              </button>

              <div
                class="absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-56 rounded-lg border border-sky-600 bg-sky-800 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all z-50 overflow-hidden"
              >
                <a
                  href="https://www.facebook.com/profile.php?id=100083818248069"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block px-4 py-3 text-left text-sm text-sky-100 hover:bg-sky-600 hover:text-white transition-colors"
                >
                  Hope House Guthrie
                </a>

                <a
                  href="https://www.facebook.com/hopehouseguthrie.org"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block px-4 py-3 text-left text-sm text-sky-100 hover:bg-sky-600 hover:text-white border-t border-sky-600 transition-colors"
                >
                  Neighborhood Hope Dealers, Inc.
                </a>
              </div>
            </div>

            <!-- Instagram -->
            <a
              href="https://www.instagram.com/hopehouseguthrie2020/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Hope House Guthrie on Instagram"
              title="Instagram"
              class="w-10 h-10 rounded-full border border-sky-500 flex items-center justify-center text-sky-100 hover:text-white hover:border-sky-400 hover:bg-sky-600 transition-colors"
            >
              <svg
                viewBox="0 0 24 24"
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle
                  cx="17.5"
                  cy="6.5"
                  r="1"
                  fill="currentColor"
                  stroke="none"></circle>
              </svg>
            </a>

            <!-- X -->
            <a
              href="https://x.com/HopeHouseGuth"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Hope House Guthrie on X"
              title="X"
              class="w-10 h-10 rounded-full border border-sky-500 flex items-center justify-center text-sky-100 hover:text-white hover:border-sky-400 hover:bg-sky-600 transition-colors"
            >
              <span class="text-lg font-semibold leading-none">𝕏</span>
            </a>
          </div>

          <!-- Mobile Facebook Choices -->
          <div
            id="mobile-facebook-menu"
            class="hidden md:hidden mt-4 mb-2 w-52 mx-auto rounded-lg border border-sky-600 bg-sky-800 overflow-hidden shadow-sm"
          >
            <a
              href="https://www.facebook.com/profile.php?id=100083818248069"
              target="_blank"
              rel="noopener noreferrer"
              class="block px-4 py-2.5 text-left text-sm text-sky-100 hover:bg-sky-600 hover:text-white transition-colors"
            >
              Hope House Guthrie
            </a>

            <a
              href="https://www.facebook.com/hopehouseguthrie.org"
              target="_blank"
              rel="noopener noreferrer"
              class="block px-4 py-2.5 text-left text-sm text-sky-100 hover:bg-sky-600 hover:text-white border-t border-sky-600 transition-colors"
            >
              Neighborhood Hope Dealers, Inc.
            </a>
          </div>

          <p
            class="mt-6 text-xs text-sky-100 leading-relaxed max-w-56 mx-auto md:mx-0"
          >
            Follow Hope House Guthrie for community updates, upcoming events,
            volunteer opportunities, and stories from Hope House.
          </p>
        </div>
      </div>

      <!-- Footer Bottom -->
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-sky-200"
      >
        <p class="text-center md:text-left">
          &copy; {new Date().getFullYear()} Neighborhood Hope Dealers / Hope House
          Guthrie. All rights reserved. 501(c)(3) Tax-Deductible.
        </p>

        <p class="mt-2 md:mt-0 text-center md:text-right">
          Operated by staff and volunteers under the direction of the Board of
          Directors.
        </p>
      </div>
    </footer>

    <script>
      const facebookToggle = document.getElementById("mobile-facebook-toggle");
      const facebookMenu = document.getElementById("mobile-facebook-menu");

      facebookToggle?.addEventListener("click", () => {
        const isHidden = facebookMenu?.classList.contains("hidden");

        facebookMenu?.classList.toggle("hidden");

        facebookToggle.setAttribute(
          "aria-expanded",
          isHidden ? "true" : "false",
        );
      });
    </script>

    <script
      async
      src="https://widgets.givebutter.com/latest.umd.cjs?acct=Qbp6xqDwfEboHdnU&p=other"
    ></script>
  </body>
</html>
