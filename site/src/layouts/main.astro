---
import '../styles/main.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Hope House Guthrie - Providing shelter, food, clothing, and recovery support in Logan County, OK." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} | Hope House Guthrie</title>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased flex flex-col min-h-screen">
    <!-- Announcement Bar -->
    <div class="bg-amber-600 text-white text-sm font-medium py-2 px-4 text-center">
      <span>Serving hot lunch daily 12:00 PM – 1:00 PM at 1916 E Perkins, Guthrie, OK</span>
    </div>

    <!-- Main Navigation -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 bg-sky-700 text-white flex items-center justify-center font-bold rounded-lg text-xl group-hover:bg-sky-800 transition-colors">
            HH
          </div>
          <div>
            <span class="block font-bold text-lg text-slate-900 leading-tight">HOPE HOUSE</span>
            <span class="block text-xs font-semibold text-sky-700 tracking-wider">GUTHRIE</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-sky-700 transition-colors">Home</a>
          <a href="/about" class="hover:text-sky-700 transition-colors">About Us</a>
          <a href="/programs" class="hover:text-sky-700 transition-colors">Programs & Services</a>
          <a href="/contact" class="hover:text-sky-700 transition-colors">Contact</a>
        </nav>

        <div class="flex items-center gap-4">
          <a href="/donate" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm px-5 py-2.5 rounded-lg shadow-sm transition-all">
            Donate Now
          </a>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-300 pt-12 pb-8 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8 pb-12 border-b border-slate-800">
        <div>
          <div class="flex items-center gap-2 text-white font-bold text-lg mb-3">
            <div class="w-8 h-8 bg-sky-600 text-white flex items-center justify-center rounded text-sm">HH</div>
            Hope House Guthrie
          </div>
          <p class="text-sm text-slate-400 mb-4">
            A division of Neighborhood Hope Dealers (NHD), a 501(c)(3) non-profit organization serving Logan County, OK.
          </p>
          <p class="text-xs text-slate-500">Proud Partner of United Way of Logan County.</p>
        </div>

        <div>
          <h3 class="text-white text-sm font-semibold mb-4 uppercase tracking-wider">Quick Links</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/about" class="hover:text-white transition-colors">Our History & Vision</a></li>
            <li><a href="/programs" class="hover:text-white transition-colors">Transitional Housing</a></li>
            <li><a href="/programs#recovery" class="hover:text-white transition-colors">NA Recovery Meetings</a></li>
            <li><a href="/donate" class="hover:text-white transition-colors">Join the 300 Club</a></li>
            <li><a href="/donate#adopt-a-room" class="hover:text-white transition-colors">Adopt-a-Room</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-white text-sm font-semibold mb-4 uppercase tracking-wider">Direct Support</h3>
          <p class="text-sm text-slate-400 mb-2"><strong>Physical Facility:</strong><br />1916 E Perkins, Guthrie, OK 73044</p>
          <p class="text-sm text-slate-400 mb-2"><strong>Mailing Address:</strong><br />PO Box 491, Guthrie, OK 73044</p>
          <p class="text-sm text-slate-400"><strong>Phone:</strong><br /><a href="tel:4058870288" class="hover:text-white">405-887-0288</a> / <a href="tel:4058569058" class="hover:text-white">405-856-9058</a></p>
        </div>

        <div>
          <h3 class="text-white text-sm font-semibold mb-4 uppercase tracking-wider">Scripture Focus</h3>
          <blockquote class="italic text-xs text-slate-400 border-l-2 border-sky-500 pl-3 py-1">
            "Come to me all who are weary and heavy laden and I will give you rest."
            <footer class="mt-1 text-sky-400 font-semibold not-italic">— Matthew 11:28</footer>
          </blockquote>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500">
        <p>&copy; {new Date().getFullYear()} Neighborhood Hope Dealers / Hope House Guthrie. All rights reserved. 501(c)(3) Tax-Deductible.</p>
        <p class="mt-2 md:mt-0">Volunteer operated under the direction of the Board of Directors.</p>
      </div>
    </footer>
  </body>
</html>